---
// La 404, «Fe de erratas»: la hoja suelta que trae un libro con sus erratas. La primera fila es la tuya: dice la
// dirección que escribiste (se tacha) y debe decir la página buena, que se calcula de verdad en scripts/erratas.js
// (sinónimos, las fichas de proyecto que ya no existen y, si no, la distancia de edición contra las páginas que hay).
// GitHub Pages la sirve como docs/404.html para cualquier dirección que no exista. En la copia de prueba se prueba con
// 404.html?donde=/ruta (su nginx no la sirve sola).
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
import { PROYECTOS } from '../data/proyectos.js';

const base = import.meta.env.BASE_URL;
// Las páginas que existen, sacadas de src/pages al compilar: Brand y About salen solas cuando se junten
const NOMBRES: Record<string, string> = {
  '': 'Página principal', tech: 'Tech', proyectos: 'Proyectos', brand: 'Brand', about: 'About',
  'aviso-legal': 'Aviso legal', privacidad: 'Privacidad', cookies: 'Cookies',
};
const rutas = Object.keys(import.meta.glob('./**/index.astro'))
  .map((f) => f.replace(/^\.\//, '').replace(/index\.astro$/, '').replace(/\/$/, ''))
  .filter((slug) => slug in NOMBRES)
  .sort((a, b) => Object.keys(NOMBRES).indexOf(a) - Object.keys(NOMBRES).indexOf(b))
  .map((slug) => ({ slug, nombre: NOMBRES[slug], href: `${base}${slug ? `${slug}/` : ''}` }));
const proyectos = PROYECTOS.map((p) => ({ slug: p.slug, nombre: p.nombre }));
---
<Base titulo="Fe de erratas · adsPartners®" descripcion="Esta dirección no existe en ads-partners.com. Te decimos cuál es la buena.">
  <main class="err" data-erratas data-base={base} data-rutas={JSON.stringify(rutas)} data-proyectos={JSON.stringify(proyectos)}>
    <div class="err__rejilla" aria-hidden="true"></div>
    <p class="err__donde"><span class="err__barra" aria-hidden="true"></span><span>404 · <span class="err__marca">adsPartners</span></span></p>
    <div class="err__arriba">
      <button class="err__sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
        <span class="err__ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="oculto-accesible" data-sonido-txt>Sonido off</span>
      </button>
      <a class="err__volver" href={base} data-sonido-hover><span aria-hidden="true">◀</span> Página principal</a>
    </div>
    <a class="err__logo" href={base} aria-label="adsPartners, inicio" data-sonido-hover><Marca tipo="logo" /></a>

    <article class="err__hoja" aria-labelledby="err-titulo">
      <p class="err__cab mono"><span>adsPartners® · Legales</span><span>Hoja suelta</span></p>
      <h1 class="err__titulo" id="err-titulo">Fe de erratas</h1>
      <p class="err__intro">En la dirección que has escrito se ha deslizado una errata. Corríjase como sigue:</p>

      <table class="err__tabla">
        <thead>
          <tr><th scope="col">Pág.</th><th scope="col">Lín.</th><th scope="col">Dice</th><th scope="col">Debe decir</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="err__num">404</td>
            <td class="err__num">1</td>
            <td class="err__dice"><s data-err-dice>esta dirección</s><i class="err__tachon" aria-hidden="true" data-err-tachon></i></td>
            <td class="err__debe"><a href={base} data-err-debe data-sonido-hover>/</a></td>
          </tr>
        </tbody>
      </table>
      <p class="err__calculo mono" data-err-calculo aria-live="polite"></p>

      <div class="err__otras">
        <p class="err__otras-tit mono">Las páginas que sí existen</p>
        <ul>
          {rutas.map((r) => <li><a href={r.href} data-sonido-hover>{r.nombre}</a></li>)}
        </ul>
      </div>
      <p class="err__firma">— El editor</p>
    </article>
  </main>

  <script>
    import { arrancarPagina } from '../scripts/pagina.js';
    import { montarErratas } from '../scripts/erratas.js';
    arrancarPagina(montarErratas);
  </script>
</Base>

<style is:global>
  /* Las de global.css, otra vez (la copia de prueba; ver components/legal/Libro.astro) */
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
</style>

<style>
  .err {
    --lado: clamp(18px, 3.8vw, 56px);
    --arriba: clamp(18px, 4.6vh, 44px);
    --tenue: rgba(231, 226, 218, .07);
    --papel: #EDE8DF;
    --tinta-2: rgba(25, 9, 0, .58);
    --tinta-3: rgba(25, 9, 0, .28);
    --raya: rgba(25, 9, 0, .14);
    --rojo: #C8361F;
    position: relative; min-height: 100vh; min-height: 100svh;
    display: grid; place-items: center; padding: calc(var(--arriba) + 64px) var(--lado) calc(var(--arriba) + 72px);
  }
  .err__rejilla {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(15.4% - .5px), var(--tenue) calc(15.4% - .5px), var(--tenue) calc(15.4% + .5px), transparent calc(15.4% + .5px)),
      linear-gradient(90deg, transparent calc(84.6% - .5px), var(--tenue) calc(84.6% - .5px), var(--tenue) calc(84.6% + .5px), transparent calc(84.6% + .5px)),
      linear-gradient(transparent calc(50% - .5px), var(--tenue) calc(50% - .5px), var(--tenue) calc(50% + .5px), transparent calc(50% + .5px));
  }
  .err__donde, .err__volver { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .err__donde { position: absolute; left: var(--lado); top: var(--arriba); z-index: 6; margin: 0; display: flex; align-items: center; gap: 14px; }
  .err__barra { width: 4px; height: 18px; background: var(--rosa); }
  .err__marca { text-transform: none; letter-spacing: .04em; }
  .err__arriba { position: absolute; right: var(--lado); top: var(--arriba); z-index: 6; height: 18px; display: flex; align-items: center; gap: 30px; }
  .err__volver { transition: color .3s; }
  .err__volver:hover { color: var(--crema); }
  .err__logo { position: absolute; left: var(--lado); bottom: calc(var(--arriba) - 4px); z-index: 6; width: 128px; color: var(--crema); }
  .err__sonido { display: block; padding: 6px; margin: -6px -6px -6px 0; }
  .err__ondas { display: flex; align-items: center; gap: 3px; height: 16px; }
  .err__ondas i { width: 2px; height: 3px; background: var(--crema); transition: height .3s var(--curva); }
  :global(html.sonido-on) .err__ondas i { animation: err-onda 1.1s ease-in-out infinite; }
  :global(html.sonido-on) .err__ondas i:nth-child(2) { animation-delay: -.3s; }
  :global(html.sonido-on) .err__ondas i:nth-child(3) { animation-delay: -.7s; }
  :global(html.sonido-on) .err__ondas i:nth-child(4) { animation-delay: -.5s; }
  @keyframes err-onda { 0%, 100% { height: 3px; } 50% { height: 15px; } }

  /* La hoja: papel suelto, un poco torcido, como cae de entre las páginas */
  .err__hoja {
    position: relative; z-index: 2; width: min(600px, 100%); padding: clamp(26px, 5vw, 48px) clamp(22px, 5vw, 50px) clamp(24px, 4vw, 38px);
    background: var(--papel); color: var(--tinta); transform: rotate(-1.4deg);
    box-shadow: 0 34px 60px rgba(0, 0, 0, .5), 0 4px 10px rgba(0, 0, 0, .3);
  }
  .err__hoja::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .35;
    background: linear-gradient(115deg, transparent 40%, rgba(25, 9, 0, .05) 41%, transparent 60%);
  }
  .err__hoja :focus-visible { outline-color: var(--tinta); }
  .err__hoja ::selection { background: var(--tinta); color: var(--papel); }
  .err__cab { display: flex; justify-content: space-between; margin: 0 0 26px; font-size: 9px; color: var(--tinta-2); }
  .err__titulo { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(44px, 8vw, 74px); line-height: .95; letter-spacing: -.02em; }
  .err__intro { margin: 18px 0 0; max-width: 30em; font-family: var(--serif); font-style: italic; font-size: clamp(17px, 2.1vw, 20px); line-height: 1.35; color: var(--tinta); }

  .err__tabla { width: 100%; margin: 28px 0 0; border-collapse: collapse; text-align: left; table-layout: fixed; }
  .err__tabla th { padding: 0 10px 8px 0; font-family: var(--mono); font-weight: 400; font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--tinta-2); border-bottom: 1px solid var(--tinta); }
  .err__tabla th:nth-child(1), .err__tabla th:nth-child(2) { width: 13%; }
  .err__tabla td { padding: 14px 10px 14px 0; vertical-align: baseline; border-bottom: 1px solid var(--raya); }
  .err__num { font-family: var(--serif); font-size: 19px; font-variant-numeric: oldstyle-nums; }
  .err__dice { position: relative; font-family: var(--mono); font-size: 13px; color: var(--tinta-2); word-break: break-all; }
  .err__dice s { text-decoration: none; }
  :global(html:not(.js)) .err__dice s { text-decoration: line-through; text-decoration-color: var(--rojo); }
  /* El tachón, en píxeles rojos que se pintan de izquierda a derecha y luego se glitchean (como el visto de la carta) */
  .err__tachon {
    position: absolute; left: 0; top: calc(50% - 1px); height: 3px; width: var(--tachon, 0%); max-width: calc(100% - 10px);
    background: repeating-linear-gradient(90deg, var(--rojo) 0 3px, transparent 3px 4px); pointer-events: none;
  }
  .err__dice.es-tachada s { text-decoration: none; }
  .err__dice.es-tachada .err__tachon { animation: err-glitch 3.6s steps(1, end) 1s infinite; }
  @keyframes err-glitch {
    0%, 86% { transform: none; box-shadow: none; }
    87% { transform: translate(2px, -1px); box-shadow: -3px 0 0 rgba(64, 196, 255, .7); }
    88% { transform: translate(-1px, 1px); }
    89%, 93% { transform: none; box-shadow: none; }
    94% { transform: translate(1px, 0) skewX(-12deg); box-shadow: 3px 0 0 rgba(64, 196, 255, .7); }
    95%, 100% { transform: none; box-shadow: none; }
  }
  :global(html.mov-reducido) .err__tachon { animation: none !important; }
  .err__debe { font-family: var(--serif); font-style: italic; font-size: clamp(20px, 2.6vw, 26px); line-height: 1.15; }
  .err__debe a { border-bottom: 1px solid var(--tinta); transition: background .25s, color .25s; }
  .err__debe a:hover { background: var(--tinta); color: var(--papel); }
  .err__debe a.es-escribiendo::after { content: '▌'; font-style: normal; font-family: var(--mono); font-size: .6em; vertical-align: .2em; animation: err-cursor .8s steps(1) infinite; }
  @keyframes err-cursor { 50% { opacity: 0; } }
  .err__calculo { min-height: 1.4em; margin: 12px 0 0; font-size: 9.5px; color: var(--tinta-2); }
  .err__calculo :global(.insp) { margin-right: 10px; }

  .err__otras { margin-top: 34px; }
  .err__otras-tit { margin: 0 0 10px; font-size: 9px; color: var(--tinta-2); }
  .err__otras ul { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; font-family: var(--serif); font-size: 17px; }
  .err__otras a { border-bottom: 1px solid var(--tinta-3); }
  .err__otras a:hover { border-bottom-color: var(--tinta); }
  .err__firma { margin: 30px 0 0; text-align: right; font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--tinta-2); }

  @media (max-width: 760px) {
    .err__donde { display: none; }
    .err__logo { top: var(--arriba); bottom: auto; width: 112px; }
    .err__arriba { gap: 18px; }
    .err__hoja { transform: rotate(-.8deg); }
    .err__tabla th:nth-child(1), .err__tabla th:nth-child(2) { width: 15%; }
  }
</style>
