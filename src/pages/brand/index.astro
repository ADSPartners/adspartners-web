---
// Brand, «Desmontada» (02-nov; la B del prototipo de tres direcciones, la que eligió Álvaro). La marca de adsPartners
// despiezada en seis planchas: arriba, el ads terminado; al bajar, la pila se pone en vista técnica, se abre y se
// recorre capa a capa (la marca, la forma, el color, la letra, la voz y, debajo de todo, la idea). Cada capa es un
// capítulo: su plancha crece y, al lado, qué es, qué efecto tiene en una empresa y un dato con su fuente; y tiene su
// juego. Al final se vuelve a montar. El ratón la ladea con un muelle, levanta la plancha que tienes debajo y deja coger
// la pila y girarla (scripts/brand.js). CSS 3D, sin WebGL. Debajo, lo que hace una marca bien hecha y el cierre.
import Base from '../../layouts/Base.astro';
import Cursor from '../../components/Cursor.astro';
import Marca from '../../components/Marca.astro';
import { PORTADA, CAPAS, IDEA, PALETA, LETRAS, TITULAR_LETRA, EFECTOS, CIERRE } from '../../data/brand.js';
import { SERVICIO_BRAND } from '../../data/schema.js';

const base = import.meta.env.BASE_URL;
const cursiva = (s: string) => s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
---
<Base
  titulo="Branding e identidad de marca en Madrid · adsPartners®"
  descripcion="Identidad de marca de arriba abajo: logotipo, color, letra y voz, escritos en reglas y aplicados en tu web y tu contenido. Una marca no es un logo."
  miga="Brand"
  pagina={{ about: { '@id': SERVICIO_BRAND['@id'] } }}
  schema={[SERVICIO_BRAND]}
>
  <!-- Fijo, como en Tech: dónde estás y, a la derecha, la hora de aquí, el sonido y la vuelta -->
  <p class="bd-donde"><span class="bd-barra" aria-hidden="true"></span><span>Brand · <span class="bd-marca">adsPartners</span></span></p>
  <div class="bd-arriba">
    <p class="bd-madrid" aria-hidden="true">Desde Madrid <span class="bd-hora" data-bd-hora></span></p>
    <button class="bd-sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
      <span class="bd-ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="oculto-accesible" data-sonido-txt>Sonido off</span>
    </button>
    <a class="bd-volver" href={base} data-sonido-hover><span aria-hidden="true">◀</span> Página principal</a>
  </div>

  <main class="bd" data-brand data-cursor="manual">
    <h1 class="oculto-accesible">Brand: branding, identidad de marca, logotipo y webs con una idea propia</h1>

    <!-- El viaje: la escena se queda fija mientras bajas y lo bajado la despieza -->
    <section class="bd-viaje" data-viaje aria-label="La marca de adsPartners, desmontada">
      <div class="bd-escena" data-escena>
        <div class="bd-texto" data-texto>
          <p class="bd-etq">( {PORTADA.etiqueta} )</p>
          <h2 class="bd-t" data-vivo data-titulo set:html={cursiva(PORTADA.titulo)} />
          <p class="bd-p">{PORTADA.texto}</p>
        </div>

        <div class="bd-pila" data-pila aria-hidden="true">
          <div class="bd-giro" data-giro>
            <div class="bd-capa bd-capa--marca" data-capa="0">
              <div class="bd-capa__brillo"></div>
              <div class="bd-capa__dentro">
                <div class="bd-marca__iso"><Marca tipo="iso" /></div>
                <div class="bd-marca__logo"><Marca tipo="logo" /></div>
              </div>
            </div>
            <div class="bd-capa" data-capa="1">
              <div class="bd-capa__dentro">
                <div class="bd-forma" data-forma>
                  <span class="bd-forma__aire" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                  <span class="bd-forma__fantasma"><Marca tipo="iso" /></span>
                  <span class="bd-forma__iso" data-forma-iso><Marca tipo="iso" /></span>
                </div>
                <span class="bd-forma__nota bd-forma__nota--aire">Área de respeto · x</span>
                <span class="bd-forma__nota bd-forma__nota--min">Mínimo · 24 px</span>
                <span class="bd-forma__cota" data-forma-cota></span>
              </div>
            </div>
            <div class="bd-capa" data-capa="2">
              <div class="bd-colores">
                {PALETA.map((c, i) => (
                  <button class="bd-color" type="button" data-color={i} tabindex="-1" style={`background:${c.hex};color:${c.oscuro ? '#E7E2DA' : '#190900'}`}><span>{c.nombre}</span></button>
                ))}
              </div>
            </div>
            <div class="bd-capa" data-capa="3">
              <div class="bd-capa__dentro bd-letra">
                <p class="bd-letra__t" data-letra-t>{TITULAR_LETRA}</p>
                <p class="bd-letra__escala"><span>Titular · 300</span><span>Texto · 400</span><span>Detalle</span></p>
                <div class="bd-letra__chips">
                  {LETRAS.map((l, i) => (
                    <button type="button" data-letra={i} tabindex="-1" style={`font-family:${l.familia};font-weight:${l.peso}`}>Aa<span>{l.papel}</span></button>
                  ))}
                </div>
              </div>
            </div>
            <div class="bd-capa" data-capa="4">
              <div class="bd-capa__dentro bd-vozcapa" data-voz-capa>
                <p class="bd-voz__etq">Así no · así sí</p>
                <p class="bd-voz" data-voz></p>
                <p class="bd-voz__no" data-voz-no></p>
              </div>
            </div>
            <div class="bd-capa bd-capa--idea" data-capa="5">
              <div class="bd-capa__dentro bd-idea" data-idea>
                {IDEA.map(([que, dice]) => <p class="bd-idea__linea"><span>{que}</span>{dice}</p>)}
              </div>
            </div>
          </div>
        </div>

        <!-- Las cotas de la vista técnica, a la derecha de cada plancha -->
        <div class="bd-cotas" aria-hidden="true">
          <svg>{CAPAS.map(() => <line />)}</svg>
          {CAPAS.map((c) => <span class="bd-cota"><b>{c.n}</b><span>{c.nombre} · {c.cota}</span></span>)}
        </div>

        <!-- El capítulo de la capa que toca: qué es, qué efecto tiene, el dato con su fuente y su juego -->
        <article class="bd-cap" data-cap aria-live="polite">
          <p class="bd-cap__n" data-cap-n></p>
          <h3 class="bd-cap__t" data-cap-t></h3>
          <p class="bd-cap__que" data-cap-que></p>
          <p class="bd-cap__importa" data-cap-importa></p>
          <div class="bd-cap__dato">
            <p class="bd-cap__cifra" data-cap-cifra></p>
            <div><p class="bd-cap__dice" data-cap-dice></p><p class="bd-cap__fuente" data-cap-fuente></p></div>
          </div>
          <p class="bd-cap__juego" data-cap-juego></p>
        </article>
        <p class="bd-pista" data-pista><span>{PORTADA.pista}</span><i aria-hidden="true"></i></p>
      </div>
    </section>

    <!-- Lo que hace una marca bien hecha: tres efectos medidos, cada uno con su fuente y su pega -->
    <section class="bd-efectos" data-efectos aria-labelledby="bd-efectos-t">
      <p class="bd-efectos__ante">{EFECTOS.antetitulo}</p>
      <h2 class="bd-efectos__t" id="bd-efectos-t" data-vivo set:html={cursiva(EFECTOS.titulo)} />
      <ol class="bd-efectos__lista">
        {EFECTOS.lista.map((e, i) => (
          <li class="bd-efecto" style={`--i: ${i}`}>
            <p class="bd-efecto__cifra"><b data-cuenta={e.cuenta} data-antes={e.menos ? '−' : e.cifra.startsWith('+') ? '+' : ''} data-sufijo={e.sufijo}>{e.cifra}</b>{e.unidad && <span>{e.unidad}</span>}</p>
            <h3 class="bd-efecto__t">{e.titulo}</h3>
            <p class="bd-efecto__texto">{e.texto}</p>
            <p class="bd-efecto__fuente">{e.fuente}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Lo que hacemos con la tuya -->
    <section class="bd-cierre" id="la-tuya" data-cierre aria-labelledby="bd-cierre-t">
      <div>
        <p class="bd-cierre__ante">{CIERRE.antetitulo}</p>
        <h2 class="bd-cierre__t" id="bd-cierre-t" data-vivo set:html={cursiva(CIERRE.titulo)} />
      </div>
      <div class="bd-cierre__dcha">
        <p class="bd-cierre__p">{CIERRE.texto}</p>
        <ul class="bd-cierre__servicios">{CIERRE.servicios.map((s) => <li>{s}</li>)}</ul>
        <a class="bd-cierre__carta" href={`${base}#contacto`} data-sonido-hover><span class="bd-subraya">{CIERRE.carta}</span> <span aria-hidden="true">▶</span></a>
      </div>
    </section>
  </main>
  <Cursor />
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarBrand } from '../../scripts/brand.js';
    arrancarPagina(montarBrand);
  </script>
</Base>

<style is:global>
  @font-face { font-family: 'Quetine'; src: url('/assets/fonts/Quetine.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  /* (otra vez las de global.css: en la copia de prueba Astro mete ese CSS sin la carpeta y salen en Georgia) */
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }

  /* El cursor, sin el logotipo dentro (a Álvaro le distrae): solo el aro y, sobre cada plancha, qué se puede hacer */
  html:has(main.bd) .cursor__iso { display: none; }
  .bd { --lado: clamp(18px, 2.4vw, 36px); --arriba: clamp(18px, 2.6vh, 30px); --rosa-2: rgba(245, 203, 215, .38); color: var(--crema); }

  /* --- Fijo ---------------------------------------------------------------------------------------------------- */
  .bd-donde, .bd-madrid, .bd-volver { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .bd-donde { position: fixed; left: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; margin: 0; display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .bd-barra { width: 4px; height: 18px; background: var(--rosa); }
  .bd-marca { text-transform: none; letter-spacing: .04em; }
  .bd-arriba { position: fixed; right: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; height: 18px; display: flex; align-items: center; gap: 30px; }
  .bd-madrid { margin: 0; pointer-events: none; }
  .bd-hora { margin-left: 6px; opacity: .58; font-variant-numeric: tabular-nums; }
  .bd-volver { transition: color .3s; }
  .bd-volver:hover { color: var(--crema); }
  .bd-sonido { display: block; padding: 6px; margin: -6px -6px -6px 0; }
  .bd-ondas { display: flex; align-items: center; gap: 3px; height: 16px; }
  .bd-ondas i { width: 2px; height: 3px; background: var(--crema); transition: height .3s var(--curva); }
  html.sonido-on .bd-ondas i { animation: bd-onda 1.1s ease-in-out infinite; }
  html.sonido-on .bd-ondas i:nth-child(2) { animation-delay: -.3s; }
  html.sonido-on .bd-ondas i:nth-child(3) { animation-delay: -.7s; }
  html.sonido-on .bd-ondas i:nth-child(4) { animation-delay: -.5s; }
  @keyframes bd-onda { 0%, 100% { height: 3px; } 50% { height: 15px; } }

  /* --- El viaje ---------------------------------------------------------------------------------------------------- */
  /* Largo: cada una de las seis capas tiene pantalla y media para ella */
  .bd-viaje { position: relative; height: 1300vh; }
  .bd-escena { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; user-select: none; -webkit-user-select: none; }
  .bd-texto { position: absolute; left: var(--lado); top: 15vh; z-index: 3; max-width: 36vw; pointer-events: none; transition: opacity .5s var(--curva), transform .5s var(--curva); }
  /* Mientras hay un capítulo, la portada se aparta y la pila se va un poco a la derecha */
  .bd-texto.fuera { opacity: 0; transform: translateY(-14px); }
  .bd-etq { margin: 0 0 3vh; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .bd-t { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(44px, 5vw, 92px); line-height: .94; letter-spacing: -.02em; }
  .bd-t em, .bd-cierre__t em { font-style: italic; }
  .bd-p { margin: 3vh 0 0; max-width: 34ch; font-size: 15px; line-height: 1.6; color: var(--crema-2); }

  /* La pila: el contenedor con perspectiva, el que gira y las planchas */
  .bd-pila { position: absolute; left: 58%; top: 56%; width: 0; height: 0; perspective: 1800px; transition: left .9s var(--curva), top .9s var(--curva); }
  .bd-escena.en-capitulo .bd-pila { left: 63%; }
  .bd-giro { position: absolute; left: 0; top: 0; transform-style: preserve-3d; }
  .bd-capa {
    --w: min(38vw, 58vh); --h: calc(var(--w) * .62);
    position: absolute; left: calc(var(--w) / -2); top: calc(var(--h) / -2); width: var(--w); height: var(--h);
    border: 1px solid var(--rosa-2); background: rgba(18, 13, 10, .88); overflow: hidden;
    transition: opacity .5s var(--curva), border-color .5s var(--curva), background-color .6s var(--curva);
  }
  /* Mientras otra capa tiene su turno: casi apagada y sin coger el ratón (si no, tapa el juego de la de debajo) */
  .bd-capa.apagada { opacity: .16; pointer-events: none; }
  .bd-capa.activa, .bd-capa.encima { border-color: var(--rosa); }
  .bd-capa__dentro { position: absolute; inset: 9%; display: flex; align-items: center; justify-content: center; }

  /* 01 · La marca: el isotipo y el logotipo; toma el color que pases en la de color. Un brillo sigue al ratón */
  .bd-capa--marca { --iso: #F5CBD7; --logo: #E7E2DA; background: #120D0A; }
  .bd-capa--marca .bd-capa__dentro { flex-direction: column; gap: 7%; }
  .bd-marca__iso { width: 58%; color: var(--iso); transition: color .5s var(--curva); }
  .bd-marca__logo { width: 34%; color: var(--logo); transition: color .5s var(--curva); }
  .bd-marca__iso svg, .bd-marca__logo svg, .bd-forma svg { display: block; width: 100%; height: auto; }
  .bd-capa__brillo { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at var(--bx, 30%) var(--by, 20%), rgba(255, 240, 245, .14), transparent 45%); }

  /* 02 · Forma: el isotipo en línea, su sombra de la proporción buena y lo que se ha estirado */
  .bd-forma { position: relative; width: 70%; color: var(--rosa); }
  .bd-forma svg path { fill: none; stroke: currentColor; stroke-width: 5; }
  .bd-forma__fantasma { position: absolute; inset: 0; opacity: .3; }
  .bd-forma__fantasma svg path { stroke-dasharray: 18 14; }
  .bd-forma__iso { display: block; transform-origin: 0 50%; }
  .bd-forma::before, .bd-forma::after { content: ''; position: absolute; left: -9%; right: -9%; border-top: 1px dashed var(--rosa-2); }
  .bd-forma::before { top: 0; } .bd-forma::after { bottom: 0; }
  .bd-forma__cota { position: absolute; right: 0; bottom: -2%; font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--rosa); opacity: 0; transition: opacity .3s; }
  .bd-forma__cota.on { opacity: 1; }
  /* el área de respeto (el aire que lleva siempre alrededor), con sus esquinas, y el tamaño mínimo */
  .bd-forma__aire { position: absolute; inset: -16% -9%; border: 1px dashed var(--rosa-2); }
  .bd-forma__aire i { position: absolute; width: 9px; height: 9px; border-color: var(--rosa); border-style: solid; border-width: 0; }
  .bd-forma__aire i:nth-child(1) { left: -1px; top: -1px; border-left-width: 1px; border-top-width: 1px; }
  .bd-forma__aire i:nth-child(2) { right: -1px; top: -1px; border-right-width: 1px; border-top-width: 1px; }
  .bd-forma__aire i:nth-child(3) { left: -1px; bottom: -1px; border-left-width: 1px; border-bottom-width: 1px; }
  .bd-forma__aire i:nth-child(4) { right: -1px; bottom: -1px; border-right-width: 1px; border-bottom-width: 1px; }
  .bd-forma__nota { position: absolute; font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-2); }
  .bd-forma__nota--aire { left: 0; top: -2%; }
  .bd-forma__nota--min { left: 0; bottom: -2%; }

  /* 03 · Color: cinco franjas que se pueden tocar */
  .bd-colores { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
  .bd-color { position: relative; display: flex; align-items: flex-end; padding: 10px; font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; transition: flex-grow .4s, transform .4s var(--curva); }
  .bd-color span { transition: transform .4s var(--curva); }
  .bd-color.tocado span { transform: translateY(-6px); }
  .bd-colores.con-uno .bd-color:not(.tocado) { filter: saturate(.7) brightness(.8); }

  /* 04 · Letra: el titular y las tres letras para ponérselas */
  .bd-letra { flex-direction: column; justify-content: space-between; inset: 10% 9% 9%; }
  .bd-letra__t { margin: 0; font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .1); line-height: 1; transition: opacity .2s; }
  .bd-letra__escala { margin: 0; width: 100%; display: flex; gap: 18px; font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-3); }
  .bd-letra__chips { display: flex; gap: 10px; width: 100%; }
  .bd-letra__chips button { flex: 1; display: grid; justify-items: start; gap: 6px; padding: 10px 12px; border: 1px solid var(--rosa-2); font-size: calc(var(--w) * .07); line-height: 1; text-align: left; transition: border-color .3s, background-color .3s; }
  .bd-letra__chips button span { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-2); }
  .bd-letra__chips button.tocado { border-color: var(--rosa); background: rgba(245, 203, 215, .08); }

  /* 05 · Voz: una frase de agencia que se corrige */
  .bd-vozcapa { flex-direction: column; gap: 14px; }
  .bd-voz { margin: 0; font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .066); line-height: 1.12; text-align: center; }
  .bd-voz s { color: var(--crema-3); text-decoration-thickness: 1px; }
  .bd-voz b { font-weight: 300; font-style: italic; color: var(--rosa); }
  .bd-voz__no { margin: 0; min-height: 3em; max-width: 34ch; font-family: var(--mono); font-size: 9px; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase; text-align: center; color: var(--crema-2); }
  .bd-voz__etq { margin: 0; font-family: var(--mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--rosa); }

  /* 06 · Idea: las tres frases que lo sostienen todo */
  .bd-capa--idea { background: rgba(28, 19, 15, .92); }
  .bd-idea { flex-direction: column; align-items: stretch; justify-content: center; gap: 8%; }
  .bd-idea__linea { margin: 0; display: grid; grid-template-columns: 26% 1fr; align-items: baseline; gap: 4%; padding-top: 3%; border-top: 1px solid var(--rosa-2); font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .046); line-height: 1.1; }
  .bd-idea__linea span { font-family: var(--mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--rosa); }

  /* Las cotas */
  .bd-cotas { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .bd-cotas svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bd-cotas line { stroke: rgba(245, 203, 215, .55); stroke-width: 1; stroke-dasharray: 3 3; transition: opacity .4s; }
  .bd-cota { position: absolute; left: 0; top: 0; font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; color: var(--crema-2); transition: color .4s, opacity .4s; }
  .bd-cota b { font-weight: 400; color: var(--rosa); margin-right: 8px; }
  .bd-cota.activa { color: var(--crema); }

  /* El capítulo de la capa que toca: entra al cambiar de capa (brand.js le quita y le pone .on) */
  .bd-cap { position: absolute; left: var(--lado); top: 12vh; bottom: 9vh; z-index: 3; width: min(34vw, 530px); display: flex; flex-direction: column; justify-content: center; pointer-events: none;
    opacity: 0; transform: translateY(16px); transition: opacity .45s var(--curva), transform .45s var(--curva); }
  .bd-cap.on { opacity: 1; transform: none; transition-duration: .8s; }
  .bd-cap p, .bd-cap h3 { margin: 0; }
  .bd-cap__n { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--rosa); }
  .bd-cap__t { margin-top: 2.2vh !important; font-family: var(--serif); font-weight: 300; font-size: clamp(34px, 3.3vw, 60px); line-height: .98; letter-spacing: -.02em; }
  .bd-cap__t em { font-style: italic; }
  .bd-cap__que { margin-top: 2.8vh !important; font-size: 15px; line-height: 1.6; }
