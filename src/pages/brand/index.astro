---
// Brand, «El manual vivo» (segunda ronda, 30-oct; la primera era el manual en PDF y a Álvaro no le gustó ni el aire de
// PDF ni la portada). La marca de adsPartners entera, en una mesa de trabajo: el logo, la paleta, la letra, la voz, un
// post y una web. Todo se puede romper; al soltar, se abre por debajo el código que la pinta, la regla entra como
// comentario y el código reescribe lo roto delante de ti. Brand por fuera, tech por dentro. Lo mueve scripts/brand.js;
// aquí está lo que se ve sin él.
import Base from '../../layouts/Base.astro';
import Cursor from '../../components/Cursor.astro';
import Marca from '../../components/Marca.astro';
import Pieza from '../../components/brand/Pieza.astro';
import logoRaw from '../../../public/assets/logos/logotipo_marron.svg?raw';
import { nodos, nodosComoTrazo } from '../../scripts/brand/trazado.js';
import { MESA, PALETA, LETRAS, LOGO, REGLAS, POST, WEB, CODIGO, CIERRE, remate } from '../../data/brand.js';

const base = import.meta.env.BASE_URL;
// El logotipo oficial, trazado a trazado, y sus nodos (se sacan aquí, al compilar)
const viewBox = logoRaw.match(/viewBox="([^"]+)"/)[1];
const trazos = [...logoRaw.matchAll(/\sd="([^"]+)"/g)].map((m) => m[1]);
const puntos = trazos.flatMap(nodos);
const proporcion = LOGO.proporcion.toFixed(2).replace('.', ',');
const trazo = trazos[0].slice(0, 20).trim();
---
<Base
  titulo="Brand · adsPartners®"
  descripcion="La marca de adsPartners, entera y a la vista. Intenta romperla: está escrita en código y se arregla sola. Así trabajamos la identidad, las webs, la dirección de arte y el contenido de tu marca."
>
  <!-- Arriba, fija: el logotipo, el sonido, la hora y la vuelta a la página principal -->
  <div class="bm-barra">
    <a class="bm-barra__logo" href={base} aria-label="adsPartners, inicio" data-sonido-hover><Marca tipo="logo" /></a>
    <button class="bm-barra__sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover><span data-sonido-txt>Sonido off</span> —</button>
    <p class="bm-barra__donde" aria-hidden="true"><span>Desde Madrid</span><span class="bm-barra__hora" data-bm-hora></span></p>
    <a class="bm-barra__volver" href={base} data-sonido-hover><span class="bm-flecha" aria-hidden="true">◀</span> <span class="bm-subraya">Página principal</span></a>
  </div>

  <main class="bm" data-brand data-cursor="manual">
    <h1 class="oculto-accesible">Brand: la marca de adsPartners, entera</h1>

    <!-- La mesa de trabajo: toda la marca a la vista, y todo se rompe -->
    <section class="mesa" data-mesa aria-labelledby="mesa-t">
      <header class="mesa__cab" data-mesa-pieza data-mesa-revela data-prof="0.4">
        <p class="mesa__ante">Brand · <span class="bm-nombre">adsPartners</span></p>
        <h2 class="mesa__t titular" id="mesa-t" data-vivo>{MESA.titulo}</h2>
        <p class="mesa__intro">{MESA.intro}</p>
      </header>

      <Pieza id="paleta" nombre="paleta.css" meta="5 colores" codigo={CODIGO.paleta()} prof={0.8} cursor="Arrástralo">
        <ul class="paleta" aria-label="Paleta de colores">
          {PALETA.map((c) => (
            <li class={`paleta__m${c.claro ? ' paleta__m--claro' : ''}`} data-color={c.id} data-hex-bueno={c.hex} style={`--c: var(--${c.id})`}>
              <span class="paleta__n">{c.nombre}</span>
              <span class="paleta__hex" data-hex>{c.hex}</span>
            </li>
          ))}
        </ul>
        <span class="insp paleta__etq" data-paleta-etq aria-hidden="true"></span>
      </Pieza>

      <Pieza id="logo" nombre="logotipo.svg" meta={`${proporcion} : 1`} codigo={CODIGO.logo({ trazo, trazados: trazos.length, nodos: puntos.length })} prof={1.1} cursor="Estíralo">
        <div class="bl" data-bl data-trazados={trazos.length} data-nodos={puntos.length}>
          <!-- El plano: guías solo en algunas esquinas y la cota con su medida -->
          <div class="bl__plano" aria-hidden="true">
            <i class="bl__guia bl__guia--h bl__guia--arriba"></i>
            <i class="bl__guia bl__guia--h bl__guia--abajo"></i>
            <i class="bl__guia bl__guia--v bl__guia--izq"></i>
            <span class="bl__cota mono"><span data-bl-cota>—</span></span>
          </div>
          <svg class="bl__svg" viewBox={viewBox} role="img" aria-label="adsPartners" data-bl-svg>
            <g data-bl-g>
              <g class="bl__relleno">{trazos.map((d) => <path d={d} />)}</g>
              <g class="bl__contorno">{trazos.map((d) => <path d={d} />)}</g>
              <path class="bl__nodos" d={nodosComoTrazo(puntos)} />
            </g>
          </svg>
          <span class="bl__asa" data-bl-asa="ne" aria-hidden="true"></span>
          <span class="bl__asa" data-bl-asa="so" aria-hidden="true"></span>
          <span class="bl__asa bl__asa--giro" data-bl-asa="giro" aria-hidden="true"></span>
          <i class="bl__brazo" data-bl-brazo aria-hidden="true"></i>
          <span class="insp bl__etq" data-bl-etq aria-hidden="true"></span>
        </div>
      </Pieza>

      <Pieza id="letra" nombre="letra.css" meta="3 familias" codigo={CODIGO.letra()} prof={0.7}>
        <div class="letra">
          <ul class="letra__familias">
            {LETRAS.map((l) => (
              <li><span class={`letra__aa ${l.clase}`}>Aa</span><span class="letra__n">{l.nombre}</span><span class="letra__p">{l.papel}</span></li>
            ))}
          </ul>
          <p class="letra__tent"><span class="letra__tent-t">Ponle otra:</span><span class="letra__chips" data-letra-chips></span></p>
        </div>
      </Pieza>

      <Pieza id="voz" nombre="voz.txt" meta="0 palabras fuera" codigo={CODIGO.voz()} prof={0.9}>
        <label class="voz">
          <span class="voz__t">Escribe como una agencia:</span>
          <span class="voz__campo">
            <span class="voz__espejo titular" data-voz-espejo aria-hidden="true"></span>
            <textarea class="voz__area titular" data-voz-area rows="2" maxlength="90" spellcheck="false" autocomplete="off" autocapitalize="sentences" placeholder="Soluciones integrales con sinergias…"></textarea>
          </span>
        </label>
      </Pieza>

      <Pieza id="post" nombre="post.png" meta="1080 × 1080" codigo={CODIGO.post()} prof={1.25}>
        <div class="post">
          <span class="post__iso"><Marca tipo="iso" /></span>
          <span class="post__firma"><span class="bm-nombre">adsPartners</span>®</span>
          <p class="post__claim titular">{POST.claim}</p>
        </div>
      </Pieza>

      <Pieza id="web" nombre="web/index.html" meta={WEB.dominio} codigo={CODIGO.web()} prof={1}>
        <div class="miniweb">
          <p class="miniweb__url"><i></i>{WEB.dominio}</p>
          <p class="miniweb__nav"><span class="miniweb__logo"><Marca tipo="logo" /></span><span class="miniweb__links">Brand · Tech · Trabajo</span></p>
          <p class="miniweb__t titular">{WEB.claim}</p>
          <span class="miniweb__boton">{WEB.boton} <span aria-hidden="true">▶</span></span>
          <span class="miniweb__iso"><Marca tipo="iso" /></span>
        </div>
      </Pieza>

      <!-- La barra de estado: lo que llevas intentado, lo conseguido (que no se mueve) y las reglas, en vivo -->
      <p class="mesa__estado" data-mesa-pieza data-mesa-revela data-estado>
        <span>Intentos <b data-intentos>00</b></span>
        <span>Conseguidos <b>00</b></span>
        <span>Reglas en su sitio <b data-reglas>{REGLAS.length}/{REGLAS.length}</b></span>
        <span class="mesa__pista" data-pista>{MESA.pista}</span>
      </p>
      <div class="mesa__insp" data-mesa-insp aria-hidden="true"></div>
    </section>

    <!-- Lo que hacemos con la tuya -->
    <section class="bm-cierre" id="la-tuya" aria-labelledby="bm-cierre-t">
      <div class="bm-cierre__izq">
        <p class="bm-cierre__ante">{CIERRE.antetitulo}</p>
        <h2 class="bm-cierre__t titular" id="bm-cierre-t" data-vivo>{CIERRE.titulo}</h2>
        <p class="bm-cierre__remate" data-bm-remate>{remate(0)}</p>
      </div>
      <div class="bm-cierre__dcha">
        <div class="bm-cierre__texto">
          {CIERRE.texto.map((p) => <p>{p}</p>)}
        </div>
        <ul class="bm-cierre__servicios">
          {CIERRE.servicios.map((s) => <li>{s}</li>)}
        </ul>
        <p class="bm-cierre__quien">{CIERRE.quien}</p>
        <a class="bm-cierre__carta" href={`${base}#contacto`} data-sonido-hover><span class="bm-subraya">Cuéntanos la tuya</span> <span class="bm-flecha" aria-hidden="true">▶</span></a>
      </div>
    </section>
  </main>
  <Cursor />
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarBrand } from '../../scripts/brand.js';
    arrancarPagina(montarBrand);
  </script>
</Base>

<style is:global>
  /* Las letras de la marca que la home no usa: Open Sauce en negrita y Quetine (la de detalle) */
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Quetine'; src: url('/assets/fonts/Quetine.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  /* Las de global.css, otra vez: Astro mete ese CSS en el HTML sin la carpeta de la copia de prueba (ADS_BASE) y en
     /ads-v5-brand/ salían en Georgia. Aquí sí se le pone; en producción es el mismo archivo y no se baja dos veces */
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
  /* La página es clara, y el cursor propio va en tinta */
  html:has(main.bm), html:has(main.bm) body { background: var(--crema); color: var(--tinta); }
  html:has(main.bm) .cursor__iso, html:has(main.bm) .cursor__texto { color: var(--tinta); }
  html:has(main.bm) .cursor__pista { stroke: rgba(25, 9, 0, .3); }

  /* Los colores de la marca son variables: romper uno (brand/color.js) es cambiar la variable en main.bm */
  .bm {
    --marron: #34190A;
    --blanco: #F5F3F1;
    --titular: 'Apple Garamond', Georgia, serif;
    --gris: color-mix(in srgb, var(--tinta) 50%, transparent);
    --raya: color-mix(in srgb, var(--tinta) 15%, transparent);
    --mal: #FF4078;
    color: var(--tinta); background: var(--crema);
  }
  .bm .titular { font-family: var(--titular); font-weight: 300; }
  .bm-nombre { text-transform: none; }
  .bm-subraya { text-decoration: underline; text-underline-offset: 2px; }
  .bm-flecha { display: inline-block; font-size: 10px; transition: transform .4s var(--curva); }
  .bm .mono-p { font-family: var(--mono); font-size: 10px; line-height: 1.3; letter-spacing: .02em; }

  /* --- La barra de arriba ---------------------------------------------------------------------------------------- */
  .bm-barra {
    position: fixed; left: 0; right: 0; top: 0; z-index: 30;
    display: flex; align-items: center; gap: 32px; padding: 16px var(--margen);
    font-size: 13px; line-height: 1.22; font-weight: 500; color: var(--tinta); pointer-events: none;
  }
  .bm-barra > * { pointer-events: auto; }
  .bm-barra__logo { width: 104px; }
  .bm-barra__logo svg { width: 100%; height: auto; }
  .bm-barra__donde { margin: 0; display: flex; gap: 8px; }
  .bm-barra__hora { opacity: .58; font-variant-numeric: tabular-nums; }
  .bm-barra__volver { margin-left: auto; }
  .bm-barra__volver .bm-flecha { margin-right: 4px; }
  .bm-barra__volver:hover .bm-flecha, .bm-barra__volver:focus-visible .bm-flecha { transform: translateX(-4px); }

  /* --- La mesa ----------------------------------------------------------------------------------------------------- */
  /* Tres filas con su alto medido (el post tiene que ser cuadrado), y el reparto, asimétrico */
  /* Lo que se sale de la mesa (el logo estirado) se corta en el borde de la pantalla: no ensancha la página */
  .mesa { position: relative; overflow-x: clip; }
  .mesa__cab { position: relative; z-index: 1; }
  @media (min-width: 761px) {
    .mesa {
      --hueco: clamp(30px, 4.8vh, 50px);
      --alto: calc(max(100vh, 620px) - 78px - 56px - 2 * var(--hueco));
      --f1: calc(var(--alto) * .28); --f2: calc(var(--alto) * .39); --f3: calc(var(--alto) * .33);
      display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); grid-template-rows: var(--f1) var(--f2) var(--f3);
      column-gap: clamp(12px, 1.2vw, 22px); row-gap: var(--hueco);
      padding: 78px var(--margen) 56px;
    }
    @supports (height: 100svh) { .mesa { --alto: calc(max(100svh, 620px) - 78px - 56px - 2 * var(--hueco)); } }
    .mesa__cab { grid-column: 1 / 11; grid-row: 1; padding-top: 6px; }
    .pz--paleta { grid-column: 12 / 24; grid-row: 1; margin-top: 14px; }
    .pz--logo { grid-column: 1 / 16; grid-row: 2; }
    .pz--letra { grid-column: 17 / 25; grid-row: 2; margin-top: -18px; margin-bottom: 18px; }
    .pz--voz { grid-column: 2 / 11; grid-row: 3; margin-top: 10px; }
    .pz--post { grid-column: 12 / 17; grid-row: 3; width: calc(var(--f3) - 17px); max-width: 100%; }
    .pz--web { grid-column: 17 / 25; grid-row: 3; margin-top: -8px; margin-bottom: 8px; }
  }

  .mesa__ante { margin: 0 0 12px; font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .04em; text-transform: uppercase; color: var(--gris); }
  .mesa__t { margin: 0; font-size: clamp(46px, 8.4vh, 96px); line-height: .9; letter-spacing: -.03em; }
  .mesa__intro { margin: 16px 0 0; max-width: 50ch; font-size: 14px; line-height: 1.42; }

  /* La barra de estado, abajo */
  .mesa__estado {
    position: absolute; left: var(--margen); right: var(--margen); bottom: 18px; z-index: 2; margin: 0;
    display: flex; align-items: baseline; gap: 26px;
    font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .04em; text-transform: uppercase; color: var(--gris);
  }
  .mesa__estado b { display: inline-block; margin-left: 7px; font-family: var(--sans); font-weight: 500; font-size: 14px; letter-spacing: 0; color: var(--tinta); font-variant-numeric: tabular-nums; transition: color .3s; }
  .mesa__estado b.salta { animation: bm-salta .5s var(--curva); }
  .mesa__estado b.mal { color: var(--mal); }
  @keyframes bm-salta { 0% { transform: translateY(-40%); opacity: 0; } 100% { transform: none; opacity: 1; } }
  .mesa__pista { margin-left: auto; text-transform: none; letter-spacing: .02em; color: var(--tinta); }

  /* La línea que cruza la mesa entera (dentro.js) y el fondo roto que se queda detrás */
  .mesa__barrido { position: absolute; z-index: 7; pointer-events: none; background: var(--rosa); box-shadow: 0 0 16px 2px color-mix(in srgb, var(--rosa) 75%, transparent); }
  .mesa__barrido--x { top: 0; bottom: 0; left: 0; width: 1px; }
  .mesa__barrido--y { position: fixed; left: 0; right: 0; top: 0; height: 1px; }
  .mesa__velo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .mesa__insp { position: absolute; inset: 0; z-index: 6; pointer-events: none; }

  /* --- Cada pieza: el nombre de archivo encima, el marco, la cara y el código ------------------------------------- */
  .pz { position: relative; z-index: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; margin: 0; }
  .pz.tirando { z-index: 5; }
  .pz__nombre { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 7px; font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .02em; color: var(--gris); white-space: nowrap; }
  .pz__nombre > span:first-child { color: var(--tinta); }
  .pz__nombre > span:first-child::before { content: '#'; margin-right: 6px; color: var(--gris); }
  .pz__marco { position: relative; flex: 1 1 0; min-height: 0; outline: 1px solid var(--raya); transition: outline-color .3s var(--curva); }
  .pz__cara { position: absolute; inset: 0; }
  /* El código: noche, en mono, con el número de línea; la regla (los comentarios) en rosa y lo roto, marcado */
  .pz__codigo {
    position: absolute; inset: 0; z-index: 2; overflow: hidden; padding: 12px 14px 12px 0;
    background: var(--noche); color: var(--crema); clip-path: inset(0 100% 0 0);
  }
  .cod { font-family: var(--mono); font-size: clamp(9.5px, .72vw, 11px); line-height: 1.6; letter-spacing: 0; counter-reset: l; }
  .pz--logo .cod, .pz--letra .cod { font-size: clamp(10px, .86vw, 13px); }
  .pz--logo .pz__codigo { padding-top: 18px; }
  .cod__l { position: relative; display: block; min-height: 1.6em; padding-left: 3.6em; white-space: pre-wrap; overflow-wrap: anywhere; }
  .cod__l::before { counter-increment: l; content: counter(l); position: absolute; left: 0; width: 2.5em; text-align: right; color: color-mix(in srgb, var(--crema) 26%, transparent); }
  .cod__c { color: var(--rosa); }
  .cod mark { background: var(--rosa); color: var(--noche); }
  .cod__cursor { display: inline-block; width: .6em; height: 1.15em; margin-right: -.6em; vertical-align: -.22em; background: var(--crema); animation: cod-parpadeo 1s steps(1) infinite; }
  @keyframes cod-parpadeo { 50% { opacity: 0; } }
  /* La línea de escáner de cada pieza */
  .pz__linea {
    position: absolute; left: 0; top: -9px; bottom: -9px; z-index: 4; width: 1px; pointer-events: none; opacity: 0;
    background: var(--rosa); box-shadow: 0 0 14px 2px color-mix(in srgb, var(--rosa) 75%, transparent);
  }
  .pz__linea::before, .pz__linea::after { content: ''; position: absolute; left: -2px; width: 5px; height: 5px; background: var(--rosa); }
  .pz__linea::before { top: 0; }
  .pz__linea::after { bottom: 0; }
  /* Al pasar por encima se selecciona, como en una herramienta de diseño: dos asas y una guía que sobresale */
  .pz__asa { position: absolute; z-index: 3; width: 7px; height: 7px; border: 1px solid var(--tinta); background: var(--crema); opacity: 0; pointer-events: none; transition: opacity .3s var(--curva); }
  .pz__asa--a { left: -4px; top: -4px; }
  .pz__asa--b { right: -4px; bottom: -4px; }
  .pz__marco::after { content: ''; position: absolute; top: -1px; left: 100%; width: 34px; height: 1px; background: repeating-linear-gradient(90deg, var(--tinta) 0 3px, transparent 3px 6px); opacity: 0; transition: opacity .3s var(--curva); pointer-events: none; }
  html.con-raton .pz:hover .pz__marco, .pz.tirando .pz__marco { outline-color: var(--tinta); }
  html.con-raton .pz:hover .pz__asa, html.con-raton .pz:hover .pz__marco::after, .pz.tirando .pz__asa { opacity: 1; }
  .pz--web .pz__marco::after, .pz--paleta .pz__marco::after, .pz--letra .pz__marco::after { left: auto; right: 100%; }

  /* Antes de la entrada (con JS), las piezas se ven por dentro; la línea de la mesa las pasa a marca. Si el JS no
     llega, a los 3,5 s se ven por fuera igualmente */
  html.js .mesa:not(.lista) .pz__codigo { clip-path: none; animation: mesa-falla 0s 3.5s forwards; }
  html.js .mesa:not(.lista) .pz__cara, html.js .mesa:not(.lista) [data-mesa-revela] { clip-path: inset(0 100% 0 0); animation: mesa-falla-cara 0s 3.5s forwards; }
  @keyframes mesa-falla { to { clip-path: inset(0 100% 0 0); } }
  @keyframes mesa-falla-cara { to { clip-path: none; } }

  /* --- paleta.css ---------------------------------------------------------------------------------------------------- */
  .paleta { display: flex; height: 100%; margin: 0; padding: 0; list-style: none; }
  .paleta__m {
    position: relative; flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px;
    padding: 10px; background: var(--c); color: var(--blanco); touch-action: none; user-select: none;
    transition: flex-grow .6s var(--curva);
  }
  .paleta__m:nth-child(1) { flex-grow: 1.7; }
  .paleta__m:nth-child(2) { flex-grow: 1.25; box-shadow: inset 0 0 0 1px var(--raya); }
  .paleta__m:nth-child(4) { flex-grow: .85; }
  .paleta__m:nth-child(5) { flex-grow: .75; }
  .paleta__m.tirando { flex-grow: 2.6; }
  .paleta__m--claro { color: var(--tinta); }
  .paleta__m.oscuro { color: var(--blanco); }
  .paleta__m.claro { color: var(--tinta); }
  .paleta__n { font-size: 12px; font-weight: 500; line-height: 1; white-space: nowrap; }
  .paleta__hex { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .02em; opacity: .78; white-space: nowrap; }
  :root:not(.cursor-propio) .paleta__m { cursor: move; }
