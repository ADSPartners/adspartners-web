---
// Brand, «Desmontada» (02-nov; la B del prototipo de tres direcciones, la que eligió Álvaro). La marca de adsPartners
// despiezada en seis planchas: arriba, el ads terminado; al bajar, la pila se pone en vista técnica, se abre y se
// recorre capa a capa (la marca, la forma, el color, la letra, la voz y, debajo de todo, la idea). Cada capa es un
// capítulo: su plancha crece y, al lado, qué es, qué efecto tiene en una empresa y un dato con su fuente, con su número
// grande detrás y el índice abajo. Al final se vuelve a montar. Solo se tocan la de color y la de letra (15-nov); el
// ratón ladea un poco la pila y levanta esas dos (scripts/brand.js). CSS 3D, sin WebGL. Debajo, lo que hace una marca
// bien hecha y el cierre, que remata con los enlaces a las demás páginas (components/EnlacesWeb.astro).
// Los seis capítulos van enteros en el HTML (auditoría SEO del 03-nov: antes los escribía el JS y no los veía quien no lo
// ejecuta); brand.js solo decide cuál se ve.
import Base from '../../layouts/Base.astro';
import '../../styles/construye-brand.css';   // (la llegada: la página se construye; aparte, por el rediseño de Brand)
import Cursor from '../../components/Cursor.astro';
import Marca from '../../components/Marca.astro';
import EnlacesWeb from '../../components/EnlacesWeb.astro';
import NavSubpaginas from '../../components/NavSubpaginas.astro';
import { PORTADA, CAPAS, IDEA, PALETA, LETRAS, TITULAR_LETRA, EFECTOS, CIERRE } from '../../data/brand.js';
import { SERVICIO_BRAND } from '../../data/schema.js';

const base = import.meta.env.BASE_URL;
const cursiva = (s: string) => s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
// El canto de cada plancha, de la paleta del manual y el rosa de Brand (el de su pieza en el menú): en la vista técnica,
// la pila se lee como hojas de color apiladas
const CANTO: Record<string, string> = {
  marca: '#ff8fc8', forma: '#E7E2DA', color: 'linear-gradient(#34190A 0 20%, #E7E2DA 20% 40%, #F5CBD7 40% 60%, #F5F3F1 60% 80%, #190900 80%)',
  letra: '#F5CBD7', voz: '#ff8fc8', idea: '#34190A',
};
const LUZ_CANTO: Record<string, string> = { marca: '#ff8fc8', forma: '#E7E2DA', color: '#F5CBD7', letra: '#F5CBD7', voz: '#ff8fc8', idea: '#F5CBD7' };
const canto = (i: number) => `--canto: ${CANTO[CAPAS[i].id]}; --canto-luz: ${LUZ_CANTO[CAPAS[i].id]}`;
// La marca aplicada: lo que hacemos (los servicios del cierre) puesto en sus soportes
const [S_IDENTIDAD, S_WEBS, S_ARTE, S_CONTENIDO] = CIERRE.servicios;
---
<Base
  titulo="Branding e identidad de marca en Madrid · adsPartners®"
  descripcion="Identidad de marca de arriba abajo: logotipo, color, letra y voz, escritos en reglas y aplicados en tu web y tu contenido. Una marca no es un logo."
  miga="Brand"
  pagina={{ about: { '@id': SERVICIO_BRAND['@id'] } }}
  schema={[SERVICIO_BRAND]}
  construye
>
  <!-- Fijo, como en Tech: dónde estás y, a la derecha, la hora de aquí, el sonido y las cuatro páginas (en el móvil,
       en una fila debajo). Brand no lleva el logotipo fijo: a la home se vuelve con «adsPartners» -->
  <p class="bd-donde"><span class="bd-barra" aria-hidden="true"></span><span>Brand · <a class="bd-marca" href={base} aria-label="adsPartners, inicio" data-sonido-hover>adsPartners</a></span></p>
  <div class="bd-arriba">
    <p class="bd-madrid" aria-hidden="true">Desde Madrid <span class="bd-hora" data-bd-hora></span></p>
    <button class="bd-sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
      <span class="bd-ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="oculto-accesible" data-sonido-txt>Sonido off</span>
    </button>
    <NavSubpaginas actual="brand" class="bd-nav" />
  </div>

  <main class="bd" data-brand data-cursor="manual">
    <h1 class="oculto-accesible">Brand: branding, identidad de marca, logotipo y webs con una idea propia</h1>

    <!-- El viaje: la escena se queda fija mientras bajas y lo bajado la despieza -->
    <section class="bd-viaje" data-viaje aria-label="La marca de adsPartners, desmontada">
      <div class="bd-escena" data-escena>
        <div class="bd-texto" data-texto>
          <p class="bd-etq">( {PORTADA.etiqueta} )</p>
          <h2 class="bd-t" data-vivo data-titulo set:html={cursiva(PORTADA.titulo)} />
          <p class="bd-p">{PORTADA.texto}</p>
        </div>

        <!-- El número grande de la capa que tiene su capítulo, detrás de la pila, cada uno a su manera: la marca en rosa,
             la forma solo en su contorno, el color con los cinco, la letra en cursiva, la voz en rosa claro y la idea,
             que no se ve, en hueco -->
        <p class="bd-folio" data-folio aria-hidden="true">{CAPAS.map((c) => <span class={`bd-folio--${c.id}`}>{c.n}</span>)}</p>

        <div class="bd-pila" data-pila aria-hidden="true">
          <div class="bd-giro" data-giro>
            <div class="bd-capa bd-capa--marca" data-capa="0" style={canto(0)}>
              <div class="bd-capa__brillo"></div>
              <div class="bd-capa__dentro">
                <div class="bd-marca__iso"><Marca tipo="iso" /></div>
                <div class="bd-marca__logo"><Marca tipo="logo" /></div>
              </div>
            </div>
            <div class="bd-capa" data-capa="1" style={canto(1)}>
              <div class="bd-capa__dentro">
                <div class="bd-forma" data-forma>
                  <span class="bd-forma__aire" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                  <span class="bd-forma__fantasma"><Marca tipo="iso" /></span>
                  <span class="bd-forma__iso" data-forma-iso><Marca tipo="iso" /></span>
                </div>
                <span class="bd-forma__nota bd-forma__nota--aire">Área de respeto · x</span>
                <span class="bd-forma__nota bd-forma__nota--min">Mínimo · 24 px</span>
              </div>
            </div>
            <div class="bd-capa" data-capa="2" style={canto(2)}>
              <div class="bd-colores">
                {PALETA.map((c, i) => (
                  <button class="bd-color" type="button" data-color={i} tabindex="-1" style={`background:${c.hex};color:${c.oscuro ? '#E7E2DA' : '#190900'}`}><span>{c.nombre}</span></button>
                ))}
              </div>
            </div>
            <div class="bd-capa" data-capa="3" style={canto(3)}>
              <div class="bd-capa__dentro bd-letra">
                <p class="bd-letra__t" data-letra-t>{TITULAR_LETRA}</p>
                <p class="bd-letra__escala"><span>Titular · 300</span><span>Texto · 400</span><span>Detalle</span></p>
                <div class="bd-letra__chips">
                  {LETRAS.map((l, i) => (
                    <button type="button" data-letra={i} tabindex="-1" style={`font-family:${l.familia};font-weight:${l.peso}`}>Aa<span>{l.papel}</span></button>
                  ))}
                </div>
              </div>
            </div>
            <div class="bd-capa" data-capa="4" style={canto(4)}>
              <div class="bd-capa__dentro bd-vozcapa" data-voz-capa>
                <p class="bd-voz__etq">Así no · así sí</p>
                <p class="bd-voz" data-voz></p>
                <p class="bd-voz__no" data-voz-no></p>
              </div>
            </div>
            <div class="bd-capa bd-capa--idea" data-capa="5" style={canto(5)}>
              <div class="bd-capa__dentro bd-idea" data-idea>
                {IDEA.map(([que, dice]) => <p class="bd-idea__linea"><span>{que}</span>{dice}</p>)}
              </div>
            </div>
          </div>
        </div>

        <!-- Las cotas de la vista técnica, a la derecha de cada plancha -->
        <div class="bd-cotas" aria-hidden="true">
          <svg>{CAPAS.map(() => <line />)}</svg>
          {CAPAS.map((c) => <span class="bd-cota"><b>{c.n}</b><span>{c.nombre} · {c.cota}</span></span>)}
        </div>

        <!-- Los seis capítulos, uno por capa: qué es, qué efecto tiene, el dato con su fuente y, en la de color y la de
             letra, su juego; cada uno, con el color de su capa (--acento). Están todos en el HTML (los lee quien no
             ejecuta el JS: buscadores y asistentes) y brand.js enseña el de la capa que toca. Los
             demás quedan ocultos del todo (visibility), así que el lector de pantalla solo anuncia el que entra -->
        <div class="bd-caps" aria-live="polite">
          {CAPAS.map((c, i) => (
            <article class="bd-cap" data-cap={i} style={`--acento: ${LUZ_CANTO[c.id]}`}>
              <p class="bd-cap__n">{c.n} — {c.nombre}</p>
              <h3 class="bd-cap__t" set:html={cursiva(c.titular)} />
              <p class="bd-cap__que">{c.que}</p>
              <p class="bd-cap__importa">{c.importa}</p>
              <div class="bd-cap__dato">
                <p class="bd-cap__cifra" data-cap-cifra>{c.dato.cifra}</p>
                <div><p class="bd-cap__dice">{c.dato.texto}</p><p class="bd-cap__fuente">{c.dato.fuente}</p></div>
              </div>
              {c.juego && <p class="bd-cap__juego" data-cap-juego>{c.juego}</p>}
            </article>
          ))}
        </div>
        <!-- El índice: las seis capas, de la que se ve a la que lo sostiene; cada tramo se llena con su color al bajar -->
        <ol class="bd-indice" data-indice aria-hidden="true">
          {CAPAS.map((c, i) => <li style={canto(i)}><i></i><b>{c.n}</b><span>{c.nombre}</span></li>)}
        </ol>
        <p class="bd-pista" data-pista><span>{PORTADA.pista}</span><i aria-hidden="true"></i></p>
      </div>
    </section>

    <!-- La marca aplicada: la misma marca en sus soportes (la tarjeta, la web, el post, el sobre, el cartel y la bolsa),
         sobre el rosa de Brand. Al bajar, la fila pasa de lado (brand.js); sin JS o con «movimiento reducido», se
         desliza con el dedo. Es dibujo: las palabras son las que ya salen en la página -->
    <section class="bd-aplicada" data-aplicada aria-hidden="true">
      <div class="bd-aplicada__fijo" data-aplicada-fijo>
        <div class="bd-aplicada__pista" data-aplicada-pista>
          <figure class="bd-ap bd-ap--tarjetas" style="--g: -4deg">
            <div class="bd-tarjeta bd-tarjeta--detras"><span class="bd-tarjeta__iso"><Marca tipo="iso" /></span></div>
            <div class="bd-tarjeta"><span class="bd-tarjeta__iso"><Marca tipo="iso" /></span><span class="bd-tarjeta__logo"><Marca tipo="logo" /></span><span class="bd-tarjeta__raya"></span></div>
            <figcaption>{S_IDENTIDAD}</figcaption>
          </figure>
          <figure class="bd-ap bd-ap--web" style="--g: 3deg">
            <div class="bd-web">
              <div class="bd-web__barra"><i></i><i></i><i></i><span></span></div>
              <div class="bd-web__dentro">
                <span class="bd-web__logo"><Marca tipo="logo" /></span>
                <p class="bd-web__t" set:html={cursiva(PORTADA.titulo)} />
                <span class="bd-web__boton"></span>
                <span class="bd-web__iso"><Marca tipo="iso" /></span>
              </div>
            </div>
            <figcaption>{S_WEBS}</figcaption>
          </figure>
          <figure class="bd-ap bd-ap--post" style="--g: -2deg">
            <div class="bd-post"><span class="bd-post__iso"><Marca tipo="iso" /></span><span class="bd-post__logo"><Marca tipo="logo" /></span></div>
            <figcaption>{S_CONTENIDO}</figcaption>
          </figure>
          <figure class="bd-ap bd-ap--sobre" style="--g: 5deg">
            <div class="bd-sobre"><span class="bd-sobre__solapa"></span><span class="bd-sobre__sello"><Marca tipo="iso" /></span><span class="bd-sobre__logo"><Marca tipo="logo" /></span></div>
          </figure>
          <figure class="bd-ap bd-ap--cartel" style="--g: -3deg">
            <div class="bd-cartel"><p class="bd-cartel__t" set:html={cursiva(PORTADA.final)} /><span class="bd-cartel__logo"><Marca tipo="logo" /></span><span class="bd-cartel__iso"><Marca tipo="iso" /></span></div>
            <figcaption>{S_ARTE}</figcaption>
          </figure>
          <figure class="bd-ap bd-ap--bolsa" style="--g: 4deg">
            <div class="bd-bolsa"><span class="bd-bolsa__asa"></span><span class="bd-bolsa__logo"><Marca tipo="logo" /></span><span class="bd-bolsa__iso"><Marca tipo="iso" /></span></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- Lo que hace una marca bien hecha: tres efectos medidos, cada uno con su fuente y su pega -->
    <section class="bd-efectos" data-efectos aria-labelledby="bd-efectos-t">
      <p class="bd-efectos__ante">{EFECTOS.antetitulo}</p>
      <h2 class="bd-efectos__t" id="bd-efectos-t" data-vivo set:html={cursiva(EFECTOS.titulo)} />
      <ol class="bd-efectos__lista">
        {EFECTOS.lista.map((e, i) => (
          <li class="bd-efecto" style={`--i: ${i}`}>
            <p class="bd-efecto__cifra"><b data-cuenta={e.cuenta} data-antes={e.menos ? '−' : e.cifra.startsWith('+') ? '+' : ''} data-sufijo={e.sufijo}>{e.cifra}</b>{e.unidad && <span>{e.unidad}</span>}</p>
            <h3 class="bd-efecto__t">{e.titulo}</h3>
            <p class="bd-efecto__texto">{e.texto}</p>
            <p class="bd-efecto__fuente">{e.fuente}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Lo que hacemos con la tuya -->
    <section class="bd-cierre" id="la-tuya" data-cierre aria-labelledby="bd-cierre-t">
      <div class="bd-cierre__fondo" data-cierre-fondo aria-hidden="true"></div>
      <div>
        <p class="bd-cierre__ante">{CIERRE.antetitulo}</p>
        <h2 class="bd-cierre__t" id="bd-cierre-t" data-vivo set:html={cursiva(CIERRE.titulo)} />
      </div>
      <div class="bd-cierre__dcha">
        <p class="bd-cierre__p">{CIERRE.texto}</p>
        <ul class="bd-cierre__servicios">{CIERRE.servicios.map((s) => <li>{s}</li>)}</ul>
        <a class="bd-cierre__carta" href={`${base}#contacto`} data-sonido-hover><span class="bd-subraya">{CIERRE.carta}</span> <span aria-hidden="true">▶</span></a>
      </div>
      <EnlacesWeb actual="brand" class="bd-cierre__enlaces" />
    </section>
  </main>
  <Cursor />
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarBrand } from '../../scripts/brand.js';
    arrancarPagina(montarBrand);
  </script>
</Base>

<style is:global>
  @font-face { font-family: 'Quetine'; src: url('/assets/fonts/Quetine.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  /* (otra vez las de global.css: en la copia de prueba Astro mete ese CSS sin la carpeta y salen en Georgia) */
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }

  /* El cursor, sin el logotipo dentro (a Álvaro le distrae): solo el aro y, sobre cada plancha, qué se puede hacer */
  html:has(main.bd) .cursor__iso { display: none; }
  .bd { --lado: clamp(18px, 2.4vw, 36px); --arriba: clamp(18px, 2.6vh, 30px); --rosa-2: rgba(245, 203, 215, .38); color: var(--crema); }

  /* --- Fijo ---------------------------------------------------------------------------------------------------- */
  .bd-donde, .bd-madrid { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .bd-donde { position: fixed; left: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; margin: 0; display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .bd-barra { width: 4px; height: 18px; background: var(--rosa); }
  .bd-marca { text-transform: none; letter-spacing: .04em; pointer-events: auto; }
  .bd-marca:hover, .bd-marca:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .bd-arriba { position: fixed; right: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; height: 18px; display: flex; align-items: center; gap: 30px; }
  .bd-madrid { margin: 0; pointer-events: none; }
  .bd-hora { margin-left: 6px; opacity: .58; font-variant-numeric: tabular-nums; }
  /* Las cuatro páginas (components/NavSubpaginas.astro), al final de la barra: el nombre, a la altura de lo demás */
  .bd-nav { --nsp-retraso: 1.4s; align-self: flex-start; margin-top: -9px; color: var(--crema); }
  .bd-sonido { display: block; padding: 6px; margin: -6px -6px -6px 0; }
  .bd-ondas { display: flex; align-items: center; gap: 3px; height: 16px; }
  .bd-ondas i { width: 2px; height: 3px; background: var(--crema); transition: height .3s var(--curva); }
  html.sonido-on .bd-ondas i { animation: bd-onda 1.1s ease-in-out infinite; }
  html.sonido-on .bd-ondas i:nth-child(2) { animation-delay: -.3s; }
  html.sonido-on .bd-ondas i:nth-child(3) { animation-delay: -.7s; }
  html.sonido-on .bd-ondas i:nth-child(4) { animation-delay: -.5s; }
  @keyframes bd-onda { 0%, 100% { height: 3px; } 50% { height: 15px; } }

  /* --- El viaje ---------------------------------------------------------------------------------------------------- */
  /* Largo: cada una de las seis capas tiene pantalla y media para ella */
  .bd-viaje { position: relative; height: 1300vh; }
  .bd-escena { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; user-select: none; -webkit-user-select: none; }
  .bd-texto { position: absolute; left: var(--lado); top: 15vh; z-index: 3; max-width: 33vw; pointer-events: none; transition: opacity .5s var(--curva), transform .5s var(--curva); }
  /* Mientras hay un capítulo, la portada se aparta y la pila se va un poco a la derecha */
  .bd-texto.fuera { opacity: 0; transform: translateY(-14px); }
  .bd-etq { margin: 0 0 3vh; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--brand); }
  .bd-t { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(48px, min(5.8vw, 11vh), 112px); line-height: .9; letter-spacing: -.03em; }
  .bd-t em, .bd-cierre__t em { font-style: italic; }
  .bd-p { margin: 3vh 0 0; max-width: 34ch; font-size: 15px; line-height: 1.6; color: var(--crema-2); }

  /* La pila: el contenedor con perspectiva, el que gira y las planchas */
  .bd-pila { position: absolute; left: 58%; top: 56%; width: 0; height: 0; perspective: 1800px; transition: left .9s var(--curva), top .9s var(--curva); }
  .bd-escena.en-capitulo .bd-pila { left: 63%; }
  .bd-giro { position: absolute; left: 0; top: 0; transform-style: preserve-3d; }
  .bd-capa {
    --w: min(38vw, 58vh); --h: calc(var(--w) * .62);
    position: absolute; left: calc(var(--w) / -2); top: calc(var(--h) / -2); width: var(--w); height: var(--h);
    border: 1px solid var(--rosa-2); background: rgba(18, 13, 10, .88); overflow: hidden;
    transition: opacity .5s var(--curva), border-color .5s var(--curva), background-color .6s var(--curva);
  }
  /* Mientras otra capa tiene su turno: casi apagada y sin coger el ratón (si no, tapa el juego de la de debajo) */
  .bd-capa.apagada { opacity: .16; pointer-events: none; }
  .bd-capa.activa, .bd-capa.encima { border-color: var(--rosa); }
  .bd-capa__dentro { position: absolute; inset: 9%; display: flex; align-items: center; justify-content: center; }

  /* 01 · La marca: el isotipo y el logotipo; toma el color que pases en la de color. Un brillo sigue al ratón */
  .bd-capa--marca { --iso: #F5CBD7; --logo: #E7E2DA; background: #120D0A; }
  .bd-capa--marca .bd-capa__dentro { flex-direction: column; gap: 7%; }
  .bd-marca__iso { width: 58%; color: var(--iso); transition: color .5s var(--curva); }
  .bd-marca__logo { width: 34%; color: var(--logo); transition: color .5s var(--curva); }
  .bd-marca__iso svg, .bd-marca__logo svg, .bd-forma svg { display: block; width: 100%; height: auto; }
  .bd-capa__brillo { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at var(--bx, 30%) var(--by, 20%), rgba(255, 240, 245, .14), transparent 45%); }

  /* 02 · Forma: el isotipo en línea, su sombra de la proporción buena y lo que se ha estirado */
  .bd-forma { position: relative; width: 70%; color: var(--rosa); }
  .bd-forma svg path { fill: none; stroke: currentColor; stroke-width: 5; }
  .bd-forma__fantasma { position: absolute; inset: 0; opacity: .3; }
  .bd-forma__fantasma svg path { stroke-dasharray: 18 14; }
  .bd-forma__iso { display: block; transform-origin: 0 50%; }
  .bd-forma::before, .bd-forma::after { content: ''; position: absolute; left: -9%; right: -9%; border-top: 1px dashed var(--rosa-2); }
  .bd-forma::before { top: 0; } .bd-forma::after { bottom: 0; }
  /* el área de respeto (el aire que lleva siempre alrededor), con sus esquinas, y el tamaño mínimo */
  .bd-forma__aire { position: absolute; inset: -16% -9%; border: 1px dashed var(--rosa-2); }
  .bd-forma__aire i { position: absolute; width: 9px; height: 9px; border-color: var(--rosa); border-style: solid; border-width: 0; }
  .bd-forma__aire i:nth-child(1) { left: -1px; top: -1px; border-left-width: 1px; border-top-width: 1px; }
  .bd-forma__aire i:nth-child(2) { right: -1px; top: -1px; border-right-width: 1px; border-top-width: 1px; }
  .bd-forma__aire i:nth-child(3) { left: -1px; bottom: -1px; border-left-width: 1px; border-bottom-width: 1px; }
  .bd-forma__aire i:nth-child(4) { right: -1px; bottom: -1px; border-right-width: 1px; border-bottom-width: 1px; }
  .bd-forma__nota { position: absolute; font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-2); }
  .bd-forma__nota--aire { left: 0; top: -2%; }
  .bd-forma__nota--min { left: 0; bottom: -2%; }

  /* 03 · Color: cinco franjas que se pueden tocar */
  .bd-colores { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
  .bd-color { position: relative; display: flex; align-items: flex-end; padding: 10px; font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; transition: flex-grow .4s, transform .4s var(--curva); }
  .bd-color span { transition: transform .4s var(--curva); }
  .bd-color.tocado span { transform: translateY(-6px); }
  .bd-colores.con-uno .bd-color:not(.tocado) { filter: saturate(.7) brightness(.8); }

  /* 04 · Letra: el titular y las tres letras para ponérselas */
  .bd-letra { flex-direction: column; justify-content: space-between; inset: 10% 9% 9%; }
  .bd-letra__t { margin: 0; font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .1); line-height: 1; transition: opacity .2s; }
  .bd-letra__escala { margin: 0; width: 100%; display: flex; gap: 18px; font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-3); }
  .bd-letra__chips { display: flex; gap: 10px; width: 100%; }
  .bd-letra__chips button { flex: 1; display: grid; justify-items: start; gap: 6px; padding: 10px 12px; border: 1px solid var(--rosa-2); font-size: calc(var(--w) * .07); line-height: 1; text-align: left; transition: border-color .3s, background-color .3s; }
  .bd-letra__chips button span { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--crema-2); }
  .bd-letra__chips button.tocado { border-color: var(--rosa); background: rgba(245, 203, 215, .08); }

  /* 05 · Voz: una frase de agencia que se corrige */
  .bd-vozcapa { flex-direction: column; gap: 14px; }
  .bd-voz { margin: 0; font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .066); line-height: 1.12; text-align: center; }
  .bd-voz s { color: var(--crema-3); text-decoration-thickness: 1px; }
  .bd-voz b { font-weight: 300; font-style: italic; color: var(--rosa); }
  .bd-voz__no { margin: 0; min-height: 3em; max-width: 34ch; font-family: var(--mono); font-size: 9px; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase; text-align: center; color: var(--crema-2); }
  .bd-voz__etq { margin: 0; font-family: var(--mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--rosa); }

  /* 06 · Idea: las tres frases que lo sostienen todo */
  .bd-capa--idea { background: rgba(28, 19, 15, .92); }
  .bd-idea { flex-direction: column; align-items: stretch; justify-content: center; gap: 8%; }
  .bd-idea__linea { margin: 0; display: grid; grid-template-columns: 26% 1fr; align-items: baseline; gap: 4%; padding-top: 3%; border-top: 1px solid var(--rosa-2); font-family: var(--serif); font-weight: 300; font-size: calc(var(--w) * .046); line-height: 1.1; }
  .bd-idea__linea span { font-family: var(--mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--rosa); }

  /* Las cotas */
  .bd-cotas { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .bd-cotas svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bd-cotas line { stroke: rgba(245, 203, 215, .55); stroke-width: 1; stroke-dasharray: 3 3; transition: opacity .4s; }
  .bd-cota { position: absolute; left: 0; top: 0; font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; color: var(--crema-2); transition: color .4s, opacity .4s; }
  .bd-cota b { font-weight: 400; color: var(--rosa); margin-right: 8px; }
  .bd-cota.activa { color: var(--crema); }

  /* Los capítulos, uno encima de otro: se ve el de la capa que toca, que entra al cambiar de capa (brand.js le pone .on y
     se la quita al que sale). El que sale se apaga y, al acabar, se oculta del todo (visibility: fuera del árbol de
     accesibilidad, para que el lector de pantalla no lea los seis) */
  .bd-cap { position: absolute; left: var(--lado); top: 12vh; bottom: 9vh; z-index: 3; width: min(34vw, 530px); display: flex; flex-direction: column; justify-content: center; pointer-events: none;
    opacity: 0; transform: translateY(16px); visibility: hidden; transition: opacity .45s var(--curva), transform .45s var(--curva), visibility 0s linear .45s; }
  .bd-cap.on { opacity: 1; transform: none; visibility: visible; transition: opacity .8s var(--curva), transform .8s var(--curva), visibility 0s; }
  .bd-cap p, .bd-cap h3 { margin: 0; }
  .bd-cap__n { align-self: flex-start; padding: 6px 9px 5px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--tinta); background: var(--acento, var(--rosa)); }
  .bd-cap__t { margin-top: 2.4vh !important; font-family: var(--serif); font-weight: 300; font-size: clamp(38px, min(4.4vw, 7.6vh), 80px); line-height: .94; letter-spacing: -.025em; }
  .bd-cap__t em { font-style: italic; color: var(--acento, var(--rosa)); }
  /* la entradilla, en la letra de la marca; el segundo párrafo, sangrado y con una raya de su color */
  .bd-cap__que { margin-top: 2.8vh !important; font-family: var(--serif); font-size: clamp(17px, min(1.4vw, 2.4vh), 21px); line-height: 1.38; }
  .bd-cap__importa { margin: 1.8vh 0 0 16% !important; padding-left: 14px; border-left: 1px solid var(--acento, var(--rosa)); font-size: 14px; line-height: 1.6; color: var(--crema-2); }
  .bd-cap__dato { margin-top: 3.4vh; padding-top: 2.4vh; border-top: 1px solid var(--linea); display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; align-items: start; }
  .bd-cap__cifra { font-family: var(--serif); font-weight: 300; font-size: clamp(48px, min(5vw, 9vh), 96px); line-height: .88; letter-spacing: -.03em; color: var(--acento, var(--rosa)); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .bd-cap__dice { font-size: 14px; line-height: 1.5; }
  .bd-cap__fuente { margin-top: 10px !important; font-family: var(--mono); font-size: 9px; line-height: 1.55; letter-spacing: .08em; text-transform: uppercase; color: var(--crema-3); }
  .bd-cap__juego { margin-top: 3.2vh !important; display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .bd-cap__juego::before { content: ''; width: 6px; height: 6px; background: var(--acento, var(--rosa)); }

  /* --- Lo que hace una marca bien hecha --------------------------------------------------------------------------- */
  .bd-efectos { position: relative; z-index: 2; padding: 18vh calc(var(--lado) + 4vw) 6vh var(--lado); border-top: 1px solid var(--linea); }
  .bd-efectos__ante { margin: 0 0 4vh; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--rosa); }
  .bd-efectos__t { margin: 0; max-width: none; font-family: var(--serif); font-weight: 300; font-size: clamp(44px, 6.4vw, 120px); line-height: .9; letter-spacing: -.03em; }
  /* la segunda línea, sangrada y en el rosa de Brand (al bajar se corre un poco: brand.js) */
  .bd-efectos__t em { display: block; padding-left: 1.6em; font-style: italic; color: var(--brand); }
  /* las tres, en escalera */
  .bd-efectos__lista { margin: 10vh 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3.4vw; align-items: start; }
  .bd-efecto:nth-child(2) { margin-top: 7vh; }
  .bd-efecto:nth-child(3) { margin-top: 14vh; }
  .bd-efecto { padding-top: 3vh; border-top: 1px solid var(--linea); opacity: 0; transform: translateY(20px); transition: opacity .9s var(--curva) calc(var(--i) * 140ms), transform .9s var(--curva) calc(var(--i) * 140ms); }
  .bd-efectos.on .bd-efecto { opacity: 1; transform: none; }
  .bd-efecto p, .bd-efecto h3 { margin: 0; }
  .bd-efecto__cifra { font-family: var(--serif); font-weight: 300; font-size: clamp(58px, 6vw, 112px); line-height: .9; letter-spacing: -.03em; color: var(--rosa); font-variant-numeric: tabular-nums; }
  .bd-efecto__cifra b { font-weight: inherit; }
  .bd-efecto__cifra span { margin-left: 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .bd-efecto__t { margin-top: 2.6vh !important; font-family: var(--serif); font-weight: 400; font-size: 28px; line-height: 1.1; }
  .bd-efecto__texto { margin-top: 1.4vh !important; font-size: 15px; line-height: 1.6; color: var(--crema-2); }
  .bd-efecto__fuente { margin-top: 2.4vh !important; font-family: var(--mono); font-size: 9px; line-height: 1.55; letter-spacing: .08em; text-transform: uppercase; color: var(--crema-3); }

  /* La pista del principio: se va en cuanto bajas */
  .bd-pista { position: absolute; right: var(--lado); bottom: 26px; z-index: 2; margin: 0; display: grid; justify-items: center; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); transition: transform .8s var(--curva), opacity .8s; }
  .bd-pista i { width: 1px; height: 34px; background: currentColor; transform-origin: 50% 0; animation: bd-pista 1.8s var(--curva) infinite; }
  @keyframes bd-pista { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1) translateY(12px); opacity: 0; } }
  .bd-pista.fuera { transform: translateY(160%); opacity: 0; }

  /* --- Lo que hacemos con la tuya --------------------------------------------------------------------------------- */
  .bd-cierre { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 5vw; padding: 18vh calc(var(--lado) + 4vw) 20vh var(--lado); border-top: 1px solid var(--linea); }
  .bd-cierre__ante { margin: 0 0 4vh; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--rosa); }
  .bd-cierre__t { margin: 0; max-width: 11ch; font-family: var(--serif); font-weight: 300; font-size: clamp(46px, 6.2vw, 112px); line-height: .92; letter-spacing: -.03em; }
  .bd-cierre__dcha { padding-top: calc(4vh + 16px); }
  .bd-cierre__p { margin: 0 0 4vh; font-size: 16px; line-height: 1.55; color: var(--crema-2); }
  .bd-cierre__servicios { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; font-family: var(--mono); font-size: 11px; line-height: 1.4; letter-spacing: .06em; text-transform: uppercase; }
  .bd-cierre__servicios li { padding-top: 8px; border-top: 1px solid var(--linea); }
  .bd-cierre__carta { display: inline-block; margin-top: 6vh; font-weight: 500; }
  .bd-subraya { text-decoration: underline; text-underline-offset: 2px; }
  /* De remate, los enlaces a las demás páginas (components/EnlacesWeb.astro), a todo lo ancho y con su raya */
  .bd-cierre__enlaces { grid-column: 1 / -1; margin-top: 12vh; padding-top: 3vh; border-top: 1px solid var(--linea); }
  .bd-cierre__ante, .bd-cierre__t, .bd-cierre__dcha > *, .bd-cierre__enlaces { opacity: 0; transform: translateY(18px); transition: opacity .9s var(--curva), transform .9s var(--curva); }
  .bd-cierre.on .bd-cierre__ante, .bd-cierre.on .bd-cierre__t, .bd-cierre.on .bd-cierre__dcha > *, .bd-cierre.on .bd-cierre__enlaces { opacity: 1; transform: none; }
  .bd-cierre.on .bd-cierre__t { transition-delay: .1s; }
  .bd-cierre.on .bd-cierre__dcha > :nth-child(1) { transition-delay: .3s; }
  .bd-cierre.on .bd-cierre__dcha > :nth-child(2) { transition-delay: .42s; }
  .bd-cierre.on .bd-cierre__dcha > :nth-child(3) { transition-delay: .54s; }
  .bd-cierre.on .bd-cierre__enlaces { transition-delay: .7s; }

  /* --- Color (13-nov: «la idea me encanta, pero la página me parece sosa») ------------------------------------------
     La paleta del manual (marrón, beige, rosa, blanco y negro) y el rosa de Brand, el de su pieza en el menú (#ff8fc8),
     con su papel: el rosa marca lo que tiene que verse, el marrón da peso, el beige calma */
  .bd { --brand: #ff8fc8; --marron: #34190A; }

  /* La luz de cada capítulo, detrás de la pila: dos manchas de luz cuyos colores cambian con la capa que tiene su turno
     (brand.js pone data-luz en la escena) y se funden al cambiar (propiedades registradas, que se pueden animar). Va en
     su propia capa (::before, will-change): así no se repinta cuando cambian las cotas, que se mueven en cada
     fotograma, y solo se pinta mientras cambia de color. Sin JS, la de la portada; sin @property, cambia sin fundido */
  @property --luz-a { syntax: '<color>'; inherits: false; initial-value: rgba(255, 143, 200, .26); }
  @property --luz-b { syntax: '<color>'; inherits: false; initial-value: rgba(52, 25, 10, .95); }
  .bd-escena::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; will-change: transform;
    --luz-a: rgba(255, 143, 200, .26); --luz-b: rgba(52, 25, 10, .95);
    background:
      radial-gradient(ellipse 44% 52% at 62% 55%, var(--luz-a), transparent 70%),
      radial-gradient(ellipse 75% 65% at 92% 100%, var(--luz-b), transparent 75%);
    transition: --luz-a 1.2s var(--curva), --luz-b 1.2s var(--curva);
  }
  /* 01 la marca: su rosa · 02 la forma: beige, la calma de un tablero de dibujo · 03 el color: el que tocas (si no, el
     rosa del manual), sobre el marrón que da peso · 04 la letra: rosa claro · 05 la voz: el rosa de Brand, de abajo
     arriba · 06 la idea: el marrón de debajo de todo · y montada otra vez, el rosa entero */
  .bd-escena[data-luz='marca']::before { --luz-a: rgba(255, 143, 200, .34); --luz-b: rgba(52, 25, 10, .9); }
  .bd-escena[data-luz='forma']::before { --luz-a: rgba(231, 226, 218, .2); --luz-b: rgba(52, 25, 10, .5); }
  .bd-escena[data-luz='color']::before { --luz-a: color-mix(in srgb, var(--luz-color, #F5CBD7) 42%, transparent); --luz-b: rgba(52, 25, 10, 1); }
  .bd-escena[data-luz='letra']::before { --luz-a: rgba(245, 203, 215, .24); --luz-b: rgba(52, 25, 10, .6); }
  .bd-escena[data-luz='voz']::before { --luz-a: rgba(255, 143, 200, .26); --luz-b: rgba(255, 143, 200, .36); }
  .bd-escena[data-luz='idea']::before { --luz-a: rgba(245, 203, 215, .2); --luz-b: rgba(52, 25, 10, 1); }
  .bd-escena[data-luz='final']::before { --luz-a: rgba(255, 143, 200, .42); --luz-b: rgba(52, 25, 10, .9); }
  @media (prefers-reduced-motion: reduce) {
    .bd-escena::before { transition: none; }
  }

  /* El canto de cada plancha: una tira de su color en el borde izquierdo (en la de color, las cinco) y, mientras tiene su
     capítulo, el borde en su color */
  .bd-capa::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--canto); pointer-events: none; }
  /* (sin sombra difuminada: en una plancha en 3D que se mueve en cada fotograma, cuesta; el resplandor lo da la luz) */
  .bd-capa.activa { border-color: var(--canto-luz); }

  /* --- La marca aplicada ------------------------------------------------------------------------------------------ */
  .bd-aplicada {
    --u: min(1.15vh, 1.7vw);
    position: relative; z-index: 2; overflow: clip; color: var(--tinta);
    background:
      radial-gradient(ellipse 60% 70% at 20% 30%, rgba(245, 203, 215, .7), transparent 70%),
      radial-gradient(ellipse 50% 60% at 90% 90%, rgba(52, 25, 10, .22), transparent 70%),
      var(--brand);
  }
  /* sin JS o con movimiento reducido, una fila que se desliza */
  .bd-aplicada__fijo { height: 100vh; height: 100svh; display: flex; align-items: center; overflow-x: auto; scrollbar-width: none; }
  .bd-aplicada__fijo::-webkit-scrollbar { display: none; }
  .bd-aplicada__pista { display: flex; align-items: center; gap: calc(var(--u) * 9); padding: 0 calc(var(--u) * 12); flex: none; }
  /* con JS: la escena se queda fija y la fila pasa de lado al bajar (brand.js da el alto y mueve la pista) */
  .bd-aplicada.en-viaje .bd-aplicada__fijo { position: sticky; top: 0; overflow: visible; }
  .bd-aplicada.en-viaje .bd-aplicada__pista { will-change: transform; }
  .bd-ap { position: relative; flex: none; margin: 0; transform: rotate(var(--g, 0deg)); }
  .bd-aplicada.en-viaje .bd-ap { will-change: transform; }
  .bd-ap figcaption {
    position: absolute; left: 0; top: calc(100% + var(--u) * 3.4); white-space: nowrap;
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(25, 9, 0, .78);
  }
  .bd-ap figcaption::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 10px; background: var(--tinta); vertical-align: 1px; }
  .bd-ap svg { display: block; width: 100%; height: auto; }
  .bd-ap > div { box-shadow: 0 calc(var(--u) * 3) calc(var(--u) * 6) calc(var(--u) * -2) rgba(25, 9, 0, .45), 0 2px 4px rgba(25, 9, 0, .18); }

  /* La tarjeta, por delante y por detrás */
  .bd-ap--tarjetas { width: calc(var(--u) * 36); height: calc(var(--u) * 21); }
  .bd-tarjeta { position: absolute; inset: 0; background: #F5F3F1; }
  .bd-tarjeta--detras { background: var(--marron); transform: translate(calc(var(--u) * 6), calc(var(--u) * -5)) rotate(7deg); }
  .bd-tarjeta__iso { position: absolute; right: 8%; top: 12%; width: 18%; color: var(--brand); }
  .bd-tarjeta--detras .bd-tarjeta__iso { left: 50%; top: 50%; width: 36%; transform: translate(-50%, -50%); color: #F5CBD7; }
  .bd-tarjeta__logo { position: absolute; left: 8%; bottom: 14%; width: 42%; color: var(--tinta); }
  .bd-tarjeta__raya { position: absolute; left: 8%; bottom: 8%; width: 10%; height: 2px; background: var(--brand); }

  /* La web */
  .bd-ap--web { width: calc(var(--u) * 52); }
  .bd-web { background: var(--noche); overflow: hidden; border-radius: calc(var(--u) * .6); }
  .bd-web__barra { display: flex; align-items: center; gap: calc(var(--u) * .7); height: calc(var(--u) * 3); padding: 0 calc(var(--u) * 1.4); background: #1B1410; }
  .bd-web__barra i { width: calc(var(--u) * .9); height: calc(var(--u) * .9); border-radius: 50%; background: rgba(231, 226, 218, .25); }
  .bd-web__barra span { flex: 1; height: calc(var(--u) * 1.1); margin-left: calc(var(--u) * 2); border-radius: 99px; background: rgba(231, 226, 218, .08); }
  .bd-web__dentro { position: relative; height: calc(var(--u) * 30); padding: calc(var(--u) * 3) calc(var(--u) * 3.4); color: var(--crema);
    background: radial-gradient(ellipse 50% 60% at 78% 60%, rgba(255, 143, 200, .3), transparent 70%), var(--noche); }
  .bd-web__logo { display: block; width: calc(var(--u) * 9); color: var(--crema); }
  .bd-web__t { margin: calc(var(--u) * 5) 0 0; max-width: 9ch; font-family: var(--serif); font-weight: 300; font-size: calc(var(--u) * 4.4); line-height: .95; letter-spacing: -.02em; }
  .bd-web__t em { color: var(--brand); }
  .bd-web__boton { display: block; width: calc(var(--u) * 11); height: calc(var(--u) * 2.6); margin-top: calc(var(--u) * 3); background: var(--crema); border-left: calc(var(--u) * .8) solid var(--brand); }
  .bd-web__iso { position: absolute; right: 9%; top: 34%; width: 30%; color: var(--brand); }

  /* El post */
  .bd-ap--post { width: calc(var(--u) * 28); }
  .bd-post { position: relative; aspect-ratio: 1; background: #F5CBD7; }
  .bd-post__iso { position: absolute; left: 50%; top: 46%; width: 64%; transform: translate(-50%, -50%); color: var(--marron); }
  .bd-post__logo { position: absolute; left: 50%; bottom: 9%; width: 30%; transform: translateX(-50%); color: var(--marron); }

  /* El sobre, con su sello */
  .bd-ap--sobre { width: calc(var(--u) * 36); }
  .bd-sobre { position: relative; aspect-ratio: 16 / 10; background: #EFEAE2; overflow: hidden; }
  .bd-sobre__solapa { position: absolute; inset: 0 0 38% 0; background: #E7E2DA; clip-path: polygon(0 0, 100% 0, 50% 100%); box-shadow: inset 0 -1px 0 rgba(25, 9, 0, .1); }
