---
// Tech: la maqueta del slider de innovaciones de orano.group (la referencia que eligió Álvaro
// el 30-oct), con lo nuestro: marca, letras, textos, sonido y código. Una innovación por pantalla, con su modelo en
// alambre (scripts/tech/escena.js); «Entrar» abre su artículo y el botón [+] su misión, que se hace con el ratón o el
// dedo. Lo mueve scripts/tech.js; aquí está lo que se ve sin él (los cuatro artículos, enteros).
import Base from '../../layouts/Base.astro';
import Marca from '../../components/Marca.astro';
import { TECH } from '../../data/tech.js';
const base = import.meta.env.BASE_URL;
const dos = (n: number) => String(n).padStart(2, '0');
const primero = TECH[0];
---
<Base
  titulo="Tech · adsPartners®"
  descripcion="Lo que construimos en adsPartners, para tocarlo: automatizaciones, asistentes de IA, software a medida e integraciones. Cada uno con una demo que haces tú."
>
  <main class="tec" data-tech data-vista="slider" data-lado="izq">
    <h1 class="oculto-accesible">Tech · adsPartners</h1>
    <canvas class="tec__lienzo" data-tec-lienzo aria-hidden="true"></canvas>
    <div class="tec__rejilla" aria-hidden="true"></div>

    <!-- Fijo: arriba, dónde estás y la vuelta; abajo, el logotipo, el sonido y el correo -->
    <p class="tec__donde"><span class="tec__barra" aria-hidden="true"></span><span>Tech · <span class="tec__marca">adsPartners</span></span></p>
    <a class="tec__volver" href={base} data-sonido-hover><span aria-hidden="true">◀</span> Página principal</a>
    <a class="tec__logo" href={base} aria-label="adsPartners, inicio" data-sonido-hover><Marca tipo="logo" /></a>
    <div class="tec__pie">
      <button class="tec__sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
        <span class="tec__ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="oculto-accesible" data-sonido-txt>Sonido off</span>
      </button>
      <a class="tec__correo" href="mailto:adsgroup@ads-partners.com" data-sonido-hover>Escríbenos a <b>adsgroup@</b></a>
    </div>

    <!-- El slider: una innovación por pantalla -->
    <section class="tec__slider" data-tec-slider data-glitch-capa="slider" aria-roledescription="carrusel" aria-label="Lo que construimos">
      <p class="tec__contador" aria-hidden="true">
        <span class="tec__cifra tec__cifra--ya" data-tec-a data-glitch>01</span><i></i><span class="tec__cifra" data-tec-b data-glitch>02</span>
      </p>
      <div class="tec__ficha" aria-live="polite">
        <p class="tec__servicio" data-tec-servicio data-glitch>{primero.servicio}</p>
        <h2 class="tec__titulo" data-tec-titulo data-glitch>{primero.titulo}</h2>
        <p class="tec__texto" data-tec-texto data-glitch>{primero.texto}</p>
        <button class="tec__entrar" type="button" data-tec-entrar data-sonido-hover><span data-glitch>Entrar</span></button>
      </div>
      <button class="tec__flecha tec__flecha--atras" type="button" aria-label="Anterior" data-tec-atras data-sonido-hover><span aria-hidden="true"></span></button>
      <button class="tec__flecha" type="button" aria-label="Siguiente" data-tec-sig data-sonido-hover><span aria-hidden="true"></span></button>
    </section>

    <!-- Dentro de una innovación: su artículo (todos están en el HTML; se enseña el de la que está delante) -->
    <div class="tec__dentro" data-tec-dentro data-glitch-capa="dentro" data-lenis-prevent>
      <div class="tec__puntos" data-tec-puntos aria-hidden="true"></div>
      {TECH.map((it, j) => (
        <article class="tec__art" data-tec-art={it.slug} id={it.slug} aria-labelledby={`art-${it.slug}`}>
          <header class="tec__art-cab">
            <p class="tec__baja" aria-hidden="true"><i></i>Baja para descubrir</p>
            <div class="tec__art-pres">
              <p class="tec__servicio" data-glitch>{dos(j + 1)} · {it.servicio}</p>
              <h2 class="tec__titulo" id={`art-${it.slug}`} data-glitch>{it.titulo}</h2>
              <p class="tec__texto" data-glitch>{it.entradilla || it.texto}</p>
            </div>
          </header>

          <section class="tec__bloque tec__intro">
            <p class="tec__num" aria-hidden="true" data-glitch>{dos(j + 1)}</p>
            <div class="tec__intro-txt">{it.articulo.intro.map((p) => <p>{p}</p>)}</div>
          </section>

          <section class="tec__bloque">
            <h3 class="tec__etq"><i></i>Lo que permite</h3>
            <ol class="tec__casillas">
              {it.articulo.permite.map((p, k) => <li><span class="tec__n">{k + 1}</span><p>{p}</p></li>)}
            </ol>
          </section>

          <section class="tec__bloque tec__grande">
            {it.articulo.cifras.length > 0 && (
              <dl class="tec__cifras">
                {it.articulo.cifras.map((c) => <div><dt data-glitch>{c.n}</dt><dd>{c.t}</dd></div>)}
              </dl>
            )}
            <p class="tec__frase" data-glitch>{it.articulo.frase}</p>
          </section>

          <section class="tec__bloque">
            <div class="tec__panel">
              <h3 class="tec__panel-t"><span class="tec__panel-ico" aria-hidden="true"></span>Ficha técnica</h3>
              <dl class="tec__ficha-tec">
                {it.articulo.ficha.map(([e, v]) => <div><dt>{e}</dt><dd>{v}</dd></div>)}
              </dl>
            </div>
          </section>

          <section class="tec__bloque">
            <h3 class="tec__etq"><i></i>Para qué te sirve</h3>
            <ol class="tec__casillas">
              {it.articulo.beneficios.map(([t, p], k) => <li><span class="tec__n">{k + 1}</span><b>{t}</b><p>{p}</p></li>)}
            </ol>
          </section>

          <footer class="tec__bloque tec__art-pie">
            <a class="tec__siguiente" href={`#${TECH[(j + 1) % TECH.length].slug}`} data-tec-siguiente data-sonido-hover>
              <span class="tec__servicio">Siguiente</span>
              <span class="tec__siguiente-t" data-glitch>{TECH[(j + 1) % TECH.length].titulo} <span aria-hidden="true">→</span></span>
            </a>
          </footer>
        </article>
      ))}
    </div>
    <div class="tec__botones" data-tec-botones>
      <button class="tec__circulo" type="button" aria-label="Cerrar" data-tec-cerrar data-sonido-hover><span class="tec__x" aria-hidden="true"></span></button>
      <button class="tec__circulo" type="button" aria-label="Hacer la misión" data-tec-abrir-mision data-sonido-hover><span class="tec__mas" aria-hidden="true">[+]</span></button>
    </div>

    <!-- La misión: la sala, la orden arriba, el gesto abajo, la leyenda a la izquierda y la explicación a la derecha -->
    <div class="tec__mision" data-tec-mision role="dialog" aria-modal="false" aria-label="Misión">
      <p class="tec__orden" data-tec-orden></p>
      <button class="tec__circulo tec__circulo--rosa tec__cerrar-m" type="button" aria-label="Cerrar la misión" data-tec-cerrar-m data-sonido-hover><span class="tec__x" aria-hidden="true"></span></button>
      <div class="tec__zona" data-tec-zona></div>
      <div class="tec__leyenda" data-tec-leyenda></div>
      <div class="tec__explica" data-tec-explica><i></i><p data-tec-explica-t></p></div>
      <p class="tec__gesto" data-tec-gesto></p>
    </div>
  </main>
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarTech } from '../../scripts/tech.js';
    arrancarPagina(montarTech);
  </script>
</Base>

<style>
  /* Una pantalla fija, como Orano: el slider no baja; el artículo baja dentro de su capa */
  :global(html.tech-fija), :global(html.tech-fija body) { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .tec {
    position: fixed; inset: 0; overflow: hidden;
    --lado: clamp(18px, 3.8vw, 56px);
    --arriba: clamp(18px, 4.6vh, 44px);
    --col: 23.1vw;          /* el ancho de cada columna de la rejilla de fondo (las líneas, en 15,4 / 38,5 / 61,6 / 84,7 %) */
    --tenue: rgba(231, 226, 218, .07);
    --circulo: 70px;
  }
  .tec__lienzo { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  /* La rejilla de 4 columnas, siempre detrás */
  .tec__rejilla {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(15.4% - .5px), var(--tenue) calc(15.4% - .5px), var(--tenue) calc(15.4% + .5px), transparent calc(15.4% + .5px)),
      linear-gradient(90deg, transparent calc(38.5% - .5px), var(--tenue) calc(38.5% - .5px), var(--tenue) calc(38.5% + .5px), transparent calc(38.5% + .5px)),
      linear-gradient(90deg, transparent calc(61.6% - .5px), var(--tenue) calc(61.6% - .5px), var(--tenue) calc(61.6% + .5px), transparent calc(61.6% + .5px)),
      linear-gradient(90deg, transparent calc(84.7% - .5px), var(--tenue) calc(84.7% - .5px), var(--tenue) calc(84.7% + .5px), transparent calc(84.7% + .5px)),
      linear-gradient(transparent calc(31.4% - .5px), var(--tenue) calc(31.4% - .5px), var(--tenue) calc(31.4% + .5px), transparent calc(31.4% + .5px)),
      linear-gradient(transparent calc(68.5% - .5px), var(--tenue) calc(68.5% - .5px), var(--tenue) calc(68.5% + .5px), transparent calc(68.5% + .5px));
  }

  /* Las letras: el título y las etiquetas, a máquina y espaciados (la Blender Pro de Orano); el texto, Open Sauce */
  .tec__servicio { margin: 0; font-family: var(--mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--rosa); }
  .tec__titulo {
    margin: 0; font-family: var(--mono); font-weight: 400; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.2;
    letter-spacing: .2em; text-transform: uppercase; color: var(--crema); white-space: nowrap;
  }
  .tec__titulo :global(.d) { opacity: .55; }
  .tec__texto { margin: 0; max-width: 395px; font-size: 15px; line-height: 1.85; color: var(--crema-2); }

  /* --- Fijo ---------------------------------------------------------------------------------------------------- */
  .tec__donde, .tec__volver, .tec__correo {
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2);
  }
  .tec__donde { position: absolute; left: var(--lado); top: var(--arriba); z-index: 6; margin: 0; display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .tec__barra { width: 4px; height: 18px; background: var(--rosa); }
  .tec__marca { text-transform: none; letter-spacing: .04em; }
  .tec__volver { position: absolute; right: var(--lado); top: var(--arriba); z-index: 6; transition: color .3s; }
  .tec__volver:hover, .tec__correo:hover { color: var(--crema); }
  .tec__logo { position: absolute; left: var(--lado); bottom: calc(var(--arriba) - 4px); z-index: 6; width: 128px; color: var(--crema); }
  .tec__pie { position: absolute; right: var(--lado); bottom: var(--arriba); z-index: 6; display: flex; align-items: center; gap: clamp(24px, 6vw, 110px); }
  .tec__correo { font-size: 10px; letter-spacing: .16em; }
  .tec__correo b { font-weight: 400; color: var(--crema); }
  /* El sonido: las barras, que se mueven si suena y se quedan planas si no (la onda de Orano) */
  .tec__sonido { display: block; padding: 6px; }
  .tec__ondas { display: flex; align-items: center; gap: 3px; height: 16px; }
  .tec__ondas i { width: 2px; height: 3px; background: var(--crema); transition: height .3s var(--curva); }
  :global(html.sonido-on) .tec__ondas i { animation: tec-onda 1.1s ease-in-out infinite; }
  :global(html.sonido-on) .tec__ondas i:nth-child(2) { animation-delay: -.3s; }
  :global(html.sonido-on) .tec__ondas i:nth-child(3) { animation-delay: -.7s; }
  :global(html.sonido-on) .tec__ondas i:nth-child(4) { animation-delay: -.5s; }
  @keyframes tec-onda { 0%, 100% { height: 3px; } 50% { height: 15px; } }

  /* --- El slider ----------------------------------------------------------------------------------------------- */
  .tec__slider { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .tec__slider > * { pointer-events: auto; }
  /* El contador, en su caja rayada: el número de ahora en rosa */
  .tec__contador {
    position: absolute; left: 53%; top: calc(var(--arriba) + 66px); transform: translateX(-50%); margin: 0;
    display: flex; align-items: center; gap: 14px; padding: 17px 56px;
    background: repeating-linear-gradient(-45deg, rgba(231, 226, 218, .07) 0 1px, transparent 1px 6px);
    font-family: var(--mono); font-size: 13px; letter-spacing: .14em; color: var(--crema-3);
  }
  .tec__contador i { width: 30px; height: 1px; background: var(--crema-2); }
  .tec__cifra { display: inline-block; }
  .tec__cifra--ya { color: var(--rosa); }
  .tec__ficha { position: absolute; left: 55%; top: 33.5%; width: min(400px, 36vw); }
  .tec__ficha .tec__servicio { margin-bottom: 12px; }
  .tec__ficha .tec__texto { margin-top: 26px; }
  /* «Entrar»: crema con su borde rosa; nace de la barrita rosa (tech.js) */
  .tec__entrar {
    position: relative; margin-top: 52px; width: 230px; height: 50px; padding-left: 37px; text-align: left;
    font-family: var(--mono); font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--tinta);
    background: var(--crema); border-left: 9px solid var(--rosa); transform-origin: left center;
    transition: background .3s var(--curva);
  }
  .tec__entrar:hover { background: #fff; }
  .tec__flecha {
    position: absolute; right: calc(var(--lado) + 8px); top: 50%; width: var(--circulo); height: var(--circulo); margin-top: calc(var(--circulo) / -2);
    border: 1px solid rgba(231, 226, 218, .4); border-radius: 50%; transition: border-color .3s, transform .5s var(--curva);
  }
  .tec__flecha:hover { border-color: var(--crema); transform: scale(1.06); }
  .tec__flecha span { position: absolute; left: 50%; top: 50%; width: 30px; height: 1px; margin-left: -15px; background: var(--crema); }
  .tec__flecha span::after { content: ''; position: absolute; right: 0; top: -2px; border-left: 5px solid var(--crema); border-top: 2.5px solid transparent; border-bottom: 2.5px solid transparent; }
  .tec__flecha--atras { right: auto; left: calc(var(--lado) + 8px); }
  .tec__flecha--atras span { transform: scaleX(-1); }
  .tec__flecha[hidden] { display: none; }

  /* El modelo espera a la derecha en las impares: el texto se va al otro lado (y el contador con él) */
  @media (min-width: 761px) {
    .tec[data-lado='der'] .tec__ficha { left: auto; right: 55%; }
    .tec[data-lado='der'] .tec__contador { left: 47%; }
  }

  /* --- Dentro: el artículo baja en su capa; la primera pantalla deja ver el modelo --------------------------------- */
  .tec__dentro {
    position: absolute; inset: 0; z-index: 4; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain;
    visibility: hidden; opacity: 0; scrollbar-width: none;
  }
  .tec__dentro::-webkit-scrollbar { display: none; }
  .tec__art { display: none; }
  .tec__art.es-actual { display: block; }
  .tec__art-cab { position: relative; height: 100vh; height: 100svh; }
  .tec__baja {
    position: absolute; left: 20.8%; top: 42%; margin: 0;
    font-family: var(--mono); font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--rosa);
  }
  .tec__baja i { position: absolute; left: calc(15.4vw - 20.8vw); top: -60px; width: 1px; height: 125px; background: var(--rosa); transform-origin: top; }
  .tec__baja i::after { content: ''; position: absolute; left: -2px; bottom: 0; border-top: 5px solid var(--rosa); border-left: 2.5px solid transparent; border-right: 2.5px solid transparent; }
  .tec__art-pres { position: absolute; left: 20.8%; top: 63%; width: min(420px, 34vw); }
  .tec__art-pres .tec__texto { margin-top: 22px; }
  .tec__art-pres .tec__servicio { margin-bottom: 10px; }
  /* Si el modelo esperaba a la derecha, al entrar se va a la izquierda: el título y «baja para descubrir», a la derecha */
  @media (min-width: 761px) {
    .tec[data-lado='der'] .tec__art-pres { left: auto; right: 20.8%; }
    .tec[data-lado='der'] .tec__baja { left: auto; right: 20.8%; }
    .tec[data-lado='der'] .tec__baja i { left: auto; right: -5.4vw; }
    .tec[data-lado='der'] .tec__botones { right: auto; left: calc(var(--lado) + 75px); }
  }

  /* Los bloques del artículo, sobre el fondo, en la rejilla de 4 columnas */
  .tec__bloque { position: relative; padding: clamp(60px, 11vh, 120px) 15.4vw; background: var(--noche); }
  .tec__intro { display: grid; grid-template-columns: 23.1vw 1fr; align-items: start; gap: 0; }
  .tec__num { margin: 0; font-family: var(--mono); font-size: clamp(90px, 11vw, 170px); line-height: .8; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1px rgba(231, 226, 218, .35); }
  .tec__intro-txt { max-width: 560px; }
  .tec__intro-txt p { margin: 0 0 1.4em; font-size: 15px; line-height: 1.85; color: var(--crema-2); }
  .tec__intro-txt p:first-child { font-size: clamp(18px, 1.5vw, 22px); line-height: 1.55; color: var(--crema); }
  .tec__etq { margin: 0 0 44px; display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-weight: 400; font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--rosa); }
  .tec__etq i { width: 46px; height: 1px; background: var(--rosa); }
  .tec__casillas { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: 23.1vw; row-gap: 56px; }
  .tec__casillas li { position: relative; padding: 28px 54px 0 34px; border-top: 1px solid rgba(231, 226, 218, .5); }
  .tec__casillas b { display: block; margin-bottom: 8px; font-family: var(--mono); font-weight: 400; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--crema); }
  .tec__casillas p { margin: 0; font-size: 14px; line-height: 1.75; color: var(--crema-2); }
  .tec__n { position: absolute; right: 0; top: -1px; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--rosa); font-family: var(--mono); font-size: 13px; color: var(--rosa); }
  .tec__grande { display: grid; grid-template-columns: auto 1fr; gap: 8vw; align-items: center; }
  .tec__cifras { margin: 0; display: grid; gap: 34px; }
  .tec__cifras div { display: flex; align-items: baseline; gap: 18px; }
  .tec__cifras dt { font-family: var(--mono); font-size: clamp(44px, 4.6vw, 68px); line-height: 1; letter-spacing: -.02em; color: var(--crema); }
  .tec__cifras dd { margin: 0; max-width: 16ch; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2); }
  .tec__frase { grid-column: 2; margin: 0; max-width: 18ch; font-family: var(--mono); font-size: clamp(22px, 2.2vw, 32px); line-height: 1.45; letter-spacing: .2em; text-transform: uppercase; color: var(--crema); }
  .tec__panel { padding: 0 0 56px; background: var(--noche-2); }
  .tec__panel-t { margin: 0; padding: 30px; display: flex; justify-content: center; align-items: center; gap: 16px; border-bottom: 1px solid var(--tenue); font-family: var(--mono); font-weight: 400; font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--crema-2); }
  .tec__panel-ico { width: 20px; height: 15px; border: 1px solid var(--crema-3); position: relative; }
  .tec__panel-ico::after { content: ''; position: absolute; left: 5px; top: 3px; width: 7px; height: 7px; border: 1px solid var(--crema-3); border-radius: 50%; }
  .tec__ficha-tec { margin: 0; padding: 56px 6% 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 46px 5%; }
  .tec__ficha-tec dt { margin-bottom: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--rosa); }
  .tec__ficha-tec dd { margin: 0; font-size: 13px; line-height: 1.65; color: var(--crema-2); }
  .tec__art-pie { padding-bottom: 22vh; }
  .tec__siguiente { display: inline-flex; flex-direction: column; gap: 14px; }
  .tec__siguiente-t { font-family: var(--mono); font-size: clamp(30px, 3.4vw, 52px); letter-spacing: .2em; text-transform: uppercase; transition: color .3s, letter-spacing .6s var(--curva); }
  .tec__siguiente:hover .tec__siguiente-t { color: var(--rosa); letter-spacing: .26em; }

  /* Los círculos sobre el modelo (tech.js los coloca); al pasar, la etiqueta del inspector */
  .tec__puntos { position: fixed; inset: 0; z-index: 2; pointer-events: none; }
  .tec__puntos :global(.tec__punto) {
    position: absolute; left: 0; top: 0; width: 46px; height: 46px; margin: -23px 0 0 -23px; border: 1.5px solid var(--crema); border-radius: 50%;
    pointer-events: auto; transition: border-color .3s, opacity .4s; will-change: transform;
  }
  .tec__puntos :global(.tec__punto::after) { content: ''; position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; margin: -2px; border-radius: 50%; background: var(--crema); }
  .tec__puntos :global(.tec__punto .insp) { position: absolute; left: 54px; top: 50%; transform: translateY(-50%); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .tec__puntos :global(.tec__punto:hover) { border-color: var(--rosa); }
  .tec__puntos :global(.tec__punto:hover .insp) { opacity: 1; }

  /* La X y el [+]: dentro, a la derecha, como en Orano */
  .tec__botones { position: absolute; right: calc(var(--lado) + 75px); top: calc(var(--arriba) + 76px); z-index: 7; display: grid; gap: 16px; visibility: hidden; opacity: 0; }
