---
// Esbozo de la página de cada proyecto: de momento solo dice que está en construcción y vuelve a la home.
// Las de verdad (su fuera y su dentro) se hacen en la Fase 3.
import Base from '../../layouts/Base.astro';
import { PROYECTOS } from '../../data/proyectos.js';

export function getStaticPaths() {
  return PROYECTOS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base titulo={`${p.nombre} — adsPartners®`} descripcion={p.texto}>
  <main class="esbozo">
    <p class="mono esbozo__etq">( Proyecto · {[p.rama, p.anio].filter(Boolean).join(' · ')} )</p>
    <h1 class="esbozo__titulo">{p.nombre}</h1>
    <p class="esbozo__linea">{p.linea}</p>
    <p class="mono esbozo__aviso">Esta página está en construcción.</p>
    <a class="esbozo__volver" href={`${base}#proyectos`}>← Volver a los proyectos</a>
  </main>
</Base>

<style>
  .esbozo { min-height: 100vh; display: grid; align-content: center; gap: 18px; padding: var(--margen); max-width: 1100px; margin: 0 auto; }
  .esbozo__etq, .esbozo__aviso { margin: 0; color: var(--crema-3); }
  .esbozo__titulo { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(48px, 9vw, 150px); line-height: .9; letter-spacing: -.03em; }
  .esbozo__linea { margin: 0 0 30px; font-family: var(--serif); font-style: italic; font-size: clamp(22px, 2.4vw, 36px); color: var(--rosa); }
  .esbozo__volver { justify-self: start; padding: 12px 20px; border: 1px solid var(--crema); border-radius: 99px; }
  .esbozo__volver:hover { background: var(--crema); color: var(--tinta); }
</style>
