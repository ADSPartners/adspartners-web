---
import Base from '../layouts/Base.astro';
import Fondo from '../components/Fondo.astro';
import Umbral from '../components/Umbral.astro';
import Cabecera from '../components/Cabecera.astro';
import Menu from '../components/Menu.astro';
import Portada from '../components/Portada.astro';
import QueSomos from '../components/QueSomos.astro';
import Partners from '../components/Partners.astro';
import Proyectos from '../components/Proyectos.astro';
import Transicion from '../components/Transicion.astro';
import Contacto from '../components/Contacto.astro';
import Fresa from '../components/Fresa.astro';
import Cursor from '../components/Cursor.astro';
import { ORG_ID } from '../data/schema.js';
const base = import.meta.env.BASE_URL;
---
<!-- El título lleva lo que se busca (branding, Madrid); al compartir en redes sale el lema -->
<Base
  umbral
  titulo="adsPartners® · Estudio de branding y tecnología en Madrid"
  ogTitulo="adsPartners® · Brand por fuera. Tech por dentro."
  descripcion="Branding, diseño web, automatizaciones, asistentes de IA y software a medida en Madrid. Marca y tecnología en el mismo equipo, de la idea al último detalle."
  pagina={{ about: { '@id': ORG_ID } }}
>
  <Fondo />
  <Umbral />
  <Cabecera />
  <Menu />
  <main>
    <Portada />
    <QueSomos />
    <Partners />
    <Proyectos />
    <Transicion />
    <Contacto />
    <Fresa />
  </main>
  <Cursor />
  <script define:vars={{ base }} is:inline>window.ADS_BASE = base;</script>
  <script>
    import { arrancar } from '../scripts/app.js';
    arrancar();
  </script>
</Base>
