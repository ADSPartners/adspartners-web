---
// La home. ADS_CONCEPTO elige la idea de la portada para comparar las tres en la copia de prueba:
// pincel (por defecto, «Marca por fuera. Máquina por dentro.»), objeto (isotipo de cristal) o fresa (FRESA guía).
import Base from '../layouts/Base.astro';
import Umbral from '../components/Umbral.astro';
import Cabecera from '../components/Cabecera.astro';
import Portada from '../components/Portada.astro';
import Idea from '../components/Idea.astro';
import Hacemos from '../components/Hacemos.astro';
import PorQue from '../components/PorQue.astro';
import ParaQuien from '../components/ParaQuien.astro';
import Pie from '../components/Pie.astro';
import Cursor from '../components/Cursor.astro';
import CursorFresa from '../components/CursorFresa.astro';

const concepto = (['pincel', 'objeto', 'fresa'].includes(process.env.ADS_CONCEPTO) ? process.env.ADS_CONCEPTO : 'pincel') as 'pincel' | 'objeto' | 'fresa';
const base = import.meta.env.BASE_URL;
---
<Base
  titulo="adsPartners® · Marca por fuera. Máquina por dentro."
  descripcion="Estudio de marca y tecnología en Madrid: identidad, webs con una idea propia, automatización, asistentes de IA y software a medida. El mismo equipo, de principio a fin."
  concepto={concepto}
>
  <Umbral />
  <Cabecera />
  {concepto === 'objeto' && <canvas class="escena" data-escena aria-hidden="true"></canvas>}
  <main>
    <Portada concepto={concepto} />
    <Idea />
    <Hacemos />
    <PorQue />
    <ParaQuien />
  </main>
  <Pie />
  {concepto === 'fresa' ? <CursorFresa /> : <Cursor />}
  <script define:vars={{ base, concepto }} is:inline>window.ADS_BASE = base; window.ADS_CONCEPTO = concepto;</script>
  <script>
    import { arrancar } from '../scripts/app.js';
    arrancar();
  </script>
</Base>

<style>
  .escena { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0; transition: opacity 1.2s cubic-bezier(.22, 1, .36, 1); }
  :global(html.gl-activo) .escena { opacity: 1; }
</style>
