---
import Base from '../layouts/Base.astro';
import Fondo from '../components/Fondo.astro';
import Umbral from '../components/Umbral.astro';
import Cabecera from '../components/Cabecera.astro';
import Portada from '../components/Portada.astro';
import QueSomos from '../components/QueSomos.astro';
import Partners from '../components/Partners.astro';
import Proyectos from '../components/Proyectos.astro';
import Transicion from '../components/Transicion.astro';
import Contacto from '../components/Contacto.astro';
import Fresa from '../components/Fresa.astro';
import Cursor from '../components/Cursor.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  umbral
  titulo="adsPartners® · Brand por fuera. Tech por dentro."
  descripcion="Estudio de marca y tecnología en Madrid: identidad, webs con una idea propia, automatización, asistentes de IA y software a medida. El mismo equipo, de principio a fin."
>
  <Fondo />
  <Umbral />
  <Cabecera />
  <main>
    <Portada />
    <QueSomos />
    <Partners />
    <Proyectos />
    <Transicion />
    <Contacto />
    <Fresa />
  </main>
  <Cursor />
  <script define:vars={{ base }} is:inline>window.ADS_BASE = base;</script>
  <script>
    import { arrancar } from '../scripts/app.js';
    arrancar();
  </script>
</Base>
