---
// PROTOTIPO, de usar y tirar (02-nov). Tres direcciones para la página Brand de la web v5: ?v=a, ?v=b, ?v=c.
// La pregunta: ¿cómo debería verse Brand para que pegue con el resto de la web? (el paisaje a lo Emotion se descartó:
// «no pega con la web»). Cada variante es solo la portada y la primera sección. La que se elija se construye de cero
// en src/pages/brand/; este código se queda aquí y se borra.
//   A · El inspector: una pieza de nuestra marca, y el inspector de la portada enseña las decisiones que hay debajo.
//   B · Desmontada: al bajar, la marca se despieza en capas, en plano técnico con cotas.
//   C · Una regla, en todas partes: un muro de piezas de la marca que pasan de cada una a su aire a «con sistema».
import Base from '../../layouts/Base.astro';
import Cursor from '../../components/Cursor.astro';
import Marca from '../../components/Marca.astro';

const base = import.meta.env.BASE_URL;
---
<Base titulo="Brand · prototipo · adsPartners®" descripcion="Prototipo de la página Brand: tres direcciones para elegir.">
  <!-- Fijo, como en Tech: dónde estás, la hora de aquí y la vuelta; abajo, el logotipo -->
  <p class="pr-donde"><span class="pr-barra" aria-hidden="true"></span><span>Brand · <span class="pr-marca">adsPartners</span></span></p>
  <div class="pr-arriba">
    <p class="pr-madrid" aria-hidden="true">Desde Madrid <span class="pr-hora" data-pr-hora></span></p>
    <a class="pr-volver" href={base}><span aria-hidden="true">◀</span> Página principal</a>
  </div>

  <main class="pr" data-proto data-cursor="manual"></main>

  <!-- La pastilla del prototipo: no es parte del diseño -->
  <nav class="pr-pastilla" aria-label="Variantes del prototipo">
    <button type="button" data-pr-ant aria-label="Anterior">‹</button>
    <span data-pr-etq>A · El inspector</span>
    <button type="button" data-pr-sig aria-label="Siguiente">›</button>
  </nav>

  <template data-pr-iso><Marca tipo="iso" /></template>
  <template data-pr-logo><Marca tipo="logo" /></template>
  <Cursor />
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarPrototipo } from '../../scripts/brand-prototipo/pastilla.js';
    arrancarPagina(montarPrototipo);
  </script>
</Base>

<style is:global>
  @font-face { font-family: 'Quetine'; src: url('/assets/fonts/Quetine.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  /* (otra vez las de global.css: en la copia de prueba Astro mete ese CSS sin la carpeta y salen en Georgia) */
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Apple Garamond'; src: url('/assets/fonts/AppleGaramond-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Open Sauce'; src: url('/assets/fonts/OpenSauceSans-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }

  /* El cursor, sin el logotipo dentro (a Álvaro le distrae): solo el aro */
  .cursor__iso { display: none; }
  .pr { --pr-texto: var(--crema); --lado: clamp(18px, 2.4vw, 36px); --arriba: clamp(18px, 2.6vh, 30px); position: relative; min-height: 100vh; }
  html { --pr-barra-color: var(--crema-2); }

  /* --- Fijo ---------------------------------------------------------------------------------------------------- */
  .pr-donde, .pr-madrid, .pr-volver {
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--pr-barra-color);
    transition: color .6s var(--curva);
  }
  .pr-donde { position: fixed; left: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; margin: 0; display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .pr-barra { width: 4px; height: 18px; background: var(--rosa); }
  .pr-marca { text-transform: none; letter-spacing: .04em; }
  .pr-arriba { position: fixed; right: clamp(18px, 2.4vw, 36px); top: clamp(18px, 2.6vh, 30px); z-index: 40; height: 18px; display: flex; align-items: center; gap: 30px; }
  .pr-madrid { margin: 0; pointer-events: none; }
  .pr-hora { margin-left: 6px; opacity: .58; font-variant-numeric: tabular-nums; }

  /* --- La pastilla ---------------------------------------------------------------------------------------------- */
  .pr-pastilla {
    position: fixed; left: 50%; bottom: 18px; z-index: 80; transform: translateX(-50%);
    display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 999px;
    background: rgba(20, 16, 14, .9); color: #EDE8E1; box-shadow: 0 8px 28px rgba(0, 0, 0, .28);
    font: 500 12px/1 system-ui, sans-serif; letter-spacing: .01em; user-select: none;
  }
  .pr-pastilla span { min-width: 210px; text-align: center; }
  .pr-pastilla button { width: 30px; height: 30px; border-radius: 50%; color: inherit; font-size: 18px; line-height: 1; cursor: pointer; }
  .pr-pastilla button:hover { background: rgba(255, 255, 255, .1); }

  @media (max-width: 760px) {
    .pr-madrid { display: none; }
    .pr-pastilla span { min-width: 150px; font-size: 11px; }
  }
</style>
