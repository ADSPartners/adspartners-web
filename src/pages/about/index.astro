    display: flex; align-items: center; gap: 14px; padding: 13px 44px; color: var(--crema-3); letter-spacing: .14em;
    background: repeating-linear-gradient(-45deg, rgba(231, 226, 218, .07) 0 1px, transparent 1px 6px);
