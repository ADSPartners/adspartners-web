---
// About («About · adsPartners»): los dos que hacemos ads. La idea es de Álvaro (29-oct): arriba, los dos; al bajar,
// dos montones de fotos de vida, el de Sebas (brand) y el de Álvaro (tech), que se van superponiendo; al final, una sola
// foto de los dos. Con ratón, la escena se queda fija y cada tramo de scroll es un capítulo: las fotos de Sebas caen
// como copias en papel, las de Álvaro se montan a píxeles y el inspector las mide, y los dos montones se acercan
// hasta juntarse en el marco del final. Sin ratón, sin JS o con «movimiento reducido», los capítulos se leen uno
// detrás de otro. Lo mueve scripts/about.js; los textos y las fotos están en src/data/about.js.
// La foto de los dos va en el marco del inspector, arriba (el collage de oficina, hecho con ChatGPT) y al final (un
// selfie de verdad); en public/assets/about/los-dos-*.webp, a 1440 px para que el marco salga nítido.
import Base from '../../layouts/Base.astro';
import Fondo from '../../components/Fondo.astro';
import Marca from '../../components/Marca.astro';
import EnlacesWeb from '../../components/EnlacesWeb.astro';
import { PERSONAS, CAPITULOS, CIERRE } from '../../data/about.js';
import { ORG_ID, PERSONAS as PERSONAS_SCHEMA } from '../../data/schema.js';
const base = import.meta.env.BASE_URL;
const dos = (n: number) => String(n).padStart(2, '0');
const foto = (src: string) => `${base}assets/about/${src}`;
// Cada foto lleva variantes más pequeñas al lado (<nombre>-<ancho>.webp): el navegador baja la que le basta
const variantes = (src: string, anchos: number[], maximo: number) =>
  [...anchos.map((w) => `${foto(src.replace('.webp', `-${w}.webp`))} ${w}w`), `${foto(src)} ${maximo}w`].join(', ');
const TAM_CAPITULO = '(max-width: 760px) 48vw, 26vw';
---
<Base
  titulo="Quiénes somos: Sebas y Álvaro · adsPartners®"
  descripcion="Somos dos: Sebas, en la marca, y Álvaro, en la tecnología. De dónde venimos y cómo acabamos montando un estudio en Madrid, en cinco capítulos y diez fotos."
  tipoPagina="AboutPage"
  miga="About"
  pagina={{ about: [{ '@id': ORG_ID }, ...PERSONAS_SCHEMA.map((p) => ({ '@id': p['@id'] }))], mainEntity: { '@id': ORG_ID } }}
  schema={PERSONAS_SCHEMA}
>
  <script is:inline>
    // Antes de pintar: con ratón y sin «movimiento reducido», los montones van en escena fija
    (function () { var h = document.documentElement; if (h.classList.contains('con-raton') && !h.classList.contains('mov-reducido')) h.classList.add('ab-escena'); })();
  </script>
  <Fondo papel />
  <main class="ab" data-about>
    <h1 class="oculto-accesible">Quiénes somos: Sebas, en la marca, y Álvaro, en la tecnología</h1>
    <!-- El fondo, partido en dos: la mitad de Sebas es papel (brand); la de Álvaro, la rejilla y los glifos (tech). Con
         ratón lo pinta el fondo vivo (gl/fondo.js, data-papel); esto es el papel quieto, para cuando no lo hay -->
    <div class="ab__mitad" aria-hidden="true"></div>
    <!-- Lo que tiene un pliego de imprenta, en el lado de la marca: la marca de registro y la carta de colores de ads -->
    <div class="ab__imprenta" aria-hidden="true">
      <span class="ab__registro"></span>
      <span class="ab__carta">
        <i style="--c: #F5CBD7"></i><i style="--c: #E7E2DA"></i><i style="--c: #190900"></i><i style="--c: #120D0A"></i>
        <span>Rosa · Crema · Tinta · Noche</span>
      </span>
    </div>

    <!-- Fijo, como en Tech: dónde estás; a la derecha, la hora de aquí, el sonido y la vuelta; abajo, el logo y el correo -->
    <p class="ab__donde"><span class="ab__barra" aria-hidden="true"></span><span>About · <span class="ab__marca">adsPartners</span></span></p>
    <div class="ab__arriba">
      <p class="ab__madrid" aria-hidden="true">Desde Madrid <span class="ab__hora" data-ab-hora></span></p>
      <button class="ab__sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
        <span class="ab__ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="oculto-accesible" data-sonido-txt>Sonido off</span>
      </button>
      <a class="ab__volver" href={base} data-sonido-hover><span aria-hidden="true">◀</span> Página principal</a>
    </div>
    <a class="ab__logo" href={base} aria-label="adsPartners, inicio" data-sonido-hover><Marca tipo="logo" /></a>
    <a class="ab__correo" href="mailto:adsgroup@ads-partners.com" data-sonido-hover>Escríbenos a <b>adsgroup@</b></a>

    <!-- 1. Arriba: los dos, a cada lado de su foto -->
    <section class="ab__portada" aria-label="Quiénes somos">
      <p class="ab__nombre ab__nombre--sebas" data-tinta>{PERSONAS.sebas.nombre}</p>
      <figure class="ab__marco ab__marco--portada" data-ab-marco>
        <img class="ab__marco-img" src={foto('los-dos-portada.webp')} srcset={variantes('los-dos-portada.webp', [480, 800], 1440)} sizes="(max-width: 760px) 92vw, min(38vw, 620px)" width="1440" height="960" alt="Sebas y Álvaro en traje, en una oficina: un collage con las cabezas más grandes que el cuerpo, hecho con ChatGPT." decoding="async" fetchpriority="high" />
        <span class="ab__guia ab__guia--a" aria-hidden="true"></span>
        <span class="ab__guia ab__guia--b" aria-hidden="true"></span>
        <span class="insp ab__marco-insp" aria-hidden="true">img · los dos</span>
        <span class="ab__cota" data-ab-cota aria-hidden="true"></span>
      </figure>
      <p class="ab__nombre ab__nombre--alvaro" data-vivo>{PERSONAS.alvaro.nombre}</p>
      <div class="ab__intro">
        <p class="ab__etq mono">( About · de dónde venimos )</p>
        <p>adsPartners somos dos. Sebas diseña cómo se ve tu empresa y Álvaro construye lo que la hace funcionar por dentro. Esto es lo que traía cada uno antes de juntarnos.</p>
      </div>
      <p class="ab__baja ab__dos mono" aria-hidden="true"><i></i>Baja</p>
    </section>

    <!-- 2. Los dos montones: un capítulo por pantalla, con una foto de cada uno -->
    <section class="ab__montones" data-ab-montones aria-label="De dónde venimos">
      <div class="ab__escena" data-ab-escena>
        <p class="ab__contador ab__dos mono" aria-hidden="true"><span data-ab-actual>01</span><i></i><span>{dos(CAPITULOS.length)}</span></p>
        <p class="ab__quien ab__quien--sebas" aria-hidden="true"><span class="ab__quien-n" data-tinta>{PERSONAS.sebas.nombre}</span><span class="mono">{PERSONAS.sebas.lado}</span></p>
        <p class="ab__quien ab__quien--alvaro" aria-hidden="true"><span class="ab__quien-n">{PERSONAS.alvaro.nombre}</span><span class="mono">{PERSONAS.alvaro.lado}</span></p>
        <div class="ab__pila ab__pila--sebas" data-ab-pila="sebas"></div>
        <div class="ab__pila ab__pila--alvaro" data-ab-pila="alvaro"></div>

        {CAPITULOS.map((c, j) => (
          <article class="ab__cap" data-ab-cap={j} aria-labelledby={`cap-${j}`}>
            <h2 class="ab__cap-t ab__dos" id={`cap-${j}`}><span class="ab__cap-n mono">{dos(j + 1)}</span><span>{c.titulo}</span></h2>

            <figure class="ab__foto ab__foto--sebas" data-ab-foto="sebas" data-ab-i={j}>
              <div class="ab__papel">
                <img src={foto(c.sebas.foto.src)} srcset={variantes(c.sebas.foto.src, [400, 800], 900)} sizes={TAM_CAPITULO} width="900" height={c.sebas.foto.alto} alt={`Sebas. ${c.sebas.foto.pie}`} loading="lazy" decoding="async" data-ab-img />
              </div>
              <figcaption class="ab__pie ab__pie--sebas">
                {c.sebas.foto.pie}
                {c.sebas.foto.nota && <span class="ab__pie-nota">{c.sebas.foto.nota}</span>}
                {c.sebas.foto.cuando
                  ? <span class="ab__pie-dato">{[c.sebas.foto.donde, c.sebas.foto.cuando].filter(Boolean).join(' · ')}</span>
                  : <span class="ab__hueco-mini mono">Sitio y año · pendiente</span>}
              </figcaption>
            </figure>

            <figure class="ab__foto ab__foto--alvaro" data-ab-foto="alvaro" data-ab-i={j}>
              <div class="ab__papel">
                <img src={foto(c.alvaro.foto.src)} srcset={variantes(c.alvaro.foto.src, [400, 800], 900)} sizes={TAM_CAPITULO} width="900" height={c.alvaro.foto.alto} alt={`Álvaro. ${c.alvaro.foto.pie}, ${c.alvaro.foto.donde}, ${c.alvaro.foto.cuando}.`} loading="lazy" decoding="async" data-ab-img />
                <canvas class="ab__pix" data-ab-pix aria-hidden="true"></canvas>
                <span class="ab__caja" aria-hidden="true"><i></i><i></i></span>
                <span class="insp ab__insp" data-ab-insp aria-hidden="true">{c.alvaro.foto.src}</span>
                <span class="ab__paleta" data-ab-paleta aria-hidden="true"></span>
                <span class="ab__cota ab__cota--foto" data-ab-cota aria-hidden="true"></span>
              </div>
              <figcaption class="ab__pie ab__pie--alvaro">
                <dl>
                  <div><dt>Qué</dt><dd>{c.alvaro.foto.pie}</dd></div>
                  <div><dt>Dónde</dt><dd>{c.alvaro.foto.donde}</dd></div>
                  <div><dt>Cuándo</dt><dd>{c.alvaro.foto.cuando}</dd></div>
                  {c.alvaro.foto.nota && <div><dt>Nota</dt><dd>{c.alvaro.foto.nota}</dd></div>}
                </dl>
              </figcaption>
            </figure>

            <div class="ab__txt ab__txt--sebas">
              <p class="ab__txt-quien"><span class="ab__quien-n">{PERSONAS.sebas.nombre}</span></p>
              {c.sebas.texto
                ? <p class="ab__txt-p">{c.sebas.texto}</p>
                : <p class="ab__hueco"><span class="mono">Pendiente · lo cuenta Sebas</span>{c.sebas.pregunta}</p>}
            </div>
            <div class="ab__txt ab__txt--alvaro">
              <p class="ab__txt-quien"><span class="ab__quien-n">{PERSONAS.alvaro.nombre}</span></p>
              <p class="ab__txt-p" data-ab-cifrado>{c.alvaro.texto}</p>
            </div>
          </article>
        ))}

        <!-- El final de los montones: los dos se juntan en una sola foto -->
        <figure class="ab__marco ab__marco--final" data-ab-marco data-ab-final>
          <img class="ab__marco-img" src={foto('los-dos-final.webp')} srcset={variantes('los-dos-final.webp', [480, 800], 1440)} sizes="(max-width: 760px) 92vw, min(46vw, 720px)" width="1440" height="960" alt="Sebas y Álvaro, juntos en un selfie." loading="lazy" decoding="async" />
          <span class="ab__guia ab__guia--a" aria-hidden="true"></span>
          <span class="ab__guia ab__guia--b" aria-hidden="true"></span>
          <span class="insp ab__marco-insp" aria-hidden="true">img · los dos</span>
          <span class="ab__cota" data-ab-cota aria-hidden="true"></span>
        </figure>
      </div>
    </section>

    <!-- 3. Lo que hace cada uno, y la puerta -->
    <section class="ab__cierre" aria-labelledby="cierre-t">
      <h2 class="ab__etq mono" id="cierre-t">( Lo que hace cada uno )</h2>
      <div class="ab__cols">
        <div class="ab__col ab__col--sebas">
          <p class="ab__txt-quien"><span class="ab__quien-n">{PERSONAS.sebas.nombre}</span><span class="mono">{PERSONAS.sebas.lado}</span></p>
          {CIERRE.sebas.texto
            ? <p class="ab__txt-p">{CIERRE.sebas.texto}</p>
            : <p class="ab__hueco"><span class="mono">Pendiente · lo cuenta Sebas</span>{CIERRE.sebas.pregunta}</p>}
        </div>
        <div class="ab__col ab__col--alvaro">
          <p class="ab__txt-quien"><span class="ab__quien-n">{PERSONAS.alvaro.nombre}</span><span class="mono">{PERSONAS.alvaro.lado}</span></p>
          <p class="ab__txt-p">{CIERRE.alvaro.texto}</p>
        </div>
      </div>
      <p class="ab__frase ab__frase--a" data-tinta>Por separado, cada uno hace bien lo suyo.</p>
      <p class="ab__frase ab__frase--b ab__dos"><em>Juntos, lo que ninguno haría solo.</em></p>
      <a class="ab__hablemos" href={`${base}#contacto`} data-sonido-hover data-iman><span>Hablemos</span> <span aria-hidden="true">→</span></a>
      <div class="ab__enlaces ab__dos"><EnlacesWeb actual="about" /></div>
    </section>
  </main>
  <script>
    import { arrancarPagina } from '../../scripts/pagina.js';
    import { montarAbout } from '../../scripts/about.js';
    arrancarPagina(montarAbout);
  </script>
</Base>

<style>
  .ab {
    position: relative;
    --lado: clamp(18px, 3.8vw, 56px);
    --arriba: clamp(18px, 4.6vh, 44px);
    --tenue: rgba(231, 226, 218, .07);
    --foto-w: clamp(190px, min(18vw, 33vh), 330px);
  }
  /* Los signos del texto de Álvaro mientras se descifra (about.js) */
  .ab :global(.ab__ruido) { color: var(--rosa); }
  .ab__marca { text-transform: none; letter-spacing: .04em; }

  /* --- Fijo (lo mismo que Tech) ----------------------------------------------------------------------------------- */
  .ab__donde, .ab__madrid, .ab__volver, .ab__correo {
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--crema-2);
  }
  .ab__donde { position: fixed; left: var(--lado); top: var(--arriba); z-index: 20; margin: 0; display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .ab__barra { width: 4px; height: 18px; background: var(--rosa); }
  .ab__arriba { position: fixed; right: var(--lado); top: var(--arriba); z-index: 20; height: 18px; display: flex; align-items: center; gap: 30px; }
  .ab__madrid { margin: 0; pointer-events: none; }
  .ab__hora { margin-left: 6px; opacity: .58; font-variant-numeric: tabular-nums; }
  .ab__volver { transition: color .3s; }
  .ab__volver:hover, .ab__correo:hover { color: var(--crema); }
  .ab__logo { position: fixed; left: var(--lado); bottom: calc(var(--arriba) - 4px); z-index: 20; width: 128px; color: var(--crema); }
  .ab__correo { position: fixed; right: var(--lado); bottom: var(--arriba); z-index: 20; font-size: 10px; letter-spacing: .16em; }
  .ab__correo b { font-weight: 400; color: var(--crema); }
  .ab__sonido { display: block; padding: 6px; margin: -6px -6px -6px 0; }
  .ab__ondas { display: flex; align-items: center; gap: 3px; height: 16px; }
  .ab__ondas i { width: 2px; height: 3px; background: var(--crema); transition: height .3s var(--curva); }
  :global(html.sonido-on) .ab__ondas i { animation: ab-onda 1.1s ease-in-out infinite; }
  :global(html.sonido-on) .ab__ondas i:nth-child(2) { animation-delay: -.3s; }
  :global(html.sonido-on) .ab__ondas i:nth-child(3) { animation-delay: -.7s; }
  :global(html.sonido-on) .ab__ondas i:nth-child(4) { animation-delay: -.5s; }
  @keyframes ab-onda { 0%, 100% { height: 3px; } 50% { height: 15px; } }

  /* --- Lo común: quién es quién. Sebas en la marca (Garamond), Álvaro en la máquina (mono) --------------------------- */
  .ab__etq { margin: 0 0 18px; color: var(--crema-3); }
  .ab__quien-n { font-family: var(--serif); font-weight: 300; font-size: 34px; line-height: 1; letter-spacing: -.01em; color: var(--crema); }
  .ab__quien--alvaro .ab__quien-n, .ab__txt--alvaro .ab__quien-n, .ab__col--alvaro .ab__quien-n {
    font-family: var(--mono); font-weight: 400; font-size: 22px; letter-spacing: .2em; text-transform: uppercase;
  }
  .ab__quien, .ab__txt-quien { margin: 0 0 22px; display: flex; align-items: baseline; gap: 14px; }
  .ab__quien .mono, .ab__txt-quien .mono { color: var(--rosa); letter-spacing: .22em; }
  .ab__txt-p { margin: 0; font-size: 15px; line-height: 1.8; color: var(--crema-2); }
  .ab__txt--alvaro .ab__txt-p, .ab__col--alvaro .ab__txt-p { font-size: 14px; line-height: 1.85; }
  /* Lo que falta: la pregunta, marcada, para que se vea qué hueco es (nada inventado) */
  .ab__hueco {
    position: relative; margin: 0; padding: 16px 18px 18px; border: 1px dashed rgba(245, 203, 215, .45);
    font-family: var(--serif); font-style: italic; font-size: 19px; line-height: 1.35; color: var(--crema-3);
  }
  .ab__hueco .mono { display: block; margin-bottom: 10px; font-style: normal; color: var(--rosa); letter-spacing: .14em; }
  .ab__hueco-mini { display: block; margin-top: 6px; color: var(--rosa); letter-spacing: .14em; font-style: normal; }

  /* --- El marco del inspector: donde irá la foto de los dos. Guías solo en dos esquinas, una más larga (sin simetría) */
  .ab__marco {
    position: absolute; margin: 0; aspect-ratio: 3 / 2;
    border: 1px solid rgba(231, 226, 218, .2);
    background: repeating-linear-gradient(-45deg, rgba(231, 226, 218, .06) 0 1px, transparent 1px 7px);
  }
  .ab__guia { position: absolute; width: 0; height: 0; }
  .ab__guia::before, .ab__guia::after { content: ''; position: absolute; background: var(--rosa); }
  .ab__guia--a { left: -1px; top: -1px; }
  .ab__guia--a::before { left: -34px; top: 0; width: 96px; height: 1px; }
  .ab__guia--a::after { left: 0; top: -12px; width: 1px; height: 52px; }
  .ab__guia--b { right: -1px; bottom: -1px; }
  .ab__guia--b::before { right: 0; bottom: 0; width: 38px; height: 1px; }
  .ab__guia--b::after { right: 0; bottom: 0; width: 1px; height: 118px; }
  .ab__marco-img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .ab__marco-insp { position: absolute; left: -1px; bottom: calc(100% + 12px); }
  .ab__cota {
    position: absolute; right: 0; top: calc(100% + 10px); display: flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--crema-3); white-space: nowrap;
  }
  .ab__cota:empty { display: none; }

  /* --- 1. Arriba ------------------------------------------------------------------------------------------------------ */
  .ab__portada { position: relative; height: 100vh; height: 100svh; min-height: 620px; overflow: hidden; }
  .ab__marco--portada { left: 50%; top: 50%; width: min(38vw, 620px); transform: translate(-50%, -52%); }
  /* Arriba, la etiqueta y la cota van al lado contrario de cada nombre, para no pisarlos */
  .ab__marco--portada .ab__marco-insp { left: auto; right: -1px; }
  .ab__marco--portada .ab__cota { left: 0; right: auto; }
  .ab__nombre { position: absolute; z-index: 2; margin: 0; white-space: nowrap; color: var(--crema); }
  .ab__nombre--sebas {
    left: calc(var(--lado) + 2vw); top: 15vh;
    font-family: var(--serif); font-weight: 300; font-size: clamp(96px, 15vw, 270px); line-height: .8; letter-spacing: -.035em;
  }
  .ab__nombre--alvaro {
    right: var(--lado); bottom: 17vh;
    font-family: var(--mono); font-weight: 400; font-size: clamp(54px, 8.4vw, 150px); line-height: .9; letter-spacing: .08em; text-transform: uppercase;
  }
  .ab__intro { position: absolute; left: var(--lado); bottom: calc(var(--arriba) + 64px); width: min(340px, 28vw); }
  .ab__intro p:last-child { margin: 0; font-size: 15px; line-height: 1.6; color: var(--crema); }
  .ab__baja {
    position: absolute; left: 50%; bottom: var(--arriba); transform: translateX(-50%); margin: 0;
    display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--rosa); letter-spacing: .26em;
  }
  .ab__baja i { width: 1px; height: 46px; background: var(--rosa); transform-origin: top; animation: ab-baja 2.4s var(--curva) infinite; }
  @keyframes ab-baja { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  /* --- 2. Los montones, de arriba abajo (móvil, sin JS, movimiento reducido) ---------------------------------------- */
  .ab__montones { position: relative; padding: 14vh var(--lado) 6vh; }
  .ab__contador, .ab__quien, .ab__pila { display: none; }
  /* La foto de los dos, después del último capítulo (en la escena con ratón va en medio, encima de los montones) */
  .ab__marco--final { position: relative; width: min(100%, 720px); margin: 0 auto; }
  .ab__cap { display: grid; grid-template-columns: 1fr 1fr; column-gap: 6vw; max-width: 1100px; margin: 0 auto 16vh; }
  .ab__cap-t {
    grid-column: 1 / -1; margin: 0 0 6vh; display: flex; align-items: baseline; gap: 18px;
    font-family: var(--serif); font-weight: 300; font-size: clamp(38px, 4.2vw, 64px); line-height: 1; letter-spacing: -.02em;
  }
  .ab__cap-n { color: var(--rosa); letter-spacing: .2em; }
  .ab__foto { position: relative; margin: 0; }
  .ab__foto--sebas { transform: rotate(-3deg); z-index: 1; }
  .ab__foto--alvaro { transform: translate(-14%, 9%) rotate(2.5deg); z-index: 2; }
  .ab__papel { position: relative; aspect-ratio: 3 / 4; }
  .ab__papel img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  /* Sebas: una copia en papel, con su borde y su sombra */
  .ab__foto--sebas .ab__papel { padding: 9px 9px 30px; background: #EFEAE2; box-shadow: 0 18px 40px rgba(0, 0, 0, .45), 0 2px 6px rgba(0, 0, 0, .3); }
  /* Cada copia de Sebas va sujeta con un trozo de cinta (rosa, medio transparente y con los bordes rotos), cada una
     puesta a su manera */
  .ab__foto--sebas .ab__papel::before {
    content: ''; position: absolute; z-index: 1; left: 50%; top: -13px; width: 92px; height: 26px; margin-left: -46px;
    background: rgba(245, 203, 215, .62); mix-blend-mode: multiply; transform: rotate(-4deg);
    clip-path: polygon(0 8%, 6% 0, 12% 10%, 20% 2%, 30% 9%, 42% 0, 55% 8%, 66% 1%, 78% 9%, 88% 0, 100% 7%, 97% 50%, 100% 93%, 90% 100%, 80% 91%, 68% 100%, 56% 92%, 44% 100%, 32% 91%, 20% 100%, 9% 92%, 0 100%, 3% 50%);
  }
