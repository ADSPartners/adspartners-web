  .ab__pie-nota { display: block; margin-top: 6px; font-style: normal; font-size: 15px; line-height: 1.4; color: var(--crema-3); }
  /* El texto de Sebas, en la letra de la marca; el de Álvaro, en la de la interfaz */
  .ab__txt--sebas .ab__txt-p, .ab__col--sebas .ab__txt-p { font-family: var(--serif); font-size: 19px; line-height: 1.45; }
