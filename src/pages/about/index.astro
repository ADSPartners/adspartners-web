  :global(html.ab-escena) .ab__escena.es-final .ab__quien,
  :global(html.ab-escena) .ab__escena.es-final .ab__contador,
  :global(html.ab-escena) .ab__escena.es-final .ab__pie { opacity: 0 !important; }

  /* --- 3. Lo que hace cada uno ---------------------------------------------------------------------------------------- */
  .ab__cierre { position: relative; padding: 16vh var(--lado) 26vh; max-width: 1240px; margin: 0 auto; }
