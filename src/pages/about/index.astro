  .ab__txt--alvaro { padding-top: 4vh; }

  /* --- 2. Los montones, en escena fija (con ratón): cada tramo de scroll, un capítulo -------------------------------- */
  :global(html.ab-escena) .ab__montones { padding: 0; height: var(--alto-montones, 700vh); }
  :global(html.ab-escena) .ab__escena { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  :global(html.ab-escena) .ab__cap { display: contents; }
