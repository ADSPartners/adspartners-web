    .ab__logo { top: var(--arriba); bottom: auto; width: 112px; }
    .ab__correo { display: none; }
    /* El contenido pasa por debajo de una franja oscura, para que el logo y la vuelta no se monten en el texto */
    .ab::before {
      content: ''; position: fixed; left: 0; right: 0; top: 0; height: calc(var(--arriba) + 70px); z-index: 19; pointer-events: none;
      background: linear-gradient(var(--noche) 58%, rgba(18, 13, 10, 0));
    }
    /* Arriba, en columna: Sebas, el marco, Álvaro y el texto */
    .ab__portada { height: auto; min-height: 100svh; display: flex; flex-direction: column; padding: calc(var(--arriba) + 70px) var(--lado) 8vh; }
    .ab__portada > * { position: relative; left: auto; right: auto; top: auto; bottom: auto; }
    .ab__nombre--sebas { font-size: 27vw; }
    .ab__marco--portada { width: 100%; margin-top: 46px; transform: none; }
    .ab__nombre--alvaro { align-self: flex-end; margin-top: 44px; font-size: 13vw; letter-spacing: .06em; }
    .ab__intro { width: auto; margin-top: auto; padding-top: 6vh; }
    .ab__intro p:last-child { font-size: 14px; }
    .ab__baja { display: none; }
    .ab__montones { padding: 10vh var(--lado) 4vh; }
    .ab__cap { grid-template-columns: 1fr 1fr; column-gap: 0; margin-bottom: 12vh; }
    .ab__cap-t { margin-bottom: 4vh; font-size: 38px; }
    .ab__foto--sebas .ab__papel { padding: 6px 6px 20px; }
    /* Las dos fotos, una al lado de otra; sus pies, debajo y a todo el ancho, uno detrás de otro (con las notas no
       caben lado a lado). La figura se deshace en la rejilla del capítulo: el giro va en el papel */
    .ab__foto { display: contents; }
    .ab__cap-t { grid-row: 1; }
    .ab__foto > .ab__papel { grid-row: 2; position: relative; }
    .ab__foto--sebas > .ab__papel { grid-column: 1; z-index: 1; transform: rotate(-3deg); }
    .ab__foto--alvaro > .ab__papel { grid-column: 2; z-index: 2; transform: translate(-8%, 12%) rotate(2.5deg); }
    .ab__foto--alvaro .ab__pie { transform: none; }
    .ab__pie { grid-column: 1 / -1; }
    .ab__pie--sebas { grid-row: 3; margin-top: 48px; }
    .ab__pie--alvaro { grid-row: 4; margin-top: 22px; }
    .ab__pie--sebas { font-size: 16px; padding-right: 10px; }
    .ab__pie--alvaro dl div { grid-template-columns: 1fr; gap: 0; }
    .ab__insp { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
    .ab__cota--foto { display: none; }
    .ab__txt { grid-column: 1 / -1; margin-top: 5vh; }
    .ab__txt--alvaro { padding-top: 0; }
    .ab__cierre { padding: 10vh var(--lado) 16vh; }
    .ab__cols { grid-template-columns: 1fr; gap: 40px; }
    .ab__frase { margin-top: 12vh; font-size: 44px; }
    .ab__frase--b { margin-top: .12em; }
  }

  /* --- El fondo partido (desde 761 px): a la izquierda, el papel de Sebas (brand); a la derecha, la rejilla y los glifos
     de Álvaro (tech), como en el resto de la web. La costura va en el centro de la pantalla: lo de Sebas pasa a tinta, y
     lo que está centrado y la cruza (el contador, el título del capítulo, el marco, «Baja» y el «Juntos» del final) va a
     dos tintas, partido justo por la mitad de su caja. En el móvil no se parte: el texto ocupa todo el ancho ------------ */
  @media (min-width: 761px) {
    .ab { --t2: rgba(25, 9, 0, .66); --t3: rgba(25, 9, 0, .44); --neutro: rgba(120, 108, 96, .45); }
    /* El papel quieto (sin fondo vivo): la costura, un degradado del 43 al 57 %. Con el fondo vivo lo pinta el canvas
