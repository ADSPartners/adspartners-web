  :global(html.ab-escena) .ab__txt {
    position: absolute; top: calc(31vh + 58px); width: min(300px, 21vw); margin: 0; padding: 0;
    opacity: 0; visibility: hidden; transition: opacity .45s var(--curva), transform .8s var(--curva), visibility 0s .45s;
  }
  :global(html.ab-escena) .ab__txt--sebas { left: var(--lado); transform: translateY(18px); }
  :global(html.ab-escena) .ab__txt--alvaro { right: var(--lado); }
  :global(html.ab-escena) .ab__cap.es-actual .ab__cap-t,
  :global(html.ab-escena) .ab__cap.es-actual .ab__txt { opacity: 1; visibility: visible; transition-delay: 0s; }
  :global(html.ab-escena) .ab__cap.es-actual .ab__cap-t { transform: translate(-50%, 0); }
  :global(html.ab-escena) .ab__cap.es-actual .ab__txt--sebas { transform: none; }
  /* Las pilas: about.js las coloca y mete dentro las fotos de cada uno */
  :global(html.ab-escena) .ab__pila {
    display: block; position: absolute; left: 0; top: 50%; width: var(--foto-w); aspect-ratio: 3 / 4;
    margin-top: calc(var(--foto-w) * -2 / 3 + 36px); will-change: transform;
  }
  :global(html.ab-escena) .ab__pila .ab__foto { position: absolute; inset: 0; transform: none; visibility: hidden; }
  :global(html.ab-escena) .ab__pila .ab__foto.es-dentro { visibility: visible; }
  :global(html.ab-escena) .ab__pila .ab__papel { position: absolute; inset: 0; aspect-ratio: auto; will-change: transform; filter: brightness(var(--luz, 1)); }
  :global(html.ab-escena) .ab__pila .ab__pie {
    position: absolute; left: 0; right: 0; top: calc(100% + 40px); margin: 0; transform: none;
    opacity: 0; transition: opacity .4s var(--curva);
  }
  /* Cada pie sale hacia su lado (el de Sebas, a la izquierda; el de Álvaro, a la derecha): así, cuando los montones se
     juntan, no se pisan */
  :global(html.ab-escena) .ab__pila--sebas .ab__pie { left: auto; right: 35%; width: 300px; text-align: right; }
  :global(html.ab-escena) .ab__pila--alvaro .ab__pie { left: 40%; right: auto; width: 300px; }
  :global(html.ab-escena) .ab__pila .ab__caja,
  :global(html.ab-escena) .ab__pila .ab__insp,
  :global(html.ab-escena) .ab__pila .ab__paleta,
  :global(html.ab-escena) .ab__pila .ab__cota { opacity: 0; transition: opacity .35s var(--curva); }
  :global(html.ab-escena) .ab__pila .ab__foto.es-arriba .ab__pie,
  :global(html.ab-escena) .ab__pila .ab__foto.es-arriba.pix-hecho .ab__caja,
  :global(html.ab-escena) .ab__pila .ab__foto.es-arriba.pix-hecho .ab__insp,
  :global(html.ab-escena) .ab__pila .ab__foto.es-arriba.pix-hecho .ab__paleta,
  :global(html.ab-escena) .ab__pila .ab__foto.es-arriba.pix-hecho .ab__cota { opacity: 1; }
  :global(html.ab-escena) .ab__pila .ab__cota--foto { display: none; }
