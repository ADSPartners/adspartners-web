---
import '../styles/global.css';

interface Props { titulo: string; descripcion: string; lang?: string; concepto?: string }
const { titulo, descripcion, lang = 'es', concepto = 'pincel' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang} data-concepto={concepto}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#120D0A" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(`${base}assets/og-adspartners.png`, Astro.site).href} />
    <link rel="icon" href={`${base}assets/logos/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}assets/logos/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}assets/fonts/AppleGaramond-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/OpenSauceSans-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes de pintar: ¿ya pasó por el umbral en esta sesión? ¿prefiere menos movimiento?
      (function () {
        var h = document.documentElement, umbral = null, mov = null;
        try { umbral = sessionStorage.getItem('ads-umbral'); mov = localStorage.getItem('ads-movimiento'); } catch (e) {}
        if (!umbral) h.classList.add('en-umbral');
        var reducido = mov ? mov === 'reducido' : window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducido) h.classList.add('mov-reducido');
        h.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
