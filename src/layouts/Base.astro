---
import '../styles/global.css';
import Consentimiento from '../components/Consentimiento.astro';
import Entrada from '../components/Entrada.astro';
import { ORGANIZACION, WEBSITE, WEB_ID, migas } from '../data/schema.js';
import { DESTINOS } from '../data/menu.js';

// titulo: el <title>, con las palabras que se buscan; ogTitulo: lo que sale al compartir en redes (si no, el titulo).
// Los datos estructurados (data/schema.js): la organización y el sitio en todas, la página (tipoPagina, con lo de
// pagina dentro), sus migas si hay miga y los nodos propios de schema. indexar={false}: sin canónica, con noindex y
// sin datos estructurados (la 404). construye: la página se construye al llegar (la coreografía es de cada página, en
// CSS bajo html.construye, y acaba con la animación «construida» en el <html>; ver más abajo)
interface Props {
  titulo: string; descripcion: string; ogTitulo?: string; lang?: string; umbral?: boolean;
  tipoPagina?: string; miga?: string; pagina?: Record<string, unknown>; schema?: object[]; indexar?: boolean;
  construye?: boolean;
}
const {
  titulo, descripcion, ogTitulo = titulo, lang = 'es-ES', umbral = false,
  tipoPagina = 'WebPage', miga, pagina = {}, schema = [], indexar = true, construye = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(`${base}assets/og-adspartners.png`, Astro.site).href;
const grafo = indexar ? {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZACION,
    WEBSITE,
    {
      '@type': tipoPagina, '@id': `${canonica}#webpage`, url: canonica, name: titulo, description: descripcion,
      isPartOf: { '@id': WEB_ID }, inLanguage: lang, ...(miga ? { breadcrumb: { '@id': `${canonica}#breadcrumb` } } : {}), ...pagina,
    },
    ...(miga ? [migas(canonica, miga)] : []),
    ...schema,
  ],
} : null;
// «Ir con entrada» (scripts/entrada.js, para los enlaces con data-entrada): la base y, por ruta, el LED y el fondo de
// cada página del menú
const entradas = {
  base,
  destinos: Object.fromEntries(DESTINOS.filter((d) => d.ruta && !d.ruta.startsWith('#'))
    .map((d) => [d.ruta, { c: d.color, f: d.fondo || '#120D0A', p: d.partido ? 1 : 0 }])),
};
---
<!doctype html>
<html lang={lang} data-umbral={umbral ? '' : undefined} data-construye={construye ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#120D0A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="adsPartners" />
    <meta property="og:locale" content="es_ES" />
    {indexar && <meta property="og:url" content={canonica} />}
    <meta property="og:title" content={ogTitulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="adsPartners. Brand por fuera. Tech por dentro." />
    <meta name="twitter:card" content="summary_large_image" />
    {grafo && <script is:inline type="application/ld+json" set:html={JSON.stringify(grafo).replace(/</g, '\\u003c')} />}
    <link rel="icon" href={`${base}assets/logos/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}assets/logos/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}assets/fonts/AppleGaramond-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/OpenSauceSans-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes de pintar: ¿ya pasó por el umbral en esta sesión? ¿el sistema pide menos movimiento? ¿hay ratón? ¿llega
      // entrando en su pieza desde el menú? (entonces empieza con el fondo en el que acabó el viaje: Entrada.astro)
      (function () {
        var h = document.documentElement, umbral = null;
        try { umbral = sessionStorage.getItem('ads-umbral'); } catch (e) {}
        if (!umbral && h.hasAttribute('data-umbral')) h.classList.add('en-umbral');
        var reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducido) h.classList.add('mov-reducido');
        var color = /^#[0-9a-fA-F]{6}$/, entrada = null;
        try { entrada = JSON.parse(sessionStorage.getItem('ads-entrada') || 'null'); sessionStorage.removeItem('ads-entrada'); } catch (e) {}
        if (entrada && !reducido && Date.now() - entrada.t < 6000 && color.test(entrada.c) && color.test(entrada.f)) {
          h.classList.add('entra-menu');
          if (entrada.p) h.classList.add('entra-partido');
          h.style.setProperty('--entra-c', entrada.c);
          h.style.setProperty('--entra-f', entrada.f);
          // (se quita al acabar de desvanecerse, cuando sea: si la página tarda en pintar, la animación espera a su
          // primer fotograma; con un reloj fijo se perdía entera)
          var quitar = function () { h.classList.remove('entra-menu', 'entra-partido'); h.style.removeProperty('--entra-c'); h.style.removeProperty('--entra-f'); };
          document.addEventListener('animationend', function fin(e) { if (e.animationName === 'entrada-fundido') { document.removeEventListener('animationend', fin); quitar(); } });
          setTimeout(quitar, 6000);
        }
        // La página que se construye al llegar: la coreografía es CSS (html.construye), empieza con el primer pintado
        // y corre en el compositor aunque el JS aún esté arrancando. Acaba con la animación «construida» del <html>:
        // entonces se quita la clase (todo queda en su sitio de siempre) y se avisa (ads:construida) para que lo que
        // pesa (el fondo vivo, las letras que notan el ratón) arranque detrás. Con «movimiento reducido», un fundido corto
        if (h.hasAttribute('data-construye')) {
          if (reducido) h.classList.add('construye-suave');
          else {
            h.classList.add('construye');
            var hecho = function () {
              if (!h.classList.contains('construye')) return;
              h.classList.remove('construye');
              h.classList.add('construida');
              try { window.dispatchEvent(new Event('ads:construida')); } catch (e) {}
            };
            document.addEventListener('animationend', function fin(e) { if (e.animationName === 'construida') { document.removeEventListener('animationend', fin); hecho(); } });
            setTimeout(hecho, 6000);
          }
        }
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && window.innerWidth > 760) h.classList.add('con-raton');
        h.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <Entrada />
    <script is:inline type="application/json" id="ads-entradas" set:html={JSON.stringify(entradas).replace(/</g, '\\u003c')} />
    <script>import '../scripts/entrada.js';</script>
    <slot />
    <Consentimiento />
  </body>
</html>
