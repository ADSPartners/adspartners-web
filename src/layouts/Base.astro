---
import '../styles/global.css';
import Consentimiento from '../components/Consentimiento.astro';
import { ORGANIZACION, WEBSITE, WEB_ID, migas } from '../data/schema.js';

// titulo: el <title>, con las palabras que se buscan; ogTitulo: lo que sale al compartir en redes (si no, el titulo).
// Los datos estructurados (data/schema.js): la organización y el sitio en todas, la página (tipoPagina, con lo de
// pagina dentro), sus migas si hay miga y los nodos propios de schema. indexar={false}: sin canónica, con noindex y
// sin datos estructurados (la 404).
interface Props {
  titulo: string; descripcion: string; ogTitulo?: string; lang?: string; umbral?: boolean;
  tipoPagina?: string; miga?: string; pagina?: Record<string, unknown>; schema?: object[]; indexar?: boolean;
}
const {
  titulo, descripcion, ogTitulo = titulo, lang = 'es-ES', umbral = false,
  tipoPagina = 'WebPage', miga, pagina = {}, schema = [], indexar = true,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(`${base}assets/og-adspartners.png`, Astro.site).href;
const grafo = indexar ? {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZACION,
    WEBSITE,
    {
      '@type': tipoPagina, '@id': `${canonica}#webpage`, url: canonica, name: titulo, description: descripcion,
      isPartOf: { '@id': WEB_ID }, inLanguage: lang, ...(miga ? { breadcrumb: { '@id': `${canonica}#breadcrumb` } } : {}), ...pagina,
    },
    ...(miga ? [migas(canonica, miga)] : []),
    ...schema,
  ],
} : null;
---
<!doctype html>
<html lang={lang} data-umbral={umbral ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#120D0A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="adsPartners" />
    <meta property="og:locale" content="es_ES" />
    {indexar && <meta property="og:url" content={canonica} />}
    <meta property="og:title" content={ogTitulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="adsPartners. Brand por fuera. Tech por dentro." />
    <meta name="twitter:card" content="summary_large_image" />
    {grafo && <script is:inline type="application/ld+json" set:html={JSON.stringify(grafo).replace(/</g, '\\u003c')} />}
    <link rel="icon" href={`${base}assets/logos/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}assets/logos/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}assets/fonts/AppleGaramond-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/OpenSauceSans-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes de pintar: ¿ya pasó por el umbral en esta sesión? ¿el sistema pide menos movimiento? ¿hay ratón?
      (function () {
        var h = document.documentElement, umbral = null;
        try { umbral = sessionStorage.getItem('ads-umbral'); } catch (e) {}
        if (!umbral && h.hasAttribute('data-umbral')) h.classList.add('en-umbral');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('mov-reducido');
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && window.innerWidth > 760) h.classList.add('con-raton');
        h.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <slot />
    <Consentimiento />
  </body>
</html>
