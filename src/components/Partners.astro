---
// Transición entre «Qué somos» y «Proyectos»: un túnel. Al bajar, el título se viene encima letra a letra y te pasa
// por los lados (como en el cine en 3D) y después la cámara avanza entre los 12 logos, sueltos, sin tarjeta.
// De lejos cada logo es máquina (su silueta tramada en crema); al acercarse es marca (su logo, en su color).
// Sin movimiento, una rejilla de logos.
import { PARTNERS } from '../data/partners.js';
const base = import.meta.env.BASE_URL;
const dos = (n: number) => String(n).padStart(2, '0');
---
<section class="pt" id="partners" data-seccion="partners" aria-labelledby="pt-titulo">
  <div class="pt__pegado" data-pt-pegado>
    <div class="pt__intro" data-pt-intro>
      <p class="pt__etq mono" data-pt-menor>( partners · {dos(PARTNERS.length)} )</p>
      <h2 class="pt__titulo" id="pt-titulo" data-pt-titulo>Gente que ya ha trabajado <em>con nosotros</em></h2>
      <p class="pt__pista mono" aria-hidden="true" data-pt-menor>Sigue bajando: vamos a pasar por delante</p>
    </div>

    <ul class="pt__mundo" data-pt-mundo>
      {PARTNERS.map((p, i) => (
        <li class="pt__logo" data-pt-logo
          style={`--tinta:${p.tinta || 'transparent'};--ancho:${p.ancho};--srcd:url('${base}assets/partners/${p.logo}')`}>
          <div class="pt__caja">
            <span class="pt__cara pt__cara--maquina" aria-hidden="true"><span class="pt__silueta"></span></span>
            <span class="pt__cara pt__cara--marca">
              {p.tinta
                ? <span class="pt__mascara" role="img" aria-label={p.nombre}></span>
                : <img src={`${base}assets/partners/${p.logo}`} alt={p.nombre} loading="lazy" decoding="async" />}
            </span>
          </div>
          <p class="pt__pie mono" aria-hidden="true">partner_{dos(i + 1)} · {p.sector}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pt { position: relative; height: 460vh; }
  .pt__pegado {
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    perspective: 900px; perspective-origin: 50% 50%;
  }
  .pt__intro {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center;
    padding: 0 var(--margen); pointer-events: none; transform-style: preserve-3d;
  }
  .pt__etq { margin: 0 0 18px; color: var(--crema-3); }
  .pt__titulo { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(38px, 5.4vw, 92px); line-height: .96; letter-spacing: -.025em; max-width: 12em; }
  .pt__titulo em { font-style: italic; color: var(--rosa); }
  /* Las letras viajan en 3D: toda la cadena hasta ellas tiene que conservar la profundidad */
  .pt__titulo, .pt__titulo em, .pt__titulo :global(div) { transform-style: preserve-3d; }
  .pt__titulo em { display: inline-block; }
  .pt__titulo :global(.pt-letra) { will-change: transform, opacity; backface-visibility: hidden; }
  .pt__pista { margin: 22px 0 0; color: var(--crema-3); }

  .pt__mundo { position: absolute; left: 50%; top: 50%; width: 0; height: 0; margin: 0; padding: 0; list-style: none; transform-style: preserve-3d; }
  /* Cada logo trae su imagen en --srcd; partners.js la pasa a --src al montar la sección. Sin JS, desde el principio */
  :global(html:not(.js)) .pt__logo { --src: var(--srcd); }
  .pt__logo {
    --marca: 0;
    position: absolute; left: 0; top: 0;
    width: clamp(240px, 23vw, 400px);
    transform-style: preserve-3d;
    will-change: transform, opacity;
    opacity: 0;
  }
  .pt__caja { position: relative; aspect-ratio: 16 / 10; margin-left: -50%; margin-top: -31.25%; }
  .pt__cara { position: absolute; inset: 0; display: grid; place-items: center; }
  /* Máquina: la silueta del logo tramada en crema */
  .pt__cara--maquina { opacity: calc(1 - var(--marca)); }
  .pt__silueta {
    width: calc(var(--ancho) * 100%); height: 72%;
    background: repeating-linear-gradient(0deg, rgba(231, 226, 218, .85) 0 1px, transparent 1px 3px);
    -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat;
  }
  /* Marca: el logo de verdad, en su color */
  .pt__cara--marca { opacity: var(--marca); filter: drop-shadow(0 24px 40px rgba(0, 0, 0, .55)); }
  .pt__cara--marca img { width: calc(var(--ancho) * 100%); height: 72%; object-fit: contain; }
  .pt__mascara { width: calc(var(--ancho) * 100%); height: 72%; background: var(--tinta);
    -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; }

  .pt__pie { margin: 6px 0 0 -50%; text-align: center; color: var(--crema-3); white-space: nowrap; opacity: calc(1 - var(--marca) * .5); }

  @media (max-width: 760px) {
    .pt { height: 400vh; }
    .pt__logo { width: 56vw; }
    .pt__pie { font-size: 9px; }
  }

  /* Sin movimiento: una rejilla de logos en «marca» */
  :global(html.mov-reducido) .pt { height: auto; padding: 18vh var(--margen); }
  :global(html.mov-reducido) .pt__pegado { position: static; height: auto; overflow: visible; perspective: none; }
  :global(html.mov-reducido) .pt__intro { position: static; margin-bottom: 8vh; }
  :global(html.mov-reducido) .pt__pista { display: none; }
  :global(html.mov-reducido) .pt__mundo { position: static; width: auto; height: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 48px 24px; transform: none; }
  :global(html.mov-reducido) .pt__logo { --marca: 1; position: relative; width: auto; transform: none !important; opacity: 1 !important; }
  :global(html.mov-reducido) .pt__caja { margin: 0; }
  :global(html.mov-reducido) .pt__pie { margin: 6px 0 0; white-space: normal; }
</style>
