---
// Pie del prototipo: marca y una nota de lo que falta por construir.
import Marca from './Marca.astro';
---
<footer class="pie">
  <span class="pie__logo"><Marca tipo="logo" etiqueta="adsPartners" /></span>
  <p class="mono pie__nota">Prototipo de dirección · Aquí seguirán Trabajo y Equipo</p>
  <p class="mono pie__nota">© 2026 adsPartners</p>
</footer>

<style>
  .pie {
    position: relative; z-index: 1;
    display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between;
    padding: 36px var(--margen) calc(36px + env(safe-area-inset-bottom, 0px));
    background: var(--fondo-seccion, var(--noche)); color: var(--crema);
  }
  .pie__logo { width: 120px; }
  .pie__logo :global(svg) { width: 100%; height: auto; }
  .pie__nota { margin: 0; color: var(--crema-3); }
</style>
