---
// Trabajo: lista compacta (rama, cliente, qué hicimos). Con ratón, una vista del proyecto sigue al cursor
// (la web terminada, en vídeo si lo hay) y, al mantener pulsado, se abre por dentro: su código real sobre
// la versión «máquina» de su imagen. En el móvil, cada fila lleva su miniatura y un botón «Por dentro».
import { TRABAJOS } from '../data/trabajos.js';
const base = import.meta.env.BASE_URL;
const datos = TRABAJOS.map((t) => ({ ...t, imagen: base + t.imagen, video: t.video ? base + t.video : null }));
---
<section class="trabajo" id="trabajo" aria-labelledby="trabajo-t">
  <header class="trabajo__cab">
    <p class="mono trabajo__etq">( Trabajo )</p>
    <h2 class="trabajo__titulo" id="trabajo-t" data-lente>Lo que hemos hecho. <em>Por fuera y por dentro.</em></h2>
    <p class="trabajo__ayuda mono">Pasa el ratón por un proyecto · mantén pulsado para verlo por dentro</p>
  </header>

  <ul class="trabajo__lista">
    {datos.map((t, i) => (
      <li class="obra" data-obra={i} data-cursor="trabajo" data-sonido-hover>
        <span class="obra__rama mono">{t.rama}</span>
        <span class="obra__cliente">{t.cliente}</span>
        <span class="obra__que">{t.que}</span>
        {t.enlace
          ? <a class="obra__ir mono" href={t.enlace} target="_blank" rel="noopener">Ver la web ↗</a>
          : <span class="obra__ir obra__ir--vacio mono" aria-hidden="true">—</span>}
        <span class="obra__movil" aria-hidden="true">
          <img src={t.imagen} alt="" loading="lazy" width="1280" height="800" />
          <canvas data-mini-dentro></canvas>
        </span>
        <button class="obra__voltear mono" type="button" data-voltear>Por dentro</button>
      </li>
    ))}
  </ul>
  <p class="trabajo__mas">Y también, sin vídeo que enseñar: <b>Impulso Visual</b> (Tech), <b>Intruder Gestión</b> (Tech), <b>Inversalia</b> (Brand) y <b>Klink</b> (Brand).</p>
</section>

<div class="vista" data-vista aria-hidden="true">
  <div class="vista__marco">
    <img class="vista__capa" data-vista-img alt="" />
    <video class="vista__capa" data-vista-video muted loop playsinline preload="none"></video>
    <canvas class="vista__capa vista__dentro" data-vista-dentro></canvas>
    <span class="vista__aro" data-vista-aro></span>
  </div>
  <p class="vista__pie mono" data-vista-pie></p>
</div>

<script type="application/json" id="datos-trabajos" set:html={JSON.stringify(datos)}></script>

<style>
  .trabajo {
    position: relative; z-index: 1;
    background: var(--noche);
    padding: clamp(90px, 14vh, 160px) var(--margen) clamp(100px, 15vh, 170px);
    border-top: 1px solid var(--linea);
  }
  .trabajo__cab { display: grid; gap: 20px; margin-bottom: clamp(40px, 7vh, 80px); }
  .trabajo__etq { margin: 0; color: var(--crema-3); }
  .trabajo__titulo { margin: 0; max-width: 18ch; font-family: var(--serif); font-weight: 300; font-size: clamp(40px, 5vw, 80px); line-height: 1; letter-spacing: -.024em; }
  .trabajo__titulo em { font-style: italic; font-weight: 400; color: var(--crema-2); }
  .trabajo__ayuda { margin: 0; color: var(--crema-3); }

  .trabajo__lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linea); }
  .obra {
    position: relative; display: grid; grid-template-columns: 90px minmax(0, 4fr) minmax(0, 5fr) 110px; gap: 24px; align-items: baseline;
    padding: clamp(22px, 3.4vh, 34px) 0; border-bottom: 1px solid var(--linea);
    transition: color .45s var(--curva);
  }
  .obra::before {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%;
    background: var(--crema); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--curva);
  }
  .obra__rama { color: var(--rosa); }
  .obra__cliente { font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 3.4vw, 54px); line-height: 1; letter-spacing: -.02em; transition: transform .5s var(--curva); }
  .obra__que { font-size: 15px; line-height: 1.5; color: var(--crema-2); transition: color .45s var(--curva); }
  .obra__ir { justify-self: end; color: var(--crema-3); transition: color .3s; }
  .obra__ir:hover, .obra__ir:focus-visible { color: var(--crema); }
  .obra__ir--vacio { opacity: .4; }
  .obra:hover::before, .obra.activa::before { transform: scaleX(1); }
  .obra:hover .obra__cliente, .obra.activa .obra__cliente { transform: translateX(14px); }
  .obra:hover .obra__que, .obra.activa .obra__que { color: var(--crema); }
  .obra__movil, .obra__voltear { display: none; }

  .trabajo__mas { margin: 36px 0 0; font-size: 15px; color: var(--crema-2); }
  .trabajo__mas b { font-weight: 500; color: var(--crema); }

  /* Vista que sigue al cursor */
  .vista {
    position: fixed; top: 0; left: 0; z-index: 55; pointer-events: none;
    width: min(400px, 30vw); opacity: 0; transform: translate3d(-50%, -50%, 0) scale(.86);
    transition: opacity .35s var(--curva);
  }
  .vista.visible { opacity: 1; }
  .vista__marco { position: relative; aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; background: var(--noche-2); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6); }
  .vista__capa { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vista__dentro { clip-path: circle(var(--r, 0%) at var(--rx, 50%) var(--ry, 50%)); }
  .vista__aro {
    position: absolute; left: var(--rx, 50%); top: var(--ry, 50%); width: calc(var(--r, 0%) * 2.36); aspect-ratio: 1;
    border: 1px solid var(--rosa); border-radius: 50%; transform: translate(-50%, -50%); opacity: var(--aro, 0);
  }
  .vista__pie { margin: 10px 0 0; color: var(--crema-2); text-shadow: 0 1px 8px rgba(0, 0, 0, .6); }

  @media (hover: none), (pointer: coarse) {
    .vista { display: none; }
    .obra { grid-template-columns: 1fr auto; gap: 10px 16px; }
    .obra__rama { grid-column: 1; }
    .obra__ir { grid-column: 2; grid-row: 1; }
    .obra__cliente, .obra__que { grid-column: 1 / -1; }
    .obra__movil { display: block; grid-column: 1 / -1; position: relative; aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; margin-top: 6px; }
    .obra__movil img, .obra__movil canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .obra__movil canvas { opacity: 0; transition: opacity .6s var(--curva); }
    .obra.volteada .obra__movil canvas { opacity: 1; }
    .obra__voltear { display: inline-flex; grid-column: 1 / -1; justify-self: start; padding: 9px 14px; border: 1px solid var(--crema-3); border-radius: 99px; color: var(--crema); }
    .obra.volteada .obra__voltear { border-color: var(--rosa); color: var(--rosa); }
    .obra:hover .obra__cliente, .obra.activa .obra__cliente { transform: none; }
    .obra:hover::before { transform: scaleX(0); }
  }
</style>
