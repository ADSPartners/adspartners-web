---
// La pantalla previa: carga con humor, barra de 1 px y la elección del sonido.
// El final de la carga lo pinta el canvas de la portada en modo umbral: todo máquina, con «ads» enorme en el
// centro, y la marca solo donde pasa el ratón (una linterna). El «ads» del DOM está para medirlo y por si no hay
// WebGL (entonces se ve en contorno). Sale una vez por sesión.
import Marca from './Marca.astro';
---
<div class="umbral" id="umbral" role="dialog" aria-modal="true" aria-label="Entrada a adsPartners">
  <div class="umbral__velo" aria-hidden="true"></div>
  <span class="umbral__iso" data-umbral-iso aria-hidden="true"><Marca tipo="iso" /></span>
  <button class="umbral__saltar mono" type="button" data-entrar="sin">Saltar</button>

  <p class="umbral__ads" data-umbral-ads aria-hidden="true"><span data-trozo>ads<i class="umbral__base"></i></span></p>

  <div class="umbral__abajo">
    <div class="umbral__carga" data-umbral-carga>
      <div class="umbral__barra" aria-hidden="true"><span data-umbral-barra></span></div>
      <p class="umbral__frase mono" aria-live="polite"><span data-umbral-frase>Encendiendo la máquina…</span></p>
    </div>

    <div class="umbral__entradas" data-umbral-entradas>
      <button class="umbral__con" type="button" data-entrar="con">
        <span class="umbral__con-t">Entrar con sonido</span>
        <span class="umbral__ondas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </button>
      <button class="umbral__sin mono" type="button" data-entrar="sin">Entrar sin sonido</button>
    </div>
  </div>

  <p class="umbral__pie mono" aria-hidden="true" data-umbral-pie>Mejor con cascos · <span class="umbral__pie-raton">Pasa el ratón: debajo está el brand</span><span class="umbral__pie-dedo">Pasa el dedo: debajo está el brand</span></p>
</div>

<style>
  .umbral {
    position: fixed; inset: 0; z-index: 50;
    color: var(--crema);
    overflow: hidden;
  }
  html:not(.en-umbral) .umbral { display: none; }
  /* Hasta que el WebGL pinta, noche a tope; después solo un poco de sombra abajo para leer los botones */
  .umbral__velo { position: absolute; inset: 0; background: var(--noche); transition: background-color 1.2s var(--curva); }
  :global(html.gl-activo) .umbral__velo { background-color: transparent; background-image: linear-gradient(rgba(18, 13, 10, 0) 58%, rgba(18, 13, 10, .55)); }

  .umbral__iso { position: absolute; top: calc(var(--margen) + 4px); left: 50%; width: 30px; margin-left: -15px; color: var(--crema); }
  .umbral__iso :global(svg) { width: 100%; height: auto; }

  /* El «ads» del centro: lo pinta el canvas; sin WebGL se ve en contorno, que es su versión máquina */
  .umbral__ads {
    position: absolute; left: 0; right: 0; top: 47%; margin: 0;
    transform: translateY(-50%);
    text-align: center;
    font-family: var(--serif); font-weight: 300;
    font-size: min(40vw, 62vh); line-height: .8; letter-spacing: -.04em;
    color: transparent; -webkit-text-stroke: 1px var(--crema-3);
    pointer-events: none; user-select: none;
  }
  :global(html.umbral-gl) .umbral__ads { -webkit-text-stroke: 0; }
  .umbral__ads span { position: relative; }
  .umbral__base { display: inline-block; width: 0; height: 0; vertical-align: baseline; }

  .umbral__abajo { position: absolute; left: 0; right: 0; bottom: 12vh; display: grid; justify-items: center; }
  .umbral__abajo > * { grid-area: 1 / 1; }
  .umbral__carga { display: grid; justify-items: center; gap: 14px; }
  .umbral__barra { width: 160px; height: 1px; background: var(--linea); overflow: hidden; }
  .umbral__barra span { display: block; height: 100%; background: var(--crema); transform-origin: left; transform: scaleX(0); }
  .umbral__frase { margin: 0; min-height: 1.4em; color: var(--crema-2); overflow: hidden; text-shadow: 0 1px 10px rgba(18, 13, 10, .9); }
  .umbral__frase span { display: inline-block; }

  .umbral__entradas { display: grid; justify-items: center; gap: 16px; opacity: 0; visibility: hidden; }
  .umbral__con {
    display: inline-flex; align-items: center; gap: 14px;
    font-family: var(--serif); font-size: clamp(26px, 2.6vw, 38px); font-weight: 300; letter-spacing: -.01em;
    padding: 8px 4px;
    text-shadow: 0 1px 18px rgba(18, 13, 10, .7);
  }
  .umbral__con-t { background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat; transition: background-size .6s var(--curva); }
  .umbral__con:hover .umbral__con-t, .umbral__con:focus-visible .umbral__con-t { background-size: 100% 1px; }
  .umbral__ondas { display: inline-flex; align-items: center; gap: 3px; height: 18px; }
  .umbral__ondas i { width: 2px; height: 100%; background: var(--rosa); transform: scaleY(.25); animation: onda 1.1s ease-in-out infinite; }
  .umbral__ondas i:nth-child(2) { animation-delay: .15s; } .umbral__ondas i:nth-child(3) { animation-delay: .3s; }
  .umbral__ondas i:nth-child(4) { animation-delay: .45s; } .umbral__ondas i:nth-child(5) { animation-delay: .6s; }
  @keyframes onda { 0%, 100% { transform: scaleY(.25); } 50% { transform: scaleY(1); } }
  .umbral__sin { color: var(--crema-2); padding: 6px; transition: color .3s; }
  .umbral__sin:hover, .umbral__sin:focus-visible { color: var(--crema); }

  .umbral__saltar { position: absolute; bottom: var(--margen); right: var(--margen); color: var(--crema-3); padding: 6px; transition: color .3s; }
  .umbral__saltar:hover, .umbral__saltar:focus-visible { color: var(--crema); }
  .umbral__pie { position: absolute; left: 0; right: 0; bottom: var(--margen); margin: 0; text-align: center; color: var(--crema-3); pointer-events: none; }
  .umbral__pie-dedo { display: none; }

  :global(html.mov-reducido) .umbral__ondas i { animation: none; transform: scaleY(.6); }
  @media (hover: none), (pointer: coarse) {
    .umbral__pie-raton { display: none; }
    .umbral__pie-dedo { display: inline; }
  }
  @media (max-width: 700px) {
    .umbral__ads { font-size: 44vw; top: 44%; }
    .umbral__abajo { bottom: 13vh; }
    .umbral__pie { bottom: calc(var(--margen) + 28px); padding: 0 var(--margen); }
  }
</style>
