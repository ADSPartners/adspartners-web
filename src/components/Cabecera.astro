---
// Barra fija: logotipo con el botón del menú debajo, las barras del sonido (se pulsan para callarlo o encenderlo) y
// contacto. Se esconde al bajar y vuelve al subir. El menú aún no existe: el botón está, pero no abre nada.
import Marca from './Marca.astro';
const base = import.meta.env.BASE_URL;
---
<header class="cab" data-cab>
  <div class="cab__izq">
    <a class="cab__logo" href={base} aria-label="adsPartners, inicio"><Marca tipo="logo" /></a>
    <button class="cab__menu mono" type="button" aria-expanded="false" data-menu-btn data-sonido-hover>
      <span class="cab__menu-i" aria-hidden="true"><i></i><i></i></span>Menú
    </button>
  </div>

  <div class="cab__dcha">
    <button class="cab__sonido" type="button" aria-pressed="false" aria-label="Sonido" data-sonido-btn data-sonido-hover>
      <span class="cab__barras" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="cab__sonido-t mono" data-sonido-txt>Sonido off</span>
    </button>

    <a class="cab__hablemos" href="mailto:adsgroup@ads-partners.com" data-sonido-hover data-iman>Hablemos</a>
  </div>
</header>

<style>
  .cab {
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--margen);
    pointer-events: none;
    color: var(--crema);
    transition: transform .7s var(--curva), opacity .5s var(--curva), color .5s var(--curva);
  }
  .cab > * { pointer-events: auto; }
  /* Pasada la portada, un degradado detrás de la barra para que no se monte sobre los titulares */
  .cab::before {
    content: ''; position: absolute; inset: 0 0 -40px; z-index: -1; pointer-events: none;
    background: linear-gradient(var(--noche) 30%, rgba(18, 13, 10, 0));
    opacity: 0; transition: opacity .5s var(--curva), background .5s var(--curva);
  }
  .cab--fondo::before { opacity: 1; }
  .cab--fuera { transform: translateY(-110%); opacity: 0; }
  /* Sobre el capítulo claro (contacto), en tinta */
  .cab--clara { color: var(--tinta); }
  .cab--clara::before { background: linear-gradient(var(--crema) 30%, rgba(231, 226, 218, 0)); }
  .cab--clara .cab__hablemos:hover, .cab--clara .cab__hablemos:focus-visible { background: var(--tinta); color: var(--crema); border-color: var(--tinta); }
  /* Durante la carga no se ve (el umbral ya no tiene velo opaco) */
  :global(html.en-umbral) .cab { opacity: 0; pointer-events: none; }
  /* Con un proyecto abierto, fuera */
  :global(html.pro-abierto) .cab { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  .cab--fuera:focus-within { transform: none; opacity: 1; }
  /* El menú cuelga debajo del logo sin ocupar sitio: la barra sigue alineada con el logo */
  .cab__izq { position: relative; display: flex; }
  .cab__logo { width: 132px; color: currentColor; }
  .cab__logo :global(svg) { width: 100%; height: auto; }

  /* Menú: dos rayas que se igualan al pasar el ratón */
  .cab__menu {
    position: absolute; left: 0; top: calc(100% + 10px);
    display: inline-flex; align-items: center; gap: 9px; padding: 4px 0; color: currentColor; white-space: nowrap;
  }
  .cab__menu-i { display: inline-flex; flex-direction: column; gap: 4px; width: 16px; }
  .cab__menu-i i { height: 1px; background: currentColor; transition: width .5s var(--curva), transform .5s var(--curva); }
  .cab__menu-i i:first-child { width: 100%; }
  .cab__menu-i i:last-child { width: 55%; }
  .cab__menu:hover .cab__menu-i i:first-child, .cab__menu:focus-visible .cab__menu-i i:first-child { width: 55%; transform: translateX(45%); }
  .cab__menu:hover .cab__menu-i i:last-child, .cab__menu:focus-visible .cab__menu-i i:last-child { width: 100%; }
  .cab__dcha { display: flex; align-items: center; gap: 22px; }

  /* Sonido: con sonido, las barras se mueven; sin sonido, se quedan planas */
  .cab__sonido { display: inline-flex; align-items: center; gap: 9px; padding: 8px 2px; color: currentColor; }
  .cab__barras { display: inline-flex; align-items: flex-end; gap: 2px; height: 12px; }
  .cab__barras i { width: 2px; height: 100%; background: currentColor; transform-origin: bottom; transform: scaleY(.15); transition: transform .5s var(--curva); }
  .cab__sonido-t { opacity: 0; transform: translateX(4px); transition: opacity .3s, transform .4s var(--curva); }
  .cab__sonido:hover .cab__sonido-t, .cab__sonido:focus-visible .cab__sonido-t { opacity: .66; transform: none; }
  :global(html.sonido-on) .cab__barras i { animation: barras 1s ease-in-out infinite; }
  :global(html.sonido-on) .cab__barras i:nth-child(2) { animation-delay: .2s; animation-duration: .8s; }
  :global(html.sonido-on) .cab__barras i:nth-child(3) { animation-delay: .4s; animation-duration: 1.2s; }
  :global(html.sonido-on) .cab__barras i:nth-child(4) { animation-delay: .1s; animation-duration: .9s; }
  :global(html.mov-reducido.sonido-on) .cab__barras i { animation: none; transform: scaleY(.7); }
  @keyframes barras { 0%, 100% { transform: scaleY(.25); } 50% { transform: scaleY(1); } }

  .cab__hablemos {
    font-size: 13px; letter-spacing: .01em; padding: 9px 16px;
    border: 1px solid currentColor; border-radius: 99px;
    transition: background-color .4s var(--curva), color .4s var(--curva), border-color .4s var(--curva);
  }
  .cab__hablemos:hover, .cab__hablemos:focus-visible { background: var(--crema); color: var(--tinta); border-color: var(--crema); }

  @media (max-width: 700px) {
    .cab__logo { width: 104px; }
    .cab__menu { top: calc(100% + 8px); }
    .cab__dcha { gap: 14px; }
    .cab__sonido-t { display: none; }
    .cab__hablemos { font-size: 12px; padding: 8px 13px; }
  }
</style>
