---
// El menú, que abre el botón «Menú» de la cabecera (se queda encima y pasa a «Cerrar»): un viaje desde la puesta de sol
// de la portada hasta dentro de una aurora (scripts/menu/aurora.js), donde esperan cuatro puntos de luz, uno por
// página, con su nombre debajo. Abajo, siempre a mano, la lista de las páginas (para ir directo, con teclado o con
// lector de pantalla), la altitud y el viento solar, que sale de la visita. Sin «Inicio»: a la home se vuelve con el
// logo. Los datos salen de data/menu.js.
import { DESTINOS } from '../data/menu.js';
const base = import.meta.env.BASE_URL;
const enlace = (d) => (d.ruta === null ? undefined : `${base}${d.ruta}`);
---
<div class="menu" id="menu" data-menu role="dialog" aria-modal="true" aria-label="Menú" hidden data-lenis-prevent>
  <canvas class="au__lienzo" data-au-lienzo aria-hidden="true"></canvas>

  <div class="au__nombres" aria-hidden="true">
    {DESTINOS.map((d) => (
      <span class="au__dest" data-au-dest={d.slug} style={`--c: ${d.color}`}>
        <span class="au__nombre">{d.nombre}</span>
        <span class="au__frase mono">{d.frase}</span>
        <span class="insp au__luz" data-texto={d.luz}></span>
      </span>
    ))}
  </div>

  <p class="au__altitud mono" data-au-altitud aria-hidden="true"></p>
  <p class="au__viento mono" data-au-viento aria-hidden="true"></p>

  <nav class="au__lista mono" aria-label="Páginas">
    {DESTINOS.map((d) => (
      <a href={enlace(d)} aria-disabled={d.ruta === null ? 'true' : undefined} data-au-ir={d.slug} style={`--c: ${d.color}`}>
        <i aria-hidden="true"></i>{d.nombre}
      </a>
    ))}
  </nav>

  <div class="au__inundar" data-au-inundar aria-hidden="true"></div>
  <script type="application/json" data-menu-datos set:html={JSON.stringify(DESTINOS)} />
</div>

<style>
  .menu { position: fixed; inset: 0; z-index: 28; overflow: hidden; background: var(--noche); color: var(--crema); }
  .menu[hidden] { display: none; }
  .au__lienzo { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

  /* El nombre de cada página, colgando debajo de su punto (aurora.js lo lleva a su sitio); no tapa el ratón */
  .au__dest {
    position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none;
    display: grid; justify-items: center; gap: 6px; width: max-content; translate: -50% 30px;
    opacity: 0; transition: opacity .8s var(--curva);
  }
  .au__dest:global(.visto) { opacity: .82; }
  .au__dest:global(.visto.on) { opacity: 1; }
  .au__nombre {
    font-family: var(--serif); font-weight: 300; font-size: clamp(28px, 2.9vw, 50px); line-height: 1; letter-spacing: -.01em;
    text-shadow: 0 0 10px rgba(18, 13, 10, .55), 0 0 28px color-mix(in srgb, var(--c) 55%, transparent);
    transition: transform .6s var(--curva), color .4s;
  }
  .au__dest:global(.on) .au__nombre { color: #fff; transform: scale(1.08); }
  .au__frase { color: var(--crema); text-shadow: 0 0 6px var(--noche), 0 0 14px var(--noche); opacity: 0; transform: translateY(-4px); transition: opacity .4s, transform .5s var(--curva); }
  .au__dest:global(.on) .au__frase { opacity: 1; transform: none; }
  .au__luz { background: var(--c); }
  .au__luz:empty { visibility: hidden; }

  /* El inspector del viaje: la altitud (abajo a la izquierda, encima de la lista) y el viento (abajo a la derecha) */
  .au__altitud, .au__viento { position: absolute; z-index: 3; margin: 0; color: var(--crema-2); pointer-events: none; min-height: 1.4em; }
  .au__altitud { left: var(--margen); bottom: calc(var(--margen) + 34px); }
  .au__viento { right: var(--margen); bottom: var(--margen); max-width: 46ch; text-align: right; }

  /* La lista de siempre: para ir directo */
  .au__lista { position: absolute; left: var(--margen); bottom: var(--margen); z-index: 3; display: flex; flex-wrap: wrap; gap: 6px 22px; }
  .au__lista a { display: inline-flex; align-items: center; gap: 8px; color: var(--crema-2); transition: color .3s; }
  .au__lista a:hover, .au__lista a:focus-visible { color: var(--crema); }
  .au__lista i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .au__lista a[aria-disabled='true'] { opacity: .55; }

  /* Al entrar en una cortina, los textos se apagan y todo se inunda de su color */
  .menu:global(.zambullendo) :is(.au__dest, .au__lista, .au__altitud, .au__viento) { opacity: 0 !important; transition: opacity .5s; }
  .au__inundar {
    position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0;
    background: radial-gradient(ellipse at 50% 55%, color-mix(in srgb, var(--c, #fff) 85%, white) 0%, var(--c, #fff) 45%, color-mix(in srgb, var(--c, #fff) 40%, var(--noche)) 100%);
  }

  /* Sin WebGL: la lista, grande y en el centro */
  .menu:global(.sin-gl) .au__lista { inset: 0; flex-direction: column; justify-content: center; align-items: center; gap: 18px; font-family: var(--serif); font-size: 44px; text-transform: none; letter-spacing: 0; }

  @media (max-width: 760px) {
    /* En el móvil, solo los nombres (las etiquetas de la emisión no caben) */
    .au__luz, .au__frase { display: none; }
    .au__nombre { font-size: 30px; }
    .au__viento { left: var(--margen); right: var(--margen); bottom: calc(var(--margen) + 64px); text-align: left; max-width: none; }
    .au__altitud { bottom: calc(var(--margen) + 100px); }
    .au__lista { gap: 8px 18px; }
  }
</style>
