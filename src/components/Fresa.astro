---
// FRESA: el globo de abajo a la izquierda en toda la página (la píldora con el logotipo de FRESA de la web actual),
// que abre una ventana de chat construida como un dibujo técnico; y, debajo del contacto (que parece el final), una
// sección escondida con el mismo chat. Para llegar a ella hay que empujar: la página termina de verdad en el contacto
// y solo después de varios empujones «se rompe» y deja bajar (fresa.js). Al aparecer, el globo vuela hasta la píldora
// grande de la cabecera y se convierte en ella.
const base = import.meta.env.BASE_URL;
---
<button class="fg" type="button" data-fresa-globo aria-label="Pregúntale a FRESA" aria-expanded="false" aria-controls="fv">
  <span class="pildora" data-fresa-pildora>
    <i class="pildora__punto"></i>
    <img src={`${base}assets/logos/fresa-wordmark.webp`} alt="" width="459" height="131" />
  </span>
  <span class="fg__txt mono"><span class="fg__abrir">Pregúntame</span><span class="fg__cerrar">Cerrar</span></span>
</button>

<!-- La ventana del chat: un plano (guías de construcción, asas, cotas con su medida real, el borde que se traza y un
     rayado de sección) y, dentro, la conversación. Sin mensajes ni sugerencias: solo la caja para escribir. Las guías
     y cotas marcadas con data-fv-sobra se apartan al terminar, para que en reposo el plano quede asimétrico -->
<div class="fv" id="fv" data-fresa-ventana role="dialog" aria-label="Chat con FRESA" hidden>
  <div class="fv__plano" aria-hidden="true">
    <i class="fv__guia fv__guia--h fv__guia--arriba"></i>
    <i class="fv__guia fv__guia--h fv__guia--abajo" data-fv-sobra></i>
    <i class="fv__guia fv__guia--v fv__guia--izq"></i>
    <i class="fv__guia fv__guia--v fv__guia--dcha" data-fv-sobra></i>
    <i class="fv__borde fv__borde--h fv__borde--arriba"></i>
    <i class="fv__borde fv__borde--h fv__borde--abajo"></i>
    <i class="fv__borde fv__borde--v fv__borde--izq"></i>
    <i class="fv__borde fv__borde--v fv__borde--dcha"></i>
    <span class="fv__asa fv__asa--a"></span>
    <span class="fv__asa fv__asa--b"></span>
    <span class="fv__cota fv__cota--ancho mono" data-fv-cota="ancho"></span>
    <span class="fv__cota fv__cota--alto mono" data-fv-cota="alto" data-fv-sobra></span>
    <span class="fv__cota fv__cota--coord mono" data-fv-cota="coord"></span>
  </div>
  <div class="fv__rayado" aria-hidden="true"></div>
  <div class="fv__caja">
    <div class="fv__cabeza">
      <span class="pildora pildora--mini" aria-hidden="true">
        <i class="pildora__punto"></i>
        <img src={`${base}assets/logos/fresa-wordmark.webp`} alt="" width="459" height="131" />
      </span>
      <span class="fv__estado mono">IA de adsPartners · en línea</span>
      <button class="fv__cerrar" type="button" data-fv-cerrar aria-label="Cerrar el chat">✕</button>
    </div>
    <div class="fv__lista" data-fv-lista aria-live="polite" data-lenis-prevent></div>
    <p class="fv__vacia mono" data-fv-vacia aria-hidden="true">( conversación nueva )</p>
    <form class="fv__form" data-fv-form>
      <label class="oculto-accesible" for="fv-input">Tu pregunta para FRESA</label>
      <input id="fv-input" name="q" autocomplete="off" maxlength="1000" placeholder="Pregúntale lo que quieras…" />
      <button type="submit" aria-label="Enviar">→</button>
    </form>
  </div>
</div>

<section class="fr" id="fresa" data-seccion="fresa" aria-labelledby="fr-titulo">
  <div class="fr__caja">
    <p class="fr__etq mono">( 05 — ¿Sigues aquí? )</p>
    <div class="fr__cabeza">
      <span class="pildora pildora--grande" data-fresa-avatar aria-hidden="true">
        <i class="pildora__punto"></i>
        <img src={`${base}assets/logos/fresa-wordmark.webp`} alt="" width="459" height="131" />
      </span>
      <span class="fr__estado mono">IA de adsPartners · en línea</span>
    </div>
    <h2 class="fr__titulo" id="fr-titulo" data-vivo>Entonces tienes una pregunta.</h2>
    <p class="fr__sub">Soy FRESA. Pregúntame lo que quieras: qué hacemos, cómo trabajamos o por dónde empezar.</p>

    <div class="fr__chat" data-fresa-chat aria-live="polite"></div>

    <form class="fr__form" data-fresa-form>
      <label class="oculto-accesible" for="fr-input">Tu pregunta para FRESA</label>
      <div class="fr__campo">
        <input id="fr-input" name="q" autocomplete="off" maxlength="1000" />
        <span class="fr__sugiere" data-fresa-sugiere aria-hidden="true"></span>
      </div>
      <span class="fr__intro mono" data-fresa-intro aria-hidden="true">↵ pregúntalo</span>
      <button type="submit" class="fr__enviar" aria-label="Enviar">→</button>
    </form>
    <p class="fr__humano mono">¿Mejor con una persona? <a href="https://wa.me/34633565840" target="_blank" rel="noopener">WhatsApp</a> · <a href="mailto:adsgroup@ads-partners.com">Correo</a></p>
  </div>
  <p class="fr__empuja mono" data-fresa-empuja aria-hidden="true"></p>
</section>

<style>
  /* La píldora de FRESA (la de la web actual): punto rosa que late y el logotipo. Todo en em, para que la grande
     sea la pequeña a escala y el globo pueda convertirse en ella */
  .pildora {
    display: inline-flex; align-items: center; gap: .6em;
    font-size: 16px; padding: .72em 1.1em .72em .85em;
    background: var(--noche-2); border: 1px solid rgba(231, 226, 218, .16); border-radius: 100px;
    box-shadow: 0 22px 60px -20px rgba(0, 0, 0, .7), 0 4px 14px rgba(0, 0, 0, .3);
  }
  .pildora img { height: 1.1em; width: auto; }
  .pildora__punto { flex: none; width: .55em; height: .55em; border-radius: 50%; background: var(--rosa); animation: latido 2.4s ease-in-out infinite; }
  @keyframes latido { 0%, 100% { box-shadow: 0 0 0 0 rgba(245, 203, 215, .55); } 50% { box-shadow: 0 0 0 .45em rgba(245, 203, 215, 0); } }
  :global(html.mov-reducido) .pildora__punto { animation: none; }
  .pildora--grande { font-size: 26px; }

  /* El globo */
  .fg {
    position: fixed; left: var(--margen); bottom: var(--margen); z-index: 25;
    display: flex; align-items: center; gap: 12px;
    padding: 0; color: var(--crema);
    transition: opacity .5s var(--curva), translate .6s var(--curva);
    transform-origin: 0 0;
  }
  .fg .pildora { transition: background-color .3s; }
  .fg:hover .pildora { background: #2A1F19; }
  .fg__txt { opacity: 0; transform: translateX(-6px); transition: opacity .3s, transform .4s var(--curva); text-shadow: 0 1px 8px rgba(18, 13, 10, .8); }
  .fg:hover .fg__txt, .fg:focus-visible .fg__txt { opacity: 1; transform: none; }
  :global(html.en-umbral) .fg, :global(html.pro-abierto) .fg { opacity: 0; pointer-events: none; translate: 0 16px; }
  .fg__cerrar { display: none; }
  :global(html.fresa-abierta) .fg__abrir { display: none; }
  :global(html.fresa-abierta) .fg__cerrar { display: inline; }

  /* La ventana de FRESA: un plano técnico con el chat dentro (la animación está en fresa.js) */
  .fv {
    position: fixed; left: var(--margen); bottom: calc(var(--margen) + 64px); z-index: 26;
    width: min(400px, calc(100vw - var(--margen) * 2)); height: min(540px, calc(100vh - 190px));
  }
  .fv[hidden] { display: none; }
  :global(html.pro-abierto) .fv, :global(html.en-umbral) .fv { visibility: hidden; }
  .fv__plano { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .fv__guia { position: absolute; display: block; }
  .fv__guia--h { height: 1px; background: repeating-linear-gradient(90deg, var(--crema-3) 0 3px, transparent 3px 7px); transform-origin: 0 50%; }
  .fv__guia--v { width: 1px; background: repeating-linear-gradient(0deg, var(--crema-3) 0 3px, transparent 3px 7px); transform-origin: 50% 100%; }
  .fv__guia--arriba { top: 0; left: -36px; right: -72px; }
  .fv__guia--abajo { bottom: 0; left: -24px; right: -30px; }
  .fv__guia--dcha { right: 0; top: -30px; bottom: -24px; }
  /* El lado que sobresale, macizo (como la casilla del contacto) */
  .fv__guia--izq { left: 0; top: -70px; bottom: -40px; background: rgba(231, 226, 218, .55); }
  .fv__borde { position: absolute; display: block; background: rgba(231, 226, 218, .5); }
  .fv__borde--h { left: 0; right: 0; height: 1px; }
  .fv__borde--v { top: 0; bottom: 0; width: 1px; }
  .fv__borde--arriba { top: 0; transform-origin: 0 50%; }
  .fv__borde--dcha { right: 0; transform-origin: 50% 0; }
  .fv__borde--abajo { bottom: 0; transform-origin: 100% 50%; }
  .fv__borde--izq { left: 0; transform-origin: 50% 100%; }
  .fv__asa { position: absolute; width: 7px; height: 7px; border: 1px solid var(--crema); background: var(--noche); }
  .fv__asa--a { right: -3px; top: -3px; }
  .fv__asa--b { left: -3px; bottom: -3px; }
  .fv__cota { position: absolute; font-size: 9px; color: var(--crema-3); white-space: nowrap; }
  .fv__cota--ancho { left: 0; top: -18px; }
  .fv__cota--alto { left: calc(100% + 10px); top: 50%; writing-mode: vertical-rl; transform: translateY(-50%); }
  .fv__cota--coord { right: 0; bottom: -18px; }
  .fv__rayado { position: absolute; inset: 1px; opacity: 0; background: repeating-linear-gradient(135deg, rgba(245, 203, 215, .18) 0 1px, transparent 1px 8px); }
  .fv__caja {
    position: absolute; inset: 1px; display: flex; flex-direction: column;
    background: #17110D; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .8);
  }
  .fv__cabeza { display: flex; align-items: center; gap: 12px; padding: 12px 10px 12px 14px; border-bottom: 1px solid var(--linea); }
  .pildora--mini { font-size: 11px; box-shadow: none; }
  .fv__estado { flex: 1; font-size: 10px; color: var(--crema-3); }
  .fv__cerrar { width: 32px; height: 32px; display: grid; place-items: center; font-size: 13px; color: var(--crema-2); }
  .fv__cerrar:hover, .fv__cerrar:focus-visible { color: var(--crema); }
  .fv__lista { flex: 1; min-height: 0; display: grid; gap: 12px; align-content: start; overflow-y: auto; overscroll-behavior: contain; padding: 18px 14px; }
  .fv__vacia { position: absolute; left: 0; right: 0; top: 48%; margin: 0; text-align: center; color: var(--crema-3); pointer-events: none; }
  .fv__form { display: flex; align-items: center; gap: 8px; padding: 8px 10px 8px 14px; border-top: 1px solid var(--linea); }
  .fv__form input { flex: 1; min-width: 0; font: inherit; font-family: var(--serif); font-size: 19px; font-weight: 300; color: var(--crema); background: transparent; border: 0; padding: 10px 0; outline: none; }
  .fv__form input::placeholder { color: var(--crema-3); }
  .fv__form button { font-size: 22px; padding: 4px 6px; color: var(--rosa); }
  .fv__form button[disabled] { opacity: .4; }
  .fv__lista :global(.fr-msg) { max-width: 88%; margin: 0; padding: 10px 13px; line-height: 1.5; font-size: 14px; white-space: pre-wrap; }
  .fv__lista :global(.fr-msg--yo) { justify-self: end; background: var(--crema); color: var(--tinta); }
  .fv__lista :global(.fr-msg--fresa) { justify-self: start; border: 1px solid var(--linea); color: var(--crema); background: rgba(27, 20, 16, .7); }
  .fv__lista :global(.fr-msg--fresa a) { border-bottom: 1px solid var(--crema-3); }
  .fv__lista :global(.fr-pensando)::after { content: '▍'; animation: fr-caret 1s steps(1) infinite; }
  @media (max-width: 760px) {
    .fv { right: var(--margen); width: auto; bottom: calc(var(--margen) + 56px); height: min(560px, calc(100vh - 170px)); }
    .fv__cota--alto { display: none; }
    .fv__guia--arriba { right: -16px; }
  }
  /* Ya en el chat: el globo se ha convertido en la píldora grande (sin transición: no hay dos a la vez) */
  .fg.fuera { opacity: 0; pointer-events: none; transition: none; }

  /* La sección escondida: pegada abajo, detrás del contacto. Sellada, no ocupa sitio (la página acaba en el
     contacto); al romper el muro entra en el flujo y se puede bajar hasta ella */
  .fr {
    position: sticky; bottom: 0; z-index: 1;
    min-height: 100vh; min-height: 100svh;
    display: grid; align-items: center;
    padding: 14vh var(--margen) 8vh;
    visibility: hidden;
  }
  .fr.sellada { position: fixed; left: 0; right: 0; bottom: 0; }
  .fr.cerca { visibility: visible; }
  .fr__caja { width: min(760px, 100%); margin: 0 auto; }
  .fr__etq { margin: 0 0 28px; color: var(--crema-3); }
  .fr__cabeza { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .fr__cabeza .pildora { opacity: 0; }
  .fr__cabeza .pildora.llego { opacity: 1; }
  .fr__estado { color: var(--crema-3); }
  .fr__titulo { margin: 30px 0 0; font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4.6vw, 72px); line-height: .98; letter-spacing: -.025em; }
  .fr__sub { margin: 16px 0 0; max-width: 34em; color: var(--crema-2); line-height: 1.55; }

  .fr__chat { display: grid; gap: 14px; margin-top: 36px; max-height: 38vh; overflow-y: auto; overscroll-behavior: contain; padding-right: 6px; }
  .fr__chat:empty { display: none; }
  .fr__chat :global(.fr-msg) { max-width: 85%; margin: 0; padding: 12px 16px; line-height: 1.5; font-size: 15px; white-space: pre-wrap; }
  .fr__chat :global(.fr-msg--yo) { justify-self: end; background: var(--crema); color: var(--tinta); }
  .fr__chat :global(.fr-msg--fresa) { justify-self: start; border: 1px solid var(--linea); color: var(--crema); background: rgba(27, 20, 16, .7); }
  .fr__chat :global(.fr-msg--fresa a) { border-bottom: 1px solid var(--crema-3); }
  .fr__chat :global(.fr-pensando)::after { content: '▍'; animation: fr-caret 1s steps(1) infinite; }
  @keyframes fr-caret { 50% { opacity: 0; } }

  /* La caja de la pregunta: las sugerencias se escriben y se borran dentro, una tras otra */
  .fr__form { display: flex; align-items: center; gap: 12px; margin-top: 34px; border-bottom: 1px solid var(--crema-3); }
  .fr__campo { position: relative; flex: 1; min-width: 0; }
  .fr__form input { width: 100%; font: inherit; font-family: var(--serif); font-size: clamp(22px, 2.2vw, 32px); font-weight: 300; color: var(--crema); background: transparent; border: 0; padding: 12px 0; outline: none; }
  .fr__sugiere {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%); pointer-events: none; white-space: nowrap; overflow: hidden; max-width: 100%;
    font-family: var(--serif); font-size: clamp(22px, 2.2vw, 32px); font-weight: 300; color: var(--crema-3);
  }
  .fr__sugiere::after { content: ''; display: inline-block; width: 2px; height: .9em; margin-left: 2px; vertical-align: -.1em; background: var(--rosa); animation: fr-caret 1s steps(1) infinite; }
  .fr__sugiere:empty::after { margin-left: 0; }
  .fr__intro { color: var(--crema-3); opacity: 0; transition: opacity .3s; white-space: nowrap; }
  .fr__intro.on { opacity: 1; }
  .fr__enviar { font-size: 26px; padding: 6px 4px 6px 4px; color: var(--rosa); }
  .fr__enviar[disabled] { opacity: .4; }
  .fr__humano { margin: 22px 0 0; color: var(--crema-3); }
  .fr__humano a { color: var(--crema-2); border-bottom: 1px solid var(--crema-3); }

  /* Lo que se lee abajo mientras se empuja el contacto */
  .fr__empuja { position: absolute; left: 0; right: 0; bottom: 4vh; margin: 0; text-align: center; color: var(--rosa); opacity: 0; transition: opacity .3s; }
  .fr__empuja.on { opacity: 1; }

  @media (max-width: 760px) {
    .pildora { font-size: 14px; }
    .pildora--grande { font-size: 20px; }
    .fr__intro { display: none; }
  }
</style>
