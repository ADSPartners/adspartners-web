---
// Los enlaces entre páginas, para las interiores (la auditoría SEO del 03-nov: las interiores solo enlazaban a la
// home y desde Tech o Proyectos no se llegaba a la carta). Una línea en mono, con el color del texto de donde se
// ponga (currentColor), que no se enlaza a sí misma: las demás páginas y «Escríbenos», que lleva a la carta de la home.
// Cada página la coloca donde termina su recorrido y la ajusta con su clase.
interface Props { actual: 'tech' | 'brand' | 'proyectos' | 'about'; class?: string }
const { actual, class: clase = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const PAGINAS = [
  { slug: 'tech', nombre: 'Tech' },
  { slug: 'brand', nombre: 'Brand' },
  { slug: 'proyectos', nombre: 'Proyectos' },
  { slug: 'about', nombre: 'About' },
].filter((p) => p.slug !== actual);
---
<nav class:list={['enl', clase]} aria-label="Más de adsPartners">
  <span class="enl__t">Sigue por</span>
  <ul class="enl__lista">
    {PAGINAS.map((p) => <li><a href={`${base}${p.slug}/`} data-sonido-hover>{p.nombre}</a></li>)}
    <li><a class="enl__carta" href={`${base}#contacto`} data-sonido-hover>Escríbenos <span aria-hidden="true">▶</span></a></li>
  </ul>
</nav>

<style>
  .enl { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: inherit; }
  .enl__t { opacity: .55; }
  .enl__lista { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; }
  .enl a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color .3s, opacity .3s; }
  .enl a:hover, .enl a:focus-visible { border-bottom-color: currentColor; }
  .enl__carta { font-weight: 500; }
</style>
