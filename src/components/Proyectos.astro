---
// Proyectos: un lienzo con el fondo máquina detrás por el que suben, con el scroll, las fotos de los proyectos (una
// por proyecto, grandes). Pasar el ratón (o un toque en el móvil) escribe encima, en varios sitios a la vez y con
// letras distintas; un clic (o un segundo toque) lo acerca a cámara, saca las demás de la pantalla y cuenta el proyecto.
import { PROYECTOS as TODOS } from '../data/proyectos.js';
// En la home, solo los del lienzo (el archivo los tiene todos)
const PROYECTOS = TODOS.filter((p) => p.home);
const base = import.meta.env.BASE_URL;

// Dónde va cada foto (ancho en vw y x en %): en zigzag, para que el título de detrás asome entre ellas
const SITIO = [{ w: 40, x: 5 }, { w: 27, x: 64 }, { w: 44, x: 9 }, { w: 34, x: 58 }, { w: 40, x: 13 }];
// Cómo se reparte el texto escrito encima: tres maquetas que se alternan (posiciones en % de la foto)
const MAQUETAS = [
  { nombre: 'left:6%;top:7%', meta: 'right:6%;top:7%;text-align:right', dato: 'left:34%;top:46%', linea: 'left:6%;bottom:15%;max-width:60%', con: 'left:6%;bottom:6%', cta: 'right:6%;bottom:6%' },
  { meta: 'left:6%;top:6%', con: 'right:6%;top:6%;text-align:right', nombre: 'left:10%;top:30%', linea: 'right:6%;top:60%;max-width:48%;text-align:right', dato: 'left:6%;bottom:8%', cta: 'right:6%;bottom:6%' },
  { con: 'left:6%;top:6%', linea: 'right:6%;top:10%;max-width:46%;text-align:right', dato: 'left:8%;top:44%', nombre: 'left:6%;bottom:9%', meta: 'right:6%;bottom:19%;text-align:right', cta: 'right:6%;bottom:6%' },
];
const ORDEN = ['nombre', 'meta', 'con', 'linea', 'dato', 'cta'];
const textos = (p: any) => ({
  nombre: p.nombre,
  meta: [p.rama, p.anio].filter(Boolean).join(' · '),
  con: p.con || p.sector,
  linea: p.linea,
  dato: p.dato,
  cta: '',   // lo pone el JS (ratón o dedo)
});
// No hay una página por proyecto: «Ver proyecto» lleva al archivo, parado en ese
const datos = PROYECTOS.map((p) => ({ ...p, enlace: `${base}proyectos/#${p.slug}` }));
---
<section class="pro" id="proyectos" data-seccion="proyectos" data-cursor="proyectos" aria-labelledby="pro-titulo">
  <div class="pro__pegado" data-pro-pegado>
    <div class="pro__cabeza">
      <p class="pro__etq mono">( 03 — Proyectos )</p>
      <h2 class="pro__titulo" id="pro-titulo" data-vivo>Lo que <em>hemos hecho</em></h2>
      <p class="pro__pista mono" aria-hidden="true"><span class="pro__pista-raton">Pasa el ratón por encima de una foto</span><span class="pro__pista-dedo">Toca una foto</span></p>
    </div>

    <div class="pro__lienzo" data-pro-lienzo>
      {PROYECTOS.map((pr, k) => {
        const s = SITIO[k % SITIO.length];
        const m = MAQUETAS[k % MAQUETAS.length];
        const t: any = textos(pr);
        return (
          <div class="pro__pieza" role="button" tabindex="0" data-pro-pieza data-proyecto={pr.slug}
            aria-label={`${pr.nombre}: ${pr.linea}`}
            style={`--w:${s.w};--x:${s.x};--xm:${k % 2 ? 10 : 4};--ar:${pr.foto.ancho / pr.foto.alto}`}>
            <div class="pro__marco" data-pro-marco>
              <img src={`${base}assets/proyectos/${pr.foto.src}`} alt="" loading="lazy" decoding="async" />
              {pr.foto.provisional && <span class="pro__provisional mono">foto provisional</span>}
              <span class="pro__velo" aria-hidden="true"></span>
              <div class="pro__escrito" aria-hidden="true">
                {ORDEN.filter((c) => c === 'cta' || t[c]).map((c) => (
                  <span class={`pro__frag pro__frag--${c}`} style={m[c as keyof typeof m]} data-frag={c} data-txt={t[c]}></span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="pro__abierto" data-pro-abierto hidden>
      <div class="pro__fondo-abierto" data-pro-cerrar-fondo></div>
      <div class="pro__foco" data-pro-foco></div>
      <div class="pro__ficha" data-pro-ficha role="dialog" aria-modal="true" aria-labelledby="pro-ficha-nombre">
        <p class="pro__ficha-etq mono" data-f="etq"></p>
        <h3 class="pro__ficha-nombre" id="pro-ficha-nombre" data-f="nombre"></h3>
        <p class="pro__ficha-con mono" data-f="con"></p>
        <p class="pro__ficha-texto" data-f="texto"></p>
        <ul class="pro__ficha-datos" data-f="datos"></ul>
        <a class="pro__ficha-enlace" data-f="enlace" href="#" data-sonido-hover>Ver proyecto <span aria-hidden="true">→</span></a>
      </div>
      <button class="pro__cerrar mono" type="button" data-pro-cerrar>Cerrar <span aria-hidden="true">✕</span></button>
    </div>
  </div>
  <script type="application/json" data-pro-datos set:html={JSON.stringify(datos)} />
</section>

<style>
  /* Los últimos 120vh son de la transición, que se monta encima (Transicion.astro) */
  .pro { position: relative; height: 800vh; }
  .pro__pegado { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }

  .pro__cabeza { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; pointer-events: none; padding: 0 var(--margen); }
  .pro__etq { margin: 0 0 18px; color: var(--crema-3); }
  .pro__titulo { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(54px, 9vw, 168px); line-height: .86; letter-spacing: -.035em; color: rgba(231, 226, 218, .9); }
  .pro__titulo em { font-style: italic; color: var(--rosa); }
  .pro__pista { margin: 26px 0 0; color: var(--crema-3); }
  .pro__pista-dedo { display: none; }
  @media (hover: none), (pointer: coarse) { .pro__pista-raton { display: none; } .pro__pista-dedo { display: inline; } }

  .pro__lienzo { position: absolute; inset: 0; }
  .pro__pieza {
    position: absolute; top: 0; left: calc(var(--x) * 1%);
    width: calc(var(--w) * 1vw);
    will-change: transform;
    outline: none;
    --rx: 0deg; --ry: 0deg;
  }
  .pro__marco {
    position: relative; aspect-ratio: var(--ar); overflow: hidden;
    background: var(--noche-2);
    container-type: inline-size;
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .7s var(--curva), box-shadow .7s var(--curva);
    box-shadow: 0 20px 60px -30px rgba(0, 0, 0, .7);
  }
  .pro__marco > img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--curva), filter .7s var(--curva); }
  .pro__pieza.activa .pro__marco, .pro__pieza:focus-visible .pro__marco {
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry)) scale(1.04);
    box-shadow: 0 30px 90px -30px rgba(0, 0, 0, .9);
    transition: transform .25s var(--curva), box-shadow .7s var(--curva);
  }
  .pro__pieza.activa .pro__marco > img { transform: scale(1.05); filter: saturate(.85) brightness(.82); }
  .pro__pieza:focus-visible .pro__marco { outline: 1px solid var(--rosa); outline-offset: 4px; }

  .pro__provisional { position: absolute; top: 8px; right: 8px; padding: 3px 6px; font-size: 9px; color: var(--tinta); background: var(--rosa); z-index: 1; }
  .pro__pieza.activa .pro__provisional { opacity: 0; }
  .pro__velo {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .5s var(--curva);
    background: radial-gradient(120% 90% at 50% 50%, rgba(18, 13, 10, .25), rgba(18, 13, 10, .72));
  }
  .pro__pieza.activa .pro__velo { opacity: 1; }

  /* Lo escrito encima: varios trozos, en sitios distintos y con letras distintas */
  .pro__escrito { position: absolute; inset: 0; pointer-events: none; }
  .pro__frag { position: absolute; color: var(--crema); white-space: pre-wrap; text-shadow: 0 1px 14px rgba(18, 13, 10, .6); }
  .pro__frag:empty { display: none; }
  .pro__frag--nombre { font-family: var(--serif); font-weight: 300; font-size: max(34px, 10.5cqw); line-height: .9; letter-spacing: -.035em; }
  .pro__frag--dato { font-family: var(--serif); font-style: italic; font-size: max(20px, 5.2cqw); line-height: 1; letter-spacing: -.015em; color: var(--rosa); }
  .pro__frag--linea { font-family: var(--sans); font-weight: 500; font-size: max(14px, 3.3cqw); line-height: 1.15; letter-spacing: -.01em; }
  .pro__frag--meta, .pro__frag--con, .pro__frag--cta { font-family: var(--mono); font-size: max(10px, 1.9cqw); line-height: 1.35; letter-spacing: .06em; text-transform: uppercase; }
  .pro__frag--con { color: var(--rosa); }
  .pro__frag--cta { color: var(--tinta); background: var(--crema); padding: .35em .6em; text-shadow: none; }
  .pro__frag :global(.caret) { display: inline-block; width: .5em; height: .95em; margin-left: 2px; vertical-align: -.08em; background: currentColor; animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  /* Proyecto abierto */
  /* El proyecto abierto va fijo a la pantalla (no a la sección): da igual dónde estuviera la foto o si la sección
     aún no estaba pegada, el foco acaba en el centro y «Cerrar» siempre se ve. Mientras está abierto, la sección
     pasa por encima de todo (también de la transición, que se monta encima de su final) */
  .pro__abierto { position: fixed; inset: 0; z-index: 5; }
  :global(html.pro-abierto) .pro__pegado { z-index: 50; }
  .pro__abierto[hidden] { display: none; }
  .pro__fondo-abierto { position: absolute; inset: 0; background: rgba(18, 13, 10, .55); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
  .pro__foco { position: absolute; overflow: hidden; box-shadow: 0 50px 140px -40px rgba(0, 0, 0, .95); }
  .pro__foco > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pro__ficha {
    position: absolute; right: calc(var(--margen) * 2); top: 50%; transform: translateY(-50%);
    width: min(400px, 30vw);
  }
  .pro__ficha-etq { margin: 0 0 16px; color: var(--crema-3); }
  .pro__ficha-nombre { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 3.6vw, 60px); line-height: .95; letter-spacing: -.02em; min-height: 1em; }
  .pro__ficha-con { margin: 10px 0 0; color: var(--rosa); }
  .pro__ficha-texto { margin: 26px 0 0; font-size: 15px; line-height: 1.55; color: var(--crema-2); }
  .pro__ficha-datos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--linea); }
  .pro__ficha-datos :global(li) { padding: 10px 0; border-bottom: 1px solid var(--linea); font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--crema); }
  .pro__ficha-datos :global(li)::before { content: '→ '; color: var(--rosa); }
  .pro__ficha-enlace { display: inline-flex; gap: 10px; margin-top: 28px; padding: 12px 20px; border: 1px solid var(--crema); border-radius: 99px; font-size: 14px; transition: background-color .4s var(--curva), color .4s var(--curva); }
  .pro__ficha-enlace:hover, .pro__ficha-enlace:focus-visible { background: var(--crema); color: var(--tinta); }
  .pro__cerrar { position: absolute; top: var(--margen); right: var(--margen); padding: 10px 4px; color: var(--crema-2); }
  .pro__cerrar:hover, .pro__cerrar:focus-visible { color: var(--crema); }
  .pro a, .pro button { cursor: pointer !important; }

  @media (max-width: 760px) {
    .pro { height: 780vh; }
    .pro__pieza { width: 86vw; left: calc(var(--xm) * 1vw); }
    .pro__ficha { left: var(--margen); right: var(--margen); top: auto; bottom: calc(var(--margen) * 1.4); transform: none; width: auto; }
    .pro__ficha-nombre { font-size: 38px; }
    .pro__ficha-texto { margin-top: 14px; font-size: 14px; }
    .pro__ficha-datos { display: none; }
    .pro__ficha-enlace { margin-top: 16px; }
  }

  /* Sin movimiento: una rejilla quieta, con el texto ya escrito */
  :global(html.mov-reducido) .pro { height: auto; padding: 16vh var(--margen); }
  :global(html.mov-reducido) .pro__pegado { position: static; height: auto; overflow: visible; }
  :global(html.mov-reducido) .pro__cabeza { position: static; margin-bottom: 8vh; }
  :global(html.mov-reducido) .pro__lienzo { position: static; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
  :global(html.mov-reducido) .pro__pieza { position: relative; left: auto; width: auto; transform: none !important; }
</style>
