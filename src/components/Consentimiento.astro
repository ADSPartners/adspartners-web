---
// El aviso de consentimiento: una «N. del E.» (nota del editor) pequeña, abajo a la izquierda, que no bloquea nada.
// Solo existe si hay medición o campañas en data/rastreo.js (o la demo de la copia de prueba); si no, no se pinta
// nada y la web no pide permiso porque no lo necesita. «Sí, vale» y «No, gracias» pesan lo mismo; «Elegir» abre las
// dos casillas (en el plano tech de la posdata de la carta, con el visto en píxeles). Lo mueve scripts/consentimiento.js.
import { RASTREO, CONSENTIMIENTO } from '../data/rastreo.js';

const R = RASTREO;
const base = import.meta.env.BASE_URL;
const de = R.medicion && R.campanas ? 'Google ni de Meta' : R.medicion ? 'Google' : 'Meta';
const opciones = [
  ...(R.medicion ? [{ id: 'medicion', titulo: 'Medición', quien: 'Google Analytics', para: 'qué páginas se leen' }] : []),
  ...(R.campanas ? [{ id: 'campanas', titulo: 'Campañas', quien: 'Píxel de Meta', para: 'si un anuncio trae a alguien' }] : []),
];
// El visto, en píxeles (el de la carta, en una rejilla de 10)
const VISTO = [[1, 5], [2, 6], [3, 7], [4, 6], [5, 5], [6, 4], [7, 3], [8, 2]];
---
{R.activo && (
  <aside class="cons" data-consentimiento hidden aria-labelledby="cons-titulo"
    data-ga4={R.ga4} data-pixel={R.pixel} data-demo={R.demo ? '1' : undefined}
    data-medicion={R.medicion ? '1' : undefined} data-campanas={R.campanas ? '1' : undefined}
    data-clave={CONSENTIMIENTO.clave} data-version={CONSENTIMIENTO.version} data-meses={CONSENTIMIENTO.meses}>
    <i class="cons__guia cons__guia--a" aria-hidden="true"></i><i class="cons__guia cons__guia--b" aria-hidden="true"></i>
    <p class="cons__etq mono" id="cons-titulo">N. del E.</p>
    <p class="cons__texto">
      Nos gustaría saber qué páginas se leen{R.campanas ? ' y si nuestras campañas funcionan' : ''}. Solo si nos dejas: sin tu sí, no se carga nada de {de}.
    </p>
    <fieldset class="cons__casillas" data-cons-casillas hidden>
      <legend class="oculto-accesible">Qué nos dejas medir</legend>
      {opciones.map((o) => (
        <label class="cons__casilla">
          <input type="checkbox" name={o.id} data-cons-op={o.id} />
          <span class="cons__caja" aria-hidden="true">
            <svg viewBox="0 0 40 40">
              <rect class="cons__marco" x="2" y="2" width="36" height="36" />
              <g class="cons__visto">{VISTO.map(([c, f], i) => <rect x={c * 4} y={f * 4} width="3.4" height="3.4" style={`--i:${i}`} />)}</g>
            </svg>
          </span>
          <span class="cons__op"><b>{o.titulo}</b> · {o.quien}<small>Para saber {o.para}.</small></span>
        </label>
      ))}
    </fieldset>
    <div class="cons__botones">
      <button type="button" class="cons__boton" data-cons="si">Sí, vale</button>
      <button type="button" class="cons__boton" data-cons="no">No, gracias</button>
      <button type="button" class="cons__mas" data-cons="elegir" aria-expanded="false">Elegir</button>
    </div>
    <a class="cons__enlace mono" href={`${base}cookies/`}>Todo, en Cookies</a>
  </aside>
)}

<script>
  import { montarConsentimiento } from '../scripts/consentimiento.js';
  montarConsentimiento();
</script>

<style>
  .cons {
    position: fixed; left: var(--margen); bottom: var(--margen); z-index: 70; width: min(372px, calc(100vw - 24px));
    padding: 18px 20px 16px; background: var(--noche-2); color: var(--crema); border: 1px solid rgba(231, 226, 218, .16);
    box-shadow: 0 24px 50px rgba(0, 0, 0, .45);
    opacity: 0; transform: translateY(14px); transition: opacity .45s var(--curva), transform .6s var(--curva);
  }
  .cons.es-visible { opacity: 1; transform: none; }
  .cons::before { content: ''; position: absolute; right: -1px; top: -1px; width: 7px; height: 7px; background: var(--rosa); }
  /* Guías del plano que se salen por una esquina (no por todas: sin simetría de plantilla) */
  .cons__guia { position: absolute; pointer-events: none; }
  .cons__guia--a { left: -1px; top: -22px; height: 22px; border-left: 1px dashed rgba(231, 226, 218, .22); }
  .cons__guia--b { left: -26px; top: -1px; width: 26px; border-top: 1px dashed rgba(231, 226, 218, .22); }
  .cons__etq { margin: 0; color: var(--rosa); font-size: 10px; }
  .cons__texto { margin: 10px 0 0; font-family: var(--serif); font-style: italic; font-size: 18px; line-height: 1.3; }
  .cons__botones { display: flex; align-items: center; gap: 10px; margin-top: 16px; }
  .cons__boton {
    flex: 1; height: 40px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    border: 1px solid rgba(231, 226, 218, .45); transition: background .25s, color .25s, border-color .25s;
  }
  .cons__boton:hover { background: var(--crema); color: var(--tinta); border-color: var(--crema); }
  .cons__mas { padding: 0 4px; height: 40px; font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--crema-2); border-bottom: 1px dashed transparent; transition: color .25s; }
  .cons__mas:hover { color: var(--crema); }
  .cons__enlace { display: inline-block; margin-top: 12px; font-size: 9px; color: var(--crema-3); border-bottom: 1px solid var(--linea); transition: color .25s; }
  .cons__enlace:hover { color: var(--crema); }

  .cons__casillas { margin: 14px 0 0; padding: 0; border: 0; display: grid; gap: 10px; }
  .cons__casillas[hidden] { display: none; }
  .cons__casilla { position: relative; display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; cursor: pointer; }
  .cons__casilla input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .cons__caja { width: 22px; height: 22px; margin-top: 1px; }
  .cons__caja svg { width: 100%; height: 100%; overflow: visible; }
  .cons__marco { fill: none; stroke: var(--crema-2); stroke-width: 1; vector-effect: non-scaling-stroke; shape-rendering: crispEdges; transition: stroke .25s; }
  .cons__visto rect { fill: var(--rosa); opacity: 0; shape-rendering: crispEdges; }
  .cons__casilla:hover .cons__marco { stroke: var(--crema); }
  .cons__casilla input:checked + .cons__caja .cons__visto rect { opacity: 1; transition: opacity 0s calc(var(--i) * 34ms); }
  .cons__casilla input:focus-visible + .cons__caja { outline: 1px solid var(--rosa); outline-offset: 4px; }
  .cons__op { font-size: 13px; line-height: 1.35; color: var(--crema-2); }
  .cons__op b { font-weight: 500; color: var(--crema); }
  .cons__op small { display: block; font-size: 11.5px; color: var(--crema-3); }

  @media (max-width: 760px) {
    .cons { left: 12px; right: 12px; bottom: 12px; width: auto; }
    .cons__guia { display: none; }
  }
</style>
