---
// CTA + contacto, el capítulo claro: una carta en Garamond con los huecos para rellenar en línea y un «OK» grande.
// Va al webhook de n8n (ads-contacto). Debajo, el cierre que parece el final de la página.
---
<section class="ct" id="contacto" data-seccion="contacto" aria-labelledby="ct-titulo">
  <div class="ct__cabeza">
    <p class="ct__etq mono">( 04 — Hablemos )</p>
    <h2 class="ct__titulo" id="ct-titulo">Cuéntanos quién eres y te escribimos nosotros.</h2>
  </div>

  <form class="ct__carta" data-ct-form novalidate>
    <p class="ct__texto">
      Hola, me llamo
      <label class="ct__hueco"><span class="oculto-accesible">Tu nombre</span><input name="name" required autocomplete="name" placeholder="tu nombre" data-ct-crece /></label>
      y trabajo en
      <label class="ct__hueco"><span class="oculto-accesible">Tu empresa</span><input name="company" autocomplete="organization" placeholder="tu empresa" data-ct-crece /></label>.
      Os escribo porque quiero
      <span class="ct__opciones" role="radiogroup" aria-label="Qué quieres hacer">
        <button type="button" role="radio" aria-checked="false" data-ct-op="marca">mejorar mi marca</button><span class="ct__sep" aria-hidden="true">,</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="web">una web nueva</button><span class="ct__sep" aria-hidden="true">,</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="automatizar">automatizar algo</button><span class="ct__sep" aria-hidden="true"> o</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="no-lo-se">aún no lo sé</button></span>.
      Podéis escribirme a
      <label class="ct__hueco"><span class="oculto-accesible">Tu correo</span><input name="email" type="email" required autocomplete="email" inputmode="email" placeholder="tu correo" data-ct-crece /></label>
      o llamarme al
      <label class="ct__hueco"><span class="oculto-accesible">Tu teléfono (si quieres)</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="teléfono, si quieres" data-ct-crece /></label>.
    </p>

    <input class="ct__miel" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="ct__pie">
      <label class="ct__acepto">
        <input type="checkbox" name="acepto" required />
        <span>He leído la <a href="https://ads-partners.com/privacidad.html" target="_blank" rel="noopener">política de privacidad</a> y acepto que me contestéis.</span>
      </label>
      <button class="ct__ok" type="submit" data-iman data-sonido-hover><span>OK</span></button>
    </div>
    <p class="ct__estado mono" data-ct-estado aria-live="polite"></p>
    <p class="ct__sello" data-ct-sello aria-hidden="true">Recibida</p>
  </form>

  <p class="ct__otros">¿Prefieres otra vía? <a href="mailto:adsgroup@ads-partners.com">adsgroup@ads-partners.com</a> · <a href="https://wa.me/34633565840" target="_blank" rel="noopener">WhatsApp</a></p>

  <footer class="ct__cierre">
    <span class="ct__marca">adsPartners<sup>®</sup></span>
    <span class="mono">Madrid · 2026</span>
    <nav class="ct__legales mono" aria-label="Legales">
      <a href="https://ads-partners.com/aviso-legal.html">Aviso legal</a>
      <a href="https://ads-partners.com/privacidad.html">Privacidad</a>
      <a href="https://ads-partners.com/cookies.html">Cookies</a>
    </nav>
  </footer>
</section>

<style>
  .ct {
    position: relative; z-index: 2;
    background: var(--crema); color: var(--tinta);
    padding: 18vh var(--margen) var(--margen);
    min-height: 100vh;
    display: flex; flex-direction: column;
    overflow-x: clip;
    --tinta-2: rgba(25, 9, 0, .55);
    --tinta-3: rgba(25, 9, 0, .3);
  }
  .ct ::selection { background: var(--tinta); color: var(--crema); }
  .ct :focus-visible { outline-color: var(--tinta); }
  .ct__cabeza { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 20px; }
  .ct__etq { grid-column: 1 / 4; margin: 0; color: var(--tinta-2); }
  .ct__titulo { grid-column: 4 / 11; margin: 0; font-family: var(--sans); font-weight: 500; font-size: 15px; letter-spacing: 0; color: var(--tinta-2); }

  .ct__carta { position: relative; margin: 9vh 0 0; max-width: 1240px; }
  .ct__texto {
    margin: 0;
    font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 4.1vw, 68px); line-height: 1.32; letter-spacing: -.018em;
  }
  .ct__hueco { display: inline-block; position: relative; max-width: 100%; }
  .ct__hueco input {
    font: inherit; font-style: italic; color: var(--tinta); letter-spacing: inherit;
    background: transparent; border: 0; border-bottom: 1px solid var(--tinta-3);
    padding: 0 .08em; margin: 0; width: 6em; min-width: 3ch; max-width: calc(100vw - var(--margen) * 2);
    border-radius: 0; outline: none;
    transition: border-color .3s var(--curva);
  }
  .ct__hueco input::placeholder { color: var(--tinta-3); opacity: 1; }
  .ct__hueco input:focus { border-bottom-color: var(--tinta); }
  .ct__hueco input[aria-invalid="true"] { border-bottom: 2px solid #C8361F; }
  .ct__opciones button {
    font: inherit; color: var(--tinta-3); padding: 0; border-bottom: 1px dashed var(--tinta-3);
    transition: color .3s var(--curva), border-color .3s var(--curva);
  }
  .ct__opciones button:hover { color: var(--tinta-2); }
  .ct__opciones button[aria-checked="true"] { color: var(--tinta); font-style: italic; border-bottom: 1px solid var(--tinta); }
  .ct__opciones button[aria-checked="true"]::after { content: ' ✓'; font-family: var(--mono); font-size: .4em; vertical-align: .8em; font-style: normal; }
  .ct__sep { color: var(--tinta-3); }

  .ct__miel { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .ct__pie { display: flex; align-items: center; justify-content: space-between; gap: 32px; margin-top: 7vh; }
  .ct__acepto { display: flex; gap: 10px; align-items: flex-start; max-width: 460px; font-size: 13px; line-height: 1.45; color: var(--tinta-2); cursor: pointer; }
  .ct__acepto input { margin: 3px 0 0; accent-color: var(--tinta); width: 15px; height: 15px; flex: none; }
  .ct__acepto a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }
  .ct__acepto.invalido { color: #C8361F; }
  .ct__ok {
    flex: none; width: clamp(120px, 11vw, 168px); aspect-ratio: 1; border-radius: 50%;
    background: var(--rosa); color: var(--tinta);
    font-family: var(--serif); font-size: clamp(34px, 3.2vw, 52px); font-weight: 300; letter-spacing: -.02em;
    display: grid; place-items: center;
    transition: background-color .4s var(--curva), color .4s var(--curva), transform .4s var(--curva);
  }
  .ct__ok:hover, .ct__ok:focus-visible { background: var(--tinta); color: var(--crema); }
  .ct__ok[disabled] { opacity: .6; cursor: progress; }
  .ct__estado { min-height: 1.4em; margin: 18px 0 0; color: var(--tinta-2); text-align: right; }
  .ct__estado a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }

  /* El sello de «Recibida» */
  .ct__sello {
    position: absolute; right: 8%; top: 18%; margin: 0;
    padding: 10px 22px; border: 3px solid #C8361F; color: #C8361F; border-radius: 6px;
    font-family: var(--mono); font-size: clamp(22px, 2.4vw, 38px); letter-spacing: .14em; text-transform: uppercase;
    transform: rotate(-12deg) scale(2.2); opacity: 0; pointer-events: none;
    mix-blend-mode: multiply;
  }
  .ct__carta.enviada .ct__texto, .ct__carta.enviada .ct__pie { opacity: .45; transition: opacity .8s var(--curva); }

  .ct__otros { margin: 12vh 0 0; font-size: 14px; color: var(--tinta-2); }
  .ct__otros a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }

  .ct__cierre {
    margin-top: auto; padding-top: 10vh;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .ct__marca { font-family: var(--serif); font-weight: 300; font-size: clamp(56px, 11vw, 200px); line-height: .8; letter-spacing: -.04em; }
  .ct__marca sup { font-family: var(--sans); font-size: .14em; vertical-align: 3.4em; margin-left: .2em; }
  .ct__legales { display: flex; gap: 18px; }
  .ct__legales a, .ct__cierre .mono { color: var(--tinta-2); }
  .ct__legales a:hover { color: var(--tinta); }

  @media (max-width: 760px) {
    .ct { padding-top: 14vh; }
    .ct__cabeza { display: block; }
    .ct__titulo { margin-top: 12px; }
    .ct__texto { font-size: clamp(26px, 7.4vw, 34px); line-height: 1.42; }
    .ct__pie { flex-direction: column; align-items: flex-start; }
    .ct__ok { align-self: flex-end; width: 120px; }
    .ct__sello { right: 4%; top: 30%; }
  }
</style>
