---
// CTA + contacto, el capítulo claro: una carta en Garamond con los huecos para rellenar en línea, la privacidad como
// posdata (una casilla dibujada a mano) y «Enviar la carta».
// Va al webhook de n8n (ads-contacto). Debajo, el cierre que parece el final de la página.
---
<section class="ct" id="contacto" data-seccion="contacto" aria-labelledby="ct-titulo">
  <div class="ct__cabeza">
    <p class="ct__etq mono">( 04 — Hablemos )</p>
    <h2 class="ct__titulo" id="ct-titulo">Cuéntanos quién eres y te escribimos nosotros.</h2>
  </div>

  <form class="ct__carta" data-ct-form novalidate>
    <p class="ct__texto">
      Hola, me llamo
      <label class="ct__hueco"><span class="oculto-accesible">Tu nombre</span><input name="name" required autocomplete="name" placeholder="tu nombre" data-ct-crece /></label>
      y trabajo en
      <label class="ct__hueco"><span class="oculto-accesible">Tu empresa</span><input name="company" autocomplete="organization" placeholder="tu empresa" data-ct-crece /></label>.
      Os escribo porque quiero
      <span class="ct__opciones" role="radiogroup" aria-label="Qué quieres hacer">
        <button type="button" role="radio" aria-checked="false" data-ct-op="marca">mejorar mi marca</button><span class="ct__sep" aria-hidden="true">,</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="web">una web nueva</button><span class="ct__sep" aria-hidden="true">,</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="automatizar">automatizar algo</button><span class="ct__sep" aria-hidden="true"> o</span>
        <button type="button" role="radio" aria-checked="false" data-ct-op="no-lo-se">aún no lo sé</button></span>.
      Podéis escribirme a
      <label class="ct__hueco"><span class="oculto-accesible">Tu correo</span><input name="email" type="email" required autocomplete="email" inputmode="email" placeholder="tu correo" data-ct-crece /></label>
      o llamarme al
      <label class="ct__hueco"><span class="oculto-accesible">Tu teléfono (si quieres)</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="teléfono, si quieres" data-ct-crece /></label>.
    </p>

    <input class="ct__miel" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="ct__pie">
      <!-- La privacidad, como posdata de la carta. La casilla es tech (un plano: guías, asas de selección, su medida
           real y su valor) y la marca encima es brand: un visto a boli rojo -->
      <label class="ct__pd">
        <input class="ct__pd-input" type="checkbox" name="acepto" required />
        <span class="ct__pd-letra">P. D.</span>
        <span class="ct__pd-caja" aria-hidden="true">
          <svg viewBox="0 0 40 40">
            <path class="ct__pd-guias" d="M34 -16V6M-18 34H6" />
            <rect class="ct__pd-marco" x="6" y="6" width="28" height="28" />
            <path class="ct__pd-filo" d="M34 6H60M6 34V52" />
            <path class="ct__pd-cota" d="M14 43H34M14 41V45M34 41V45" />
            <g class="ct__pd-asas">
              <rect x="32.3" y="4.3" width="3.4" height="3.4" /><rect x="4.3" y="32.3" width="3.4" height="3.4" />
            </g>
            <path class="ct__pd-tick" pathLength="1" d="M10 20 C 13 23, 15.5 26.5, 17.5 31 C 22 21.5, 28.5 12.5, 38 3.5" />
          </svg>
          <span class="ct__pd-medida mono"><span data-ct-medida>27</span> px · </span>
        </span>
        <span class="ct__pd-texto">He leído la <a href="https://ads-partners.com/privacidad.html" target="_blank" rel="noopener">política de privacidad</a> y os dejo que me contestéis.</span>
      </label>
      <!-- Enviar: como cerrar el sobre; la flecha se alarga al acercarse y sale disparada al mandarla -->
      <button class="ct__enviar" type="submit" data-sonido-hover>
        <span class="ct__enviar-t">Enviar la carta</span>
        <span class="ct__enviar-flecha" aria-hidden="true"></span>
      </button>
    </div>
    <p class="ct__estado mono" data-ct-estado aria-live="polite"></p>
    <p class="ct__sello" data-ct-sello aria-hidden="true">Recibida</p>
  </form>

  <p class="ct__otros">¿Prefieres otra vía? <a href="mailto:adsgroup@ads-partners.com">adsgroup@ads-partners.com</a> · <a href="https://wa.me/34633565840" target="_blank" rel="noopener">WhatsApp</a></p>

  <footer class="ct__cierre">
    <span class="ct__marca" data-vivo>adsPartners<sup>®</sup></span>
    <span class="mono">Madrid · 2026</span>
    <nav class="ct__legales mono" aria-label="Legales">
      <a href="https://ads-partners.com/aviso-legal.html">Aviso legal</a>
      <a href="https://ads-partners.com/privacidad.html">Privacidad</a>
      <a href="https://ads-partners.com/cookies.html">Cookies</a>
    </nav>
  </footer>
</section>

<style>
  .ct {
    position: relative; z-index: 2;
    background: var(--crema); color: var(--tinta);
    padding: 18vh var(--margen) var(--margen);
    min-height: 100vh;
    display: flex; flex-direction: column;
    overflow-x: clip;
    --tinta-2: rgba(25, 9, 0, .55);
    --tinta-3: rgba(25, 9, 0, .3);
  }
  .ct ::selection { background: var(--tinta); color: var(--crema); }
  .ct :focus-visible { outline-color: var(--tinta); }
  .ct__cabeza { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 20px; }
  .ct__etq { grid-column: 1 / 4; margin: 0; color: var(--tinta-2); }
  .ct__titulo { grid-column: 4 / 11; margin: 0; font-family: var(--sans); font-weight: 500; font-size: 15px; letter-spacing: 0; color: var(--tinta-2); }

  .ct__carta { position: relative; margin: 9vh 0 0; max-width: 1240px; }
  .ct__texto {
    margin: 0;
    font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 4.1vw, 68px); line-height: 1.32; letter-spacing: -.018em;
  }
  .ct__hueco { display: inline-block; position: relative; max-width: 100%; }
  .ct__hueco input {
    font: inherit; font-style: italic; color: var(--tinta); letter-spacing: inherit;
    background: transparent; border: 0; border-bottom: 1px solid var(--tinta-3);
    padding: 0 .08em; margin: 0; width: 6em; min-width: 3ch; max-width: calc(100vw - var(--margen) * 2);
    border-radius: 0; outline: none;
    transition: border-color .3s var(--curva);
  }
  .ct__hueco input::placeholder { color: var(--tinta-3); opacity: 1; }
  .ct__hueco input:focus { border-bottom-color: var(--tinta); }
  .ct__hueco input[aria-invalid="true"] { border-bottom: 2px solid #C8361F; }
  .ct__opciones button {
    font: inherit; color: var(--tinta-3); padding: 0; border-bottom: 1px dashed var(--tinta-3);
    transition: color .3s var(--curva), border-color .3s var(--curva);
  }
  .ct__opciones button:hover { color: var(--tinta-2); }
  .ct__opciones button[aria-checked="true"] { color: var(--tinta); font-style: italic; border-bottom: 1px solid var(--tinta); }
  .ct__opciones button[aria-checked="true"]::after { content: ' ✓'; font-family: var(--mono); font-size: .4em; vertical-align: .8em; font-style: normal; }
  .ct__sep { color: var(--tinta-3); }

  .ct__miel { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .ct__pie { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-top: 8vh; }

  /* P. D.: la casilla de privacidad. Tech (guías, asas, cota y valor) con el visto a boli rojo encima */
  .ct__pd {
    position: relative; display: flex; align-items: center; gap: 28px; max-width: 600px;
    font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.55vw, 24px); line-height: 1.25; color: var(--tinta-2);
    cursor: pointer;
  }
  .ct__pd-input { position: absolute; left: 0; top: 0; width: 1px; height: 1px; opacity: 0; }
  .ct__pd-letra { flex: none; font-style: normal; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--tinta); }
  .ct__pd-caja { position: relative; flex: none; width: 36px; height: 36px; }
  .ct__pd-caja svg { width: 100%; height: 100%; overflow: visible; }
  .ct__pd-caja svg :where(path, rect) { vector-effect: non-scaling-stroke; }
  .ct__pd-guias { fill: none; stroke: var(--tinta-3); stroke-width: 1; stroke-dasharray: 2 3; transition: opacity .4s; }
  .ct__pd-marco { fill: none; stroke: var(--tinta); stroke-width: 1; shape-rendering: crispEdges; transition: stroke .3s; }
  .ct__pd-filo { fill: none; stroke: var(--tinta); stroke-width: 1; opacity: .8; shape-rendering: crispEdges; }
  .ct__pd-cota { fill: none; stroke: var(--tinta-2); stroke-width: 1; }
  .ct__pd-asas rect { fill: var(--crema); stroke: var(--tinta); stroke-width: 1; transition: fill .3s, transform .3s; }
  .ct__pd-medida {
    position: absolute; left: 35%; top: calc(100% + 6px);
    font-size: 9px; letter-spacing: .06em; white-space: nowrap; color: var(--tinta-2); font-style: normal;
  }
  .ct__pd-medida::after { content: 'false'; color: var(--tinta); }
  .ct__pd-tick { fill: none; stroke: #C8361F; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; transition: stroke-dashoffset .45s cubic-bezier(.6, 0, .2, 1), opacity 0s .45s; vector-effect: none; }
  /* Al pasar el ratón, las guías corren (hormigas de selección) y las asas se rellenan */
  .ct__pd:hover .ct__pd-guias, .ct__pd-input:focus-visible ~ .ct__pd-caja .ct__pd-guias { animation: guias .6s linear infinite; stroke: var(--tinta-2); }
  .ct__pd:hover .ct__pd-asas rect { fill: var(--tinta); }
  @keyframes guias { to { stroke-dashoffset: -5; } }
  .ct__pd-input:checked ~ .ct__pd-caja .ct__pd-tick { stroke-dashoffset: 0; opacity: 1; transition: stroke-dashoffset .45s cubic-bezier(.6, 0, .2, 1), opacity 0s; }
  .ct__pd-input:checked ~ .ct__pd-caja .ct__pd-guias { opacity: .35; animation: none; }
  .ct__pd-input:checked ~ .ct__pd-caja .ct__pd-medida::after { content: 'true'; color: #C8361F; }
  .ct__pd-input:checked ~ .ct__pd-texto { color: var(--tinta); }
  .ct__pd-input:focus-visible ~ .ct__pd-caja { outline: 1px solid var(--tinta); outline-offset: 10px; }
  .ct__pd a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }
  .ct__pd.invalido .ct__pd-marco, .ct__pd.invalido .ct__pd-guias, .ct__pd.invalido .ct__pd-filo { stroke: #C8361F; }
  .ct__pd.invalido .ct__pd-asas rect { stroke: #C8361F; }
  .ct__pd.invalido .ct__pd-medida::after { content: 'required'; color: #C8361F; }
  .ct__pd.invalido .ct__pd-caja { animation: temblar .4s; }
  @keyframes temblar { 25% { transform: translateX(-4px) rotate(-3deg); } 75% { transform: translateX(4px) rotate(3deg); } }

  /* Enviar la carta: la flecha se alarga al acercarse y sale disparada al enviar */
  .ct__enviar {
    flex: none; display: inline-flex; align-items: center; gap: 22px;
    font-family: var(--serif); font-weight: 300; font-size: clamp(32px, 3.6vw, 60px); letter-spacing: -.02em; line-height: 1;
    color: var(--tinta); padding: 8px 0;
  }
  .ct__enviar-t {
    padding: 0 .08em;
    background: linear-gradient(var(--rosa), var(--rosa)) no-repeat 0 88% / 0% 42%;
    transition: background-size .55s var(--curva);
  }
  .ct__enviar-flecha { position: relative; display: block; width: 72px; height: 1.5px; background: var(--tinta); transition: width .55s var(--curva), transform .6s cubic-bezier(.6, 0, .4, 1), opacity .3s; }
  .ct__enviar-flecha::after { content: ''; position: absolute; right: -1px; top: 50%; width: 14px; height: 14px; border-top: 1.5px solid var(--tinta); border-right: 1.5px solid var(--tinta); transform: translateY(-50%) rotate(45deg); }
  .ct__enviar:hover .ct__enviar-t, .ct__enviar:focus-visible .ct__enviar-t { background-size: 100% 42%; }
  .ct__enviar:hover .ct__enviar-flecha, .ct__enviar:focus-visible .ct__enviar-flecha { width: 150px; }
  .ct__enviar[disabled] { cursor: progress; }
  .ct__enviar[disabled] .ct__enviar-flecha, .ct__carta.enviada .ct__enviar-flecha { transform: translateX(60vw); opacity: 0; }
  .ct__estado { min-height: 1.4em; margin: 18px 0 0; color: var(--tinta-2); text-align: right; }
  .ct__estado a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }

  /* El sello de «Recibida» */
  .ct__sello {
    position: absolute; right: 8%; top: 18%; margin: 0;
    padding: 10px 22px; border: 3px solid #C8361F; color: #C8361F; border-radius: 6px;
    font-family: var(--mono); font-size: clamp(22px, 2.4vw, 38px); letter-spacing: .14em; text-transform: uppercase;
    transform: rotate(-12deg) scale(2.2); opacity: 0; pointer-events: none;
    mix-blend-mode: multiply;
  }
  .ct__carta.enviada .ct__texto, .ct__carta.enviada .ct__pie { opacity: .45; transition: opacity .8s var(--curva); }

  .ct__otros { margin: 12vh 0 0; font-size: 14px; color: var(--tinta-2); }
  .ct__otros a { color: var(--tinta); border-bottom: 1px solid var(--tinta-3); }

  .ct__cierre {
    margin-top: auto; padding-top: 10vh;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .ct__marca { font-family: var(--serif); font-weight: 300; font-size: clamp(56px, 11vw, 200px); line-height: .8; letter-spacing: -.04em; }
  .ct__marca sup { font-family: var(--sans); font-size: .14em; vertical-align: 3.4em; margin-left: .2em; }
  .ct__legales { display: flex; gap: 18px; }
  .ct__legales a, .ct__cierre .mono { color: var(--tinta-2); }
  .ct__legales a:hover { color: var(--tinta); }

  @media (max-width: 760px) {
    .ct { padding-top: 14vh; }
    .ct__cabeza { display: block; }
    .ct__titulo { margin-top: 12px; }
    .ct__texto { font-size: clamp(26px, 7.4vw, 34px); line-height: 1.42; }
    .ct__pie { flex-direction: column; align-items: flex-start; gap: 40px; }
    .ct__enviar { align-self: flex-end; font-size: 34px; gap: 14px; }
    .ct__enviar-flecha { width: 48px; }
    .ct__sello { right: 4%; top: 30%; }
  }
</style>
