---
// Por qué nosotros: el primer capítulo claro (crema). Cuatro afirmaciones grandes, cada una con su porqué.
const razones = [
  ['Un solo equipo.', 'La marca y la tecnología se piensan juntas desde el primer día. Nadie se pasa la pelota.'],
  ['Hablas con quien lo hace.', 'Sin cuentas ni intermediarios: al otro lado están Álvaro y Sebas, las mismas personas de principio a fin.'],
  ['Nada de plantillas.', 'Cada proyecto empieza por entender tu empresa. Lo que sale de ahí solo podría ser tuyo.'],
  ['Precio cerrado.', 'Cada fase arranca con su alcance y su precio por escrito. Lo que se firma es lo que se paga.'],
];
---
<section class="porque capitulo-claro" id="porque" aria-labelledby="porque-t">
  <header class="porque__cab">
    <p class="mono porque__etq">( Por qué nosotros )</p>
    <h2 class="porque__titulo" id="porque-t" data-lente>Lo que no vas a encontrar <em>en otra agencia.</em></h2>
  </header>
  <ol class="porque__lista">
    {razones.map(([t, d]) => (
      <li class="razon" data-razon>
        <h3 class="razon__t" data-lente>{t}</h3>
        <p class="razon__d">{d}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .porque {
    position: relative; z-index: 1;
    background: var(--fondo-claro, var(--crema)); color: var(--tinta);
    padding: clamp(110px, 17vh, 200px) var(--margen) clamp(90px, 14vh, 160px);
  }
  .porque__cab { display: grid; gap: 22px; margin-bottom: clamp(48px, 8vh, 96px); }
  .porque__etq { margin: 0; color: rgba(25, 9, 0, .5); }
  .porque__titulo { margin: 0; max-width: 16ch; font-family: var(--serif); font-weight: 300; font-size: clamp(40px, 5vw, 80px); line-height: 1; letter-spacing: -.024em; }
  .porque__titulo em { font-style: italic; font-weight: 400; color: rgba(25, 9, 0, .55); }

  .porque__lista { list-style: none; margin: 0; padding: 0; counter-reset: razon; }
  .razon {
    position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(20px, 4vw, 64px); align-items: baseline;
    padding: clamp(26px, 4vh, 40px) 0;
  }
  .razon::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: rgba(25, 9, 0, .22);
    transform-origin: left; transform: scaleX(var(--linea-x, 1));
  }
  .razon:last-child { border-bottom: 1px solid rgba(25, 9, 0, .22); }
  .razon__t {
    margin: 0; font-family: var(--serif); font-weight: 300;
    font-size: clamp(36px, 5.6vw, 92px); line-height: .98; letter-spacing: -.03em;
    background: linear-gradient(var(--rosa-osc), var(--rosa-osc)) left 92% / 0 2px no-repeat;
    transition: background-size .7s var(--curva);
    width: fit-content;
  }
  .razon:hover .razon__t { background-size: 100% 2px; }
  .razon__d { margin: 0; max-width: 36ch; font-size: 16px; line-height: 1.55; color: rgba(25, 9, 0, .72); }

  @media (max-width: 860px) {
    .razon { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
